@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#00295A; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        @* ── เหลือเฉพาะ "รูปภาพ" (t1 / en_t1) ตามที่ร้องขอ — ช่องอื่นถูกปิดไว้ก่อนด้านล่าง ── *@
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span class='fi fi-th'></span> <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "t1", (row["t1"].ToString() ?? "").Trim()))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span class='fi fi-us'></span> <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "en_t1", (row["en_t1"].ToString() ?? "").Trim()))
            </div>
        </div>

        @*
        ── ปิดไว้ก่อน (ซ่อนทุกช่องยกเว้น t1 / en_t1) ──────────────────────────────
        ⚠ ถ้าเปิดกลับมา ต้องคืน FieldUpdate/FieldApprove ของ JobCMS ใน AdminMenu.cs
           กลับเป็น FieldUpdate_CoreSingle / FieldApprove_CoreSingle ด้วย
           ไม่งั้นค่าที่กรอกจะไม่ถูกบันทึก

        <fieldset class="cms-section">
            <legend>ส่วนที่ 1</legend>
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "title",  (row["title"].ToString() ?? "").Trim()))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_title",  (row["en_title"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row">
            @Html.Raw(_admin.InputTextEditor_Eform("รายละเอียด <span class='fi fi-th'></span>", "t2", (row["t2"].ToString() ?? "").Trim()))
        </div>

        <div class="row">
            @Html.Raw(_admin.InputTextEditor_Eform("รายละเอียด <span class='fi fi-us'></span>", "en_t2", (row["en_t2"].ToString() ?? "").Trim()))
        </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ส่วนที่ 2</legend>
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "t3",  (row["t3"].ToString() ?? "").Trim()))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_t3",  (row["en_t3"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span class='fi fi-th'></span> <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "t4", (row["t4"].ToString() ?? "").Trim()))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span class='fi fi-us'></span> <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "en_t4", (row["en_t4"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row">
            @Html.Raw(_admin.InputTextEditor_Eform("รายละเอียด <span class='fi fi-th'></span>", "t5", (row["t5"].ToString() ?? "").Trim()))
        </div>

        <div class="row">
            @Html.Raw(_admin.InputTextEditor_Eform("รายละเอียด <span class='fi fi-us'></span>", "en_t5", (row["en_t5"].ToString() ?? "").Trim()))
        </div>
        </fieldset>
        ──────────────────────────────────────────────────────────────────────────
        *@






        @{
            string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
            string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
        }
        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@issue_date" />
        <input type="hidden" name="expiry_date" value="@expiry_date" />





 

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@*
── ปิดไว้ก่อน — ฟอร์มนี้ไม่มีตัวเลือก "วันที่แสดงผล" (ส่งเป็น hidden input แทน)
   สคริปต์เดิมจึงอ้าง element ที่ไม่มีอยู่ และทำให้เกิด TypeError ใน console ทุกครั้งที่เปิดหน้า
@{
    if ((row["issue_date_config"].ToString() ?? "").Trim() == "2")
    {
        <script>
            document.getElementById('id_issue_date_config_2').checked = true;
            document.getElementById('div_id_issue_date').style.display = '';
        </script>
    }
    else
    {
        <script>
            document.getElementById('id_issue_date_config_1').checked = true;
            document.getElementById('div_id_issue_date').style.display = 'none';
        </script>
    }
}
