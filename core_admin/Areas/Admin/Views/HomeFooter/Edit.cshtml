@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";

    // เมนู "ปรับแต่ง Footer" ของ Asset Plus — แก้ได้เฉพาะโซน footer__brand (โลโก้/ที่อยู่/ติดต่อ/โซเชียล)
    // และ footer__promo (ปี/สโลแกน/แอป) + copyright · เมนู footer (footer__nav) กับลิงก์นโยบายด้านล่างเป็นเมนูหลังบ้านคนละตัว
    // ฟอร์ม SAM เดิม (Call Center + รูป, ปุ่ม 3 ปุ่ม, Twitter/TikTok) ไม่ใช้กับเว็บใหม่
    string V(string col) => row.Table.Columns.Contains(col) ? (row[col].ToString() ?? "").Trim() : "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#00295A; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
    /* โลโก้ footer เป็นตัวอักษรสีขาว — thumbnail ต้องมีพื้นเข้มถึงจะมองเห็น */
    #id_img1_img_section .img-thumbnail, #id_en_img1_img_section .img-thumbnail { background:#00295A; padding:12px; max-height:140px; width:auto; }
    #id_app_qr_img_section .img-thumbnail { max-height:160px; width:auto; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">

        @Html.AntiForgeryToken()

        <fieldset class="cms-section">
            <legend>โลโก้ท้ายเว็บ</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("โลโก้ <span class='fi fi-th'></span> <span style='font-weight: normal;color: orange;'>(.svg, .webp, .png พื้นโปร่ง ตัวอักษรสีขาว)</span>", "img1", V("img1")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("โลโก้ <span class='fi fi-us'></span>", "en_img1", V("en_img1")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Alt Text ของโลโก้ <span class='fi fi-th'></span>", "title", V("title")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Alt Text ของโลโก้ <span class='fi fi-us'></span>", "en_title", V("en_title")))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ที่อยู่และช่องทางติดต่อ</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ที่อยู่ <span class='fi fi-th'></span>", "address", V("address"), 3))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ที่อยู่ <span class='fi fi-us'></span>", "en_address", V("en_address"), 3))
                </div>
                <div class="col-lg-12 mb-3">
                    @Html.Raw(_admin.InputText("ลิงก์แผนที่ (Google Maps URL)", "address_url", V("address_url"), "https://www.google.com/maps/...", 2000))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("เบอร์โทรศัพท์", "tel", V("tel"), "02 672 1111", 50))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputEmail("อีเมล", "email", V("email"), "customercare@assetfund.co.th", 255))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>โซเชียลมีเดีย</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("LINE URL", "sc_ln", V("sc_ln"), "https://line.me/...", 2000))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Facebook URL", "sc_fb", V("sc_fb"), "https://www.facebook.com/...", 2000))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("YouTube URL", "sc_yt", V("sc_yt"), "https://www.youtube.com/...", 2000))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Blockdit URL", "sc_bd", V("sc_bd"), "https://www.blockdit.com/...", 2000))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ปีและสโลแกน (โซนขวาของ footer)</legend>
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("เลขปี", "promo_year", V("promo_year"), "2026", 20))
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("สโลแกนบรรทัดบน", "tagline_1", V("tagline_1"), "VALUE BEYOND WEALTH"))
                </div>
                <div class="col-lg-4 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("สโลแกนบรรทัดล่าง", "tagline_2", V("tagline_2"), "คุณค่าที่เหนือกว่าความมั่งคั่ง"))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ดาวน์โหลดแอปพลิเคชัน</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "app_title", V("app_title"), "ดาวน์โหลดแอป ASP FUND"))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_app_title", V("en_app_title"), "Download ASP FUND App"))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("App Store URL", "sc_as", V("sc_as"), "https://apps.apple.com/...", 2000))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Google Play URL", "sc_gp", V("sc_gp"), "https://play.google.com/...", 2000))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("รูป QR Code <span style='font-weight: normal;color: orange;'>(.png, .jpg, .webp สี่เหลี่ยมจัตุรัส แนะนำ 300 x 300)</span>", "app_qr", V("app_qr")))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ลิขสิทธิ์ (Copyright)</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Copyright <span class='fi fi-th'></span>", "cr", V("cr"), "© 2026 Asset Plus Fund Management Co., Ltd."))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Copyright <span class='fi fi-us'></span>", "en_cr", V("en_cr"), "© 2026 Asset Plus Fund Management Co., Ltd."))
                </div>
            </div>
        </fieldset>

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        // Alt Text ภาษาไทยจำเป็น — ใช้เป็นชื่อรายการในหน้า list และ Admin Log
        if ($('[name="title"]').val().trim() === '') {
            sAlert("ข้อมูลไม่ครบ", "กรุณาระบุ Alt Text ของโลโก้ (ภาษาไทย)", "warning");
            $('[name="title"]').focus();
            return false;
        }

        // ช่อง URL ทุกช่องต้องเป็นลิงก์ที่ใช้ได้ (http/https) หรือเว้นว่าง — กันพิมพ์ชื่อเพจเฉย ๆ แล้วลิงก์พัง
        var urlFields = { address_url: 'ลิงก์แผนที่', sc_ln: 'LINE URL', sc_fb: 'Facebook URL', sc_yt: 'YouTube URL', sc_bd: 'Blockdit URL', sc_as: 'App Store URL', sc_gp: 'Google Play URL' };
        for (var name in urlFields) {
            var v = ($('[name="' + name + '"]').val() || '').trim();
            if (v !== '' && !/^https?:\/\/\S+$/i.test(v)) {
                sAlert("ลิงก์ไม่ถูกต้อง", "ช่อง " + urlFields[name] + " ต้องขึ้นต้นด้วย http:// หรือ https://", "warning");
                $('[name="' + name + '"]').focus();
                return false;
            }
        }

        var email = ($('[name="email"]').val() || '').trim();
        if (email !== '' && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            sAlert("อีเมลไม่ถูกต้อง", "กรุณาตรวจสอบรูปแบบอีเมล", "warning");
            $('[name="email"]').focus();
            return false;
        }

        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }

    $(document).ready(function() {
        checkLockedRow(modConfig, jsonRow);
    });
</script>
}
