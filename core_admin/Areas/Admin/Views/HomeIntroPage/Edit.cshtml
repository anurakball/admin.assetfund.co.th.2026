@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        <div class="row">
            @Html.Raw(_admin.InputText("หัวข้อ", "title", (row["title"].ToString() ?? "").Trim()))
        </div>

        <br />

        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("สีพื้นหลัง", "main_color", (row["main_color"].ToString() ?? "").Trim()))
                <script>
                    $("#id_main_color").spectrum({
                        color: "@Html.Raw((row["main_color"].ToString() ?? "").Trim())"
                    });
                </script>
            </div>
        </div>
         
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  กว้าง 1200 ขึ้นไป สูงอิสระ)</span>", "img1", (row["img1"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row">
            @Html.Raw(_admin.InputTextEditor("เนื้อหา", "info", (row["info"].ToString() ?? "").Trim()))
            <input type="hidden" id="en_info" name="en_info" value="" />
        </div>
          
        <br />

        <label for="id_main_color" class="form-label">ปุ่มเข้าสู่เว็บไซต์</label>
        <table style="width:100%; background-color:#CCC;  border-spacing: 1px;border-collapse: separate;" cellpadding="30" cellspacing="1">
            <tr style="background-color:#FFF;">
                @{
                    for (int i = 1; i <= 3; i++)
                    {
                        <td>
                            <div class="row">
                                <h4>@Html.Raw("ปุ่มที่ "+i)</h4>
                            </div>
                            <br>
                            <div class="row">
                                @Html.Raw(_admin.InputText("ข้อความในปุ่ม", "title_" + i + "_text", (row["title_" + i + "_text"].ToString() ?? "").Trim()))
                            </div>
                            <br />
                            <div class="row">
                                @Html.Raw(_admin.InputText("สีปุ่ม", "title_" + i + "_color", (row["title_" + i + "_color"].ToString() ?? "").Trim()))
                                @Html.Raw("<script> $('#id_title_"+i+"_color').spectrum({ color: '" + (row["title_" + i + "_color"].ToString() ?? "").Trim() + "' }); </script>")
                            </div>
                            <br />
                            <div class="row">
                                @Html.Raw(_admin.InputText("สีข้อความ", "title_" + i + "_color_text", (row["title_" + i + "_color_text"].ToString() ?? "").Trim()))
                                @Html.Raw("<script> $('#id_title_"+i+"_color_text').spectrum({ color: '" + (row["title_" + i + "_color_text"].ToString() ?? "").Trim() + "' }); </script>")
                            </div>
                            <br />
                            @{
                                if(i == 1)
                                {
                                    <div class="row"> 
                                    <div class="field">
                                    <label for="dis_id_title_1_url" class="form-label">ลิ้งค์ URL ปุ่ม</label>
                                    <input type="text" class="form-control" id="dis_id_title_1_url" name="dis_title_1_url" value="/th?intro=1" placeholder="" maxlength="8000" disabled>  
                                     <a href="javascript:;">[Link Helper]</a>
                                    </div>
                                    @{
                                        string _url = "_url";
                                    }
                                    <input type="hidden" name="title_@i@_url" value="" />
                                    </div> 
                                    <br />
                                    <div class="row">
                                    @Html.Raw(_admin.InputUrlTarget("URL Target", "title_" + i + "_url_target", @row["title_" + i + "_url_target"] + ""))
                                    </div>
                                }
                                else
                                {
                                    <div class="row">
                                    @Html.Raw(_admin.InputTextLinkCMSPage("ลิ้งค์ URL ปุ่ม", "title_" + i + "_url", (row["title_" + i + "_url"].ToString() ?? "").Trim()))
                                    </div>
                                    <br />
                                    <div class="row">
                                    @Html.Raw(_admin.InputUrlTarget("URL Target", "title_" + i + "_url_target", @row["title_" + i + "_url_target"] + ""))
                                    </div>
                                }
                            } 
                        </td>
                    }
                }
            </tr>
        </table>


         <br />
         
        <script>
            $(document).ready(function () { 
                $(":input[name='issue_date_config']").click(function () {
                    if ($(this).val() == '2') {
                        $('#div_id_issue_date').stop(true, false).slideDown();
                    }
                    else {
                        $('#div_id_issue_date').stop(true, false).slideUp();
                    }
                });
            });
        </script>
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">วันที่แสดงผล</label>
                    <div class="row">
                        <div class="col-md-6 col-sm-6 col-6">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="issue_date_config" id="id_issue_date_config_1" value="1" checked>
                                <label class="form-check-label" for="id_issue_date_config_1">
                                    แสดงตลอดเวลา
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-6 col-6">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="issue_date_config" id="id_issue_date_config_2" value="2">
                                <label class="form-check-label" for="id_issue_date_config_2">
                                    กำหนดเอง
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
         
        <div class="" id="div_id_issue_date" style="display:none;">
            <div class="row">
                @{
                    string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
                    string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
                }
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputDateTime("วันที่แสดงผล", "issue_date", issue_date))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputDateTime("วันที่สิ้นสุดแสดงผล", "expiry_date", expiry_date))
                </div>
            </div>
        </div>
         
        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@{
    if ((row["issue_date_config"].ToString() ?? "").Trim() == "2")
    {
        <script>
            document.getElementById('id_issue_date_config_2').checked = true;
            document.getElementById('div_id_issue_date').style.display = '';
        </script>
    }
    else
    {
        <script>
            document.getElementById('id_issue_date_config_1').checked = true;
            document.getElementById('div_id_issue_date').style.display = 'none';
        </script>
    }
}

@await Component.InvokeAsync("LinkHelper")

@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        if(document.getElementById('id_issue_date_config_2').checked == true)
        { 
            if (
                $('#id_issue_date').val() != '' && $('#id_expiry_date').val() != '' &&
                $('#id_issue_date').datetimepicker('getValue') > $('#id_expiry_date').datetimepicker('getValue')
            ) 
            {
                sAlert("วันที่ไม่ถูกต้อง", "วันที่สิ้นสุด ต้องมากกว่า วันที่แสดงผล", "warning");
                return false;
            }
        }
         
        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }
    
    $(document).ready(function() {

        checkLockedRow(modConfig, jsonRow);

        //$(":input[name='title'],:input[name='main_color']").prop("required", true);

        setTimeout(function(){
            $(':input[name="issue_date"]').datetimepicker("destroy");
            $(':input[name="issue_date"]').datetimepicker({
                format: 'd/m/Y H:i',
                minDate: 0
            });
        },500);
    });
</script>
}