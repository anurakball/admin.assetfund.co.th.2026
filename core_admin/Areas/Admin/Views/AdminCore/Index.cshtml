@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
    var searchInputVal = (Dictionary<string, string>)ViewBag.searchInputVal;

    @* ── ปุ่ม [Preview] ดูตัวอย่างหน้าเว็บ front-end ของฉบับร่าง ──
       เปิดเฉพาะโมดูลที่ประกาศไว้ใน PreviewMenu (ต้อง sync กับ PreviewMap ฝั่ง front-end)
       ปุ่มวางไว้หน้าคอลัมน์แรกของ ListData และโผล่ทุกแถว (ไม่จำกัดสถานะอนุมัติ)
       ยกเว้นแถวที่ถูกปิดด้วยกฎระดับแถวใน PreviewRowGate *@
    var frontUrl = (_utility.frontURL() ?? "").TrimEnd('/');
    var hasFrontPreview = frontUrl != "" && PreviewMenu.IsSupported(mod.Name)
                          && mod_config.ListData != null && mod_config.ListData.Count > 0;
    var previewColumnKey = hasFrontPreview ? mod_config.ListData[0].Key : "";
    @* กฎระดับแถว: ซ่อนปุ่มของแถวที่หน้าเว็บ front-end ไม่เรนเดอร์ค่าของแถวนั้น (พรีวิวแล้วไม่เห็นผล)
       สร้างครั้งเดียวต่อหน้า — ดู PreviewRowGate ใน Areas/Admin/Helpers/PreviewMenu.cs *@
    var previewGate = hasFrontPreview ? PreviewMenu.CreateGate(mod.Name, _db) : null;

    @* ── ลิงก์ "ดูรายชื่อผู้สมัคร" ท้ายหัวข้อ (เฉพาะเมนูประกาศจัดซื้อจัดจ้าง ประเภท "ประกาศเชิญชวน") ──
       กดแล้วไปหน้ารายชื่อผู้ลงทะเบียน พร้อมเลือก dropdown "ประกาศ" เป็นรายการนั้นให้อัตโนมัติ
       (ส่ง ?cat_id=<id ของประกาศ> — web_announce_submit.cat_id อ้าง web_core_news.id)
       text= / page=1 ต่อท้ายเพื่อล้างคำค้นหาและหน้าเดิมที่ค้างอยู่ใน session ของเมนูปลายทาง
       id หมวดหามาจากชื่อ ไม่ได้ hardcode — ถ้าไม่พบหมวดนี้ ลิงก์จะไม่แสดง *@
    string inviteCatId = (mod.Name == "AnnouncePro" && !string.IsNullOrEmpty(mod_config.TableCateModuleID))
        ? _admin.GetCatIdByTitle(mod_config.TableCate, Convert.ToInt32(mod_config.TableCateModuleID), "ประกาศเชิญชวน")
        : "";
    Func<DataRow, bool> hasSubmitLink = row =>
        inviteCatId != "" && row.Table.Columns.Contains("cat_id") && row["cat_id"].ToString() == inviteCatId;
    Func<DataRow, string> submitLinkHtml = row =>
        "<a href=\"/Admin/AnnounceSubmit?cat_id=" + row["id"] + "&text=&page=1\" class=\"badge bg-primary\" style=\"margin-left:6px;text-decoration:none;white-space:nowrap;\" title=\"ดูรายชื่อผู้ลงทะเบียนของประกาศนี้\"><i class=\"bi bi-people\"></i> ดูรายชื่อผู้สมัคร</a>";
}
@section NavbarBack{
    @if (mod_config.IsCMSPage == true && mod_config.FieldCMSPage != "" && _session.GetInt32("admin_" + mod.Name + "_parent_lv").HasValue && _session.GetInt32("admin_" + mod.Name + "_parent_lv") > 1)
    {
        int parent_id = _admin.getParentID(mod, Convert.ToInt32(_session.GetString("admin_" + mod.Name + "_search_" + mod_config.FieldCMSPage)));
        @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}?{1}={2}", mod.Name, mod_config.FieldCMSPage, parent_id) })
    }
} 
@await Component.InvokeAsync("AdminBreadcrumb",  new { Module = mod })
<style type="text/css">
.badge {
display: inline-block;
padding: 0.35em 0.65em;
font-size: 1em;
font-weight: 700;
line-height: 1;
color: #fff;
text-align: center;
white-space: nowrap;
vertical-align: baseline;
border-radius: 0.25rem;
}
</style>
@if ((mod_config.FieldSearch != null && mod_config.FieldSearch.Count > 0) || mod_config.EnableDateSearch == true || (!string.IsNullOrEmpty(mod_config.TableCate) && !string.IsNullOrEmpty(mod_config.TableCateField)))
{
    <div class="form-wrapper">
        <form action="" method="get" autocomplete="off" id="formSearch" class="form">
            <div class="row">
                @if (mod_config.FieldSearch.Count > 0 && mod_config.FieldSearch.Where(c => c.Key == "text").ToList().Count() > 0)
