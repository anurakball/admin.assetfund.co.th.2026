                    <div class="col-lg-4 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("ค้นหา", "text", (searchInputVal.ContainsKey("text") && !string.IsNullOrEmpty(searchInputVal["text"]) ? searchInputVal["text"] : ""), "คำค้นหา"))
                    </div>
                }

                @if (mod.Name == "MemberList")
                {
                    var mtSel = (searchInputVal.ContainsKey("member_type") && !string.IsNullOrEmpty(searchInputVal["member_type"])) ? searchInputVal["member_type"] : "";
