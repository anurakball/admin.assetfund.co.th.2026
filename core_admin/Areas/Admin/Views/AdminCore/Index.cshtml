                @if (!string.IsNullOrEmpty(mod_config.TableCate) && !string.IsNullOrEmpty(mod_config.TableCateField))
                {
                    if (@mod.Name == "CMSPage" || @mod.Name == "CMSPageFooter1" || @mod.Name == "CMSPageFooter2" || @mod.Name == "FooterLink")
                    {
                        
                    }
                    else if (@mod.Name == "AboutBoard2" || @mod.Name == "AboutBoard3" || @mod.Name == "AboutBoard4sub" || @mod.Name == "Article" || @mod.Name == "News" || @mod.Name == "VDOGroupsub" || @mod.Name == "AnnounceOther" || @mod.Name == "AnnouncePro" || @mod.Name == "ContactSubmit" || @mod.Name == "Download" || @mod.Name == "DownloadSubmit" || @mod.Name == "FAQ" || @mod.Name == "Link" || @mod.Name == "Promotion" || @mod.Name == "EForm")
                    {
