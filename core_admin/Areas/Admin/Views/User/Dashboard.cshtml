@using thaicredit_hr_admin.Areas.Admin.Helpers;
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutIntro.cshtml";
}
@section pageIntro{
    <link rel="stylesheet" href="~/css/pages/intro.min.css?v=ap2026" />
    <link href="~/assets/fonts/fontawesome7/css/all.min.css" rel="stylesheet" />
    <style>
        /* แถบผู้ใช้ + ปุ่ม Logout มุมขวาบน (หน้าอื่นในหลังบ้านมีใน header ของ _AdminLayout — หน้านี้ใช้ _LayoutIntro ที่ไม่มี header) */
        .dashboard-userbar { position: absolute; top: 16px; right: 24px; z-index: 20; display: flex; align-items: center; gap: 12px; color: #fff; font-size: 15px; }
        .dashboard-userbar__name { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
        .dashboard-userbar__logout { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: 1px solid rgba(255,255,255,.7); border-radius: 50rem; background: transparent; color: #fff; font-size: 15px; line-height: 1.2; cursor: pointer; transition: background-color .15s, color .15s; }
        .dashboard-userbar__logout:hover, .dashboard-userbar__logout:focus-visible { background: #fff; color: #00295A; outline: none; }
        @@media (max-width: 575.98px) {
            .dashboard-userbar { top: 10px; right: 12px; font-size: 14px; }
            .dashboard-userbar__name { display: none; }
        }
    </style>
}

@* ปุ่ม Logout — ส่ง POST /Admin/User/Logout พร้อม anti-forgery token เหมือน logOut() ของหน้าอื่น (wwwroot/js/Admin/admin_site.js) *@
<div class="dashboard-userbar">
    <span class="dashboard-userbar__name">
        <i class="bi bi-person-circle" aria-hidden="true"></i>
        @(Context.Session.GetString("admin_name") ?? "") @(Context.Session.GetString("admin_surname") ?? "")
    </span>
    <button type="button" class="dashboard-userbar__logout" id="btnDashboardLogout" onclick="dashboardLogOut()"
            title="ออกจากระบบ" data-bs-toggle="tooltip" data-bs-placement="bottom">
        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
        <span>Logout</span>
    </button>
    <form id="dashboardLogoutForm" method="post" action="/Admin/User/Logout" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>
  
<div class="intropage-wrapper">
    <div class="img-bgintro" style="padding:20px;">

        <div class="container">
            <div class="row mb-5">
                <div class="col-12">
                    <div class="img-logo" style="margin-bottom:5px !important;">
                        <img src="/assets/images/icon/assetplus-logo-white.png" style="height:53px;"/>
                    </div>
                    <div align="center">
                        <button type="button" class="btn" onclick="window.location.href='/Admin/User/LastActivity'" style="background-color:#fff;font-size:22px;box-shadow: 5px 5px #00B4E5;">
                            <span class="btn-icon"><i class="fa-solid fa-screwdriver-wrench"></i></span>
                            <span class="btn-text">Admin Panel</span>
                        </button>
                    </div>
                    <div class="head-page mb-3">
                        <h2>Asset Plus Admin Management</h2>
                        <p class="text-white">Here is what’s happening with your Report today:</p>
                    </div>
                     
                    <div class="row mb-5" style="margin-bottom:1px !important;">
                        <div class="col-lg-4 col-md-6 col-12">
                            <div class="box-display">
                                <div class="head-display">
                                    <div class="name-display">Active users</div>
                                    <a class="icon-display" target="_top" href="/Admin/User/LastActivity">
                                        <i class="bi bi-arrow-right-short"></i>
                                    </a>
                                </div>
                                <div class="body-display">@ViewBag.active_user_today</div>
                            </div>    
                        </div>
                        <div class="col-lg-4 col-md-6 col-12">
                            <div class="box-display">
                                <div class="head-display">
                                    <div class="name-display">Total Users</div>
                                    <a class="icon-display" target="_top" href="/Admin/User/LastActivity">
                                        <i class="bi bi-arrow-right-short"></i>
                                    </a>
                                </div>
                                <div class="body-display">@ViewBag.total_user_today</div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12">
                            <div class="box-display">
                                <div class="head-display">
                                    <div class="name-display">User Active/weekly (%)</div>
                                    <a class="icon-display" target="_top" href="/Admin/User/LastActivity">
                                        <i class="bi bi-arrow-right-short"></i>
                                        </a>
                                </div>
                                <div class="body-display">@ViewBag.sum_weekly%</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>        
            <div class="row mb-5" style="margin-bottom:30px !important;">
                <p class="text-white">Here are the systems that were accessed most recently:</p>
            </div>
            <div class="row">
                 
                @if (ViewBag.LastUse != null)
                {
                    foreach (System.Data.DataRow item in (System.Data.DataRowCollection)ViewBag.LastUse)
                    {
                        var moduleName = item["mod_name"].ToString();
                        var icon = new AdminMenu().Menu().SelectMany(x => x.SubMenu).FirstOrDefault(x => x.ModuleName == moduleName)?.Icon
                            ?? "fa-solid fa-window-maximize";   // เมนูที่ถูก comment ซ่อนไว้จะหาไอคอนไม่เจอ จึงใส่ไอคอนกลางไว้กัน <i> ว่าง
                         
                        <div class="col-lg-3 col-md-6 col-12">
                            <a class="shotcut-menu" href="/Admin/@Html.Raw(item["mod_name"])">
                                <div class="info" data-bs-toggle="tooltip" data-bs-placement="top" title="@Html.Raw(item["mod_name_txt"])"><i class="bi bi-info-circle"></i></div>
                                <div class="box-body">
                                    <div class="icon-menu" style="margin-top:1rem !important;margin-bottom:1rem !important;">
                                        <i class="@icon" style="font-size:72px; color:#333;"></i>
                                    </div>
                                    <div class="name-menu">@Html.Raw(item["mod_name_txt"])</div>
                                </div>
                            </a>
                        </div>    
                    }
                }
                 
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="head-page mb-3" style="margin-bottom:5px !important;"> 
                        <br /><p class="text-white">Latest access activities across menu items:</p><br />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped-custom" style="border:1px solid #fff;">
                            <thead>
                                <tr>
                                <th> &nbsp; Action</th>
                                <th> &nbsp; Action Date</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if(ViewBag.activ_logs != null)
                            {
                                foreach (System.Data.DataRow item in (System.Data.DataRowCollection)ViewBag.activ_logs)
                                {
                                    <tr>
                                        <td> &nbsp; @Html.Raw(item["action_info"])</td>
                                        <td> &nbsp; @Html.Raw(((DateTime)item["created_at"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <br /><br />
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/sweetalert2.min.js"></script>
    <script>
        function dashboardLogOut() {
            if (typeof Swal === 'undefined') {
                if (confirm('คุณต้องการออกจากระบบ ?')) document.getElementById('dashboardLogoutForm').submit();
                return;
            }
            Swal.fire({
                title: 'ออกจากระบบ ?',
                text: 'คุณต้องการออกจากระบบ ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#00295A',
                cancelButtonColor: '#BC1320',
                confirmButtonText: 'ใช่',
                cancelButtonText: 'ไม่ใช่'
            }).then(function (result) {
                if (result.isConfirmed) document.getElementById('dashboardLogoutForm').submit();
            });
        }
    </script>
}
