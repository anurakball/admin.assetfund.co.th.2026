@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
    var searchInputVal = (Dictionary<string, string>)ViewBag.searchInputVal;
}

@section NavbarBack{
    @if (mod_config.IsCMSPage == true && mod_config.FieldCMSPage != "" && _session.GetInt32("admin_" + mod.Name + "_parent_lv").HasValue && _session.GetInt32("admin_" + mod.Name + "_parent_lv") > 1)
    {
        int parent_id = _admin.getParentID(mod, Convert.ToInt32(_session.GetString("admin_" + mod.Name + "_search_" + mod_config.FieldCMSPage)));
        @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}?{1}={2}", mod.Name, mod_config.FieldCMSPage, parent_id) })
    }
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

@functions {
    string MethodClass(string m) => m switch {
        "GET"    => "bg-primary",
        "POST"   => "bg-success",
        "PUT"    => "bg-warning text-dark",
        "PATCH"  => "bg-info text-dark",
        "DELETE" => "bg-danger",
        _        => "bg-secondary"
    };
    string StatusClass(int? code) {
        if (code == null) return "bg-secondary";
        if (code >= 200 && code < 300) return "bg-success";
        if (code >= 300 && code < 400) return "bg-info text-dark";
        if (code >= 400 && code < 500) return "bg-warning text-dark";
        return "bg-danger";
    }
}

@{
    var _q = HttpContextAccessor.HttpContext!.Request.Query;
    string Q(string key) => _q.ContainsKey(key) ? (_q[key].ToString() ?? "").Trim() : "";

    var qService     = Q("q_service");
    var qModule      = Q("q_module");
    var qMethod      = Q("q_method");
    var qSuccess     = Q("q_success");
    var qEnv         = Q("q_env");
    var qTrace       = Q("q_trace");
    var qIp          = Q("q_ip");
    var qDateStart   = Q("q_date_start");
    var qDateEnd     = Q("q_date_end");

    int curPage = int.TryParse(Q("page"),    out var _cp) && _cp > 0 ? _cp : 1;
    int perPage = int.TryParse(Q("perpage"), out var _pp) && _pp >= 5 ? _pp : 20;
    int offset  = (curPage - 1) * perPage;

    var where = new System.Text.StringBuilder("WHERE 1=1");
    var prms  = new Dictionary<string, object>();

    if (!string.IsNullOrEmpty(qService)) { where.Append(" AND l.service_name ILIKE @p_svc");   prms["p_svc"]   = "%" + qService + "%"; }
    if (!string.IsNullOrEmpty(qModule))  { where.Append(" AND l.module_name ILIKE @p_mod");    prms["p_mod"]   = "%" + qModule + "%"; }
    if (!string.IsNullOrEmpty(qMethod))  { where.Append(" AND l.http_method = @p_method");     prms["p_method"]= qMethod; }
    if (!string.IsNullOrEmpty(qEnv))     { where.Append(" AND l.environment_name = @p_env");   prms["p_env"]   = qEnv; }
    if (!string.IsNullOrEmpty(qTrace))   { where.Append(" AND l.trace_id ILIKE @p_trace");     prms["p_trace"] = "%" + qTrace + "%"; }
    if (!string.IsNullOrEmpty(qIp))      { where.Append(" AND l.client_ip ILIKE @p_ip");       prms["p_ip"]    = "%" + qIp + "%"; }

    if (qSuccess == "1")      { where.Append(" AND l.is_success = TRUE"); }
    else if (qSuccess == "0") { where.Append(" AND l.is_success = FALSE"); }

    if (!string.IsNullOrEmpty(qDateStart)) {
        try { var p = qDateStart.Split('/'); var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0])); where.Append(" AND l.created_at >= @p_ds"); prms["p_ds"] = d; } catch {}
    }
    if (!string.IsNullOrEmpty(qDateEnd)) {
        try { var p = qDateEnd.Split('/'); var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0])).AddDays(1); where.Append(" AND l.created_at < @p_de"); prms["p_de"] = d; } catch {}
    }

    var w = where.ToString();

    var dtCount = _db.ExecuteQuery($@"
        SELECT COUNT(*) AS cnt FROM public.api_crm_logs l {w}", prms);
    long totalRows  = dtCount.Rows.Count > 0 ? Convert.ToInt64(dtCount.Rows[0]["cnt"]) : 0;
    int  totalPages = (int)Math.Ceiling((double)totalRows / perPage);

    var dtLogs = _db.ExecuteQuery($@"
        SELECT l.id, l.created_at,
               l.service_name, l.module_name,
               l.http_method, l.endpoint_url,
               l.request_headers, l.request_query, l.request_data,
               l.response_status_code,
               l.response_headers, l.return_data,
               l.is_success, l.error_message, l.exception_detail,
               l.duration_ms, l.client_ip, l.user_agent,
               l.member_id, l.created_by,
               l.trace_id, l.correlation_id,
               l.environment_name, l.remark
        FROM public.api_crm_logs l
        {w}
        ORDER BY l.created_at DESC
        LIMIT {perPage} OFFSET {offset}", prms);

    // Dropdowns
    var dtServices = _db.ExecuteQuery(
        "SELECT DISTINCT service_name FROM public.api_crm_logs WHERE service_name IS NOT NULL ORDER BY service_name");
    var dtEnvs = _db.ExecuteQuery(
        "SELECT DISTINCT environment_name FROM public.api_crm_logs WHERE environment_name IS NOT NULL ORDER BY environment_name");

    // Stats
    var dtStats = _db.ExecuteQuery($@"
        SELECT
            COUNT(*) FILTER (WHERE l.is_success = TRUE)  AS cnt_success,
            COUNT(*) FILTER (WHERE l.is_success = FALSE) AS cnt_failed,
            COUNT(*) FILTER (WHERE l.created_at >= NOW() - INTERVAL '24 hours') AS cnt_today,
            ROUND(AVG(l.duration_ms) FILTER (WHERE l.duration_ms IS NOT NULL))::BIGINT AS avg_duration
        FROM public.api_crm_logs l {w}", prms);

    long cntSuccess    = dtStats.Rows.Count > 0 && dtStats.Rows[0]["cnt_success"]  != DBNull.Value ? Convert.ToInt64(dtStats.Rows[0]["cnt_success"])  : 0;
    long cntFailed     = dtStats.Rows.Count > 0 && dtStats.Rows[0]["cnt_failed"]   != DBNull.Value ? Convert.ToInt64(dtStats.Rows[0]["cnt_failed"])   : 0;
    long cntToday      = dtStats.Rows.Count > 0 && dtStats.Rows[0]["cnt_today"]    != DBNull.Value ? Convert.ToInt64(dtStats.Rows[0]["cnt_today"])    : 0;
    long avgDuration   = dtStats.Rows.Count > 0 && dtStats.Rows[0]["avg_duration"] != DBNull.Value ? Convert.ToInt64(dtStats.Rows[0]["avg_duration"]) : 0;

    // Build query string
    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(qService))   qsParts.Add("q_service="   + Uri.EscapeDataString(qService));
    if (!string.IsNullOrEmpty(qModule))    qsParts.Add("q_module="    + Uri.EscapeDataString(qModule));
    if (!string.IsNullOrEmpty(qMethod))    qsParts.Add("q_method="    + Uri.EscapeDataString(qMethod));
    if (!string.IsNullOrEmpty(qSuccess))   qsParts.Add("q_success="   + Uri.EscapeDataString(qSuccess));
    if (!string.IsNullOrEmpty(qEnv))       qsParts.Add("q_env="       + Uri.EscapeDataString(qEnv));
    if (!string.IsNullOrEmpty(qTrace))     qsParts.Add("q_trace="     + Uri.EscapeDataString(qTrace));
    if (!string.IsNullOrEmpty(qIp))        qsParts.Add("q_ip="        + Uri.EscapeDataString(qIp));
    if (!string.IsNullOrEmpty(qDateStart)) qsParts.Add("q_date_start="+ Uri.EscapeDataString(qDateStart));
    if (!string.IsNullOrEmpty(qDateEnd))   qsParts.Add("q_date_end="  + Uri.EscapeDataString(qDateEnd));
    qsParts.Add("perpage=" + perPage);
    var baseQs   = string.Join("&", qsParts);
    var exportQs = string.Join("&", qsParts.Where(p => !p.StartsWith("perpage=")));

    int rowNum = offset + 1;

    // Data map for modal
    var logDataMap = new Dictionary<string, object>();
    foreach (DataRow lr in dtLogs.Rows) {
        var _at  = lr["created_at"] != DBNull.Value ? Convert.ToDateTime(lr["created_at"]) : DateTime.MinValue;
        var _dur = lr["duration_ms"] != DBNull.Value ? Convert.ToInt32(lr["duration_ms"]) : -1;
        var _code = lr["response_status_code"] != DBNull.Value ? Convert.ToInt32(lr["response_status_code"]) : (int?)null;
        logDataMap[lr["id"].ToString()] = new {
            id                   = lr["id"]?.ToString(),
            created_at           = _at != DateTime.MinValue ? _at.ToString("dd/MM/yyyy HH:mm:ss") : "",
            service_name         = lr["service_name"]?.ToString() ?? "",
            module_name          = lr["module_name"]?.ToString() ?? "",
            http_method          = lr["http_method"]?.ToString() ?? "",
            endpoint_url         = lr["endpoint_url"]?.ToString() ?? "",
            request_headers      = lr["request_headers"]?.ToString() ?? "",
            request_query        = lr["request_query"]?.ToString() ?? "",
            request_data         = lr["request_data"]?.ToString() ?? "",
            response_status_code = _code?.ToString() ?? "",
            response_headers     = lr["response_headers"]?.ToString() ?? "",
            return_data          = lr["return_data"]?.ToString() ?? "",
            is_success           = lr["is_success"] != DBNull.Value && Convert.ToBoolean(lr["is_success"]),
            error_message        = lr["error_message"]?.ToString() ?? "",
            exception_detail     = lr["exception_detail"]?.ToString() ?? "",
            duration             = _dur,
            client_ip            = lr["client_ip"]?.ToString() ?? "",
            user_agent           = lr["user_agent"]?.ToString() ?? "",
            member_id            = lr["member_id"]?.ToString() ?? "",
            created_by           = lr["created_by"]?.ToString() ?? "",
            trace_id             = lr["trace_id"]?.ToString() ?? "",
            correlation_id       = lr["correlation_id"]?.ToString() ?? "",
            environment_name     = lr["environment_name"]?.ToString() ?? "",
            remark               = lr["remark"]?.ToString() ?? ""
        };
    }
    var logDataJson = Newtonsoft.Json.JsonConvert.SerializeObject(logDataMap);
}

@* ===================== SEARCH FORM ===================== *@
<div class="form-wrapper mb-4">
    <form method="get" id="formSearch" class="form" autocomplete="off">
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Service Name</label>
                    <select name="q_service" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtServices.Rows) {
                            var svc = r["service_name"].ToString();
                            <option value="@svc" @(qService == svc ? "selected" : "")>@svc</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Module / Function</label>
                    <input type="text" name="q_module" value="@qModule" class="form-control" placeholder="ค้นหา..." />
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">HTTP Method</label>
                    <select name="q_method" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var m in new[] { "GET", "POST", "PUT", "PATCH", "DELETE" }) {
                            <option value="@m" @(qMethod == m ? "selected" : "")>@m</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">สถานะ</label>
                    <select name="q_success" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        <option value="1" @(qSuccess == "1" ? "selected" : "")>Success</option>
                        <option value="0" @(qSuccess == "0" ? "selected" : "")>Failed</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Environment</label>
                    <select name="q_env" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtEnvs.Rows) {
                            var env = r["environment_name"].ToString();
                            <option value="@env" @(qEnv == env ? "selected" : "")>@env</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Trace ID</label>
                    <input type="text" name="q_trace" value="@qTrace" class="form-control" placeholder="trace-xxxx" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Client IP</label>
                    <input type="text" name="q_ip" value="@qIp" class="form-control" placeholder="192.168.x.x" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">แสดงหน้าละ</label>
                    <select name="perpage" class="form-select">
                        @foreach (var n in new[] { 10, 20, 50, 100 }) {
                            <option value="@n" @(perPage == n ? "selected" : "")>@n รายการ</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="field">
                    <label class="form-label">ช่วงวันที่</label>
                    <div class="input-group input-daterange">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                        <input type="text" id="date_timepicker_start" name="q_date_start" value="@qDateStart" class="form-control" placeholder="วันเริ่มต้น" readonly />
                        <span class="input-group-text">ถึง</span>
                        <input type="text" id="date_timepicker_end" name="q_date_end" value="@qDateEnd" class="form-control" placeholder="วันสิ้นสุด" readonly />
                    </div>
                </div>
            </div>
        </div>
        <div class="btn-group mt-1">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon"><i class="bi bi-search"></i></span>
                <span class="btn-text">ค้นหา</span>
            </button>

            @{
                if(Context.Request.Query["perpage"]+"" != "")
                {
                    <a href="?page=1" class="btn btn--gray">
                        <span class="btn-icon"><i class="bi bi-x-circle"></i></span>
                        <span class="btn-text">ล้างค่า</span>
                    </a>
                }
            }
            
        </div>
    </form>
</div>

@* ===================== SUMMARY CARDS ===================== *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-primary">@totalRows.ToString("N0")</div>
                <div class="small text-muted">รายการทั้งหมด</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-success">@cntSuccess.ToString("N0")</div>
                <div class="small text-muted">Success</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-danger">@cntFailed.ToString("N0")</div>
                <div class="small text-muted">Failed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-info">@cntToday.ToString("N0")</div>
                <div class="small text-muted">วันนี้ (24h)</div>
            </div>
        </div>
    </div>
</div>

@* ===================== TABLE ===================== *@
<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center py-2">
        <span class="fw-semibold"><i class="bi bi-diagram-3 me-1"></i> รายการ CRM API Logs</span>
        <span class="text-muted small ms-auto me-4">ทั้งหมด @totalRows.ToString("N0") รายการ &bull; หน้า @curPage / @(totalPages == 0 ? 1 : totalPages)</span>
        <a href="/Admin/LogsCRM/ExportExcel@(string.IsNullOrEmpty(exportQs) ? "" : "?" + exportQs)"
           class="btn btn-sm" style="background-color:#217346;color:#fff;border-color:#217346"
           title="Export ผลลัพธ์การค้นหาเป็น Excel">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped-custom mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:50px">#</th>
                        <th style="width:150px">วันที่ / เวลา</th>
                        <th style="width:170px">Service / Module</th>
                        <th>Method / Endpoint</th>
                        <th style="width:90px" class="text-center">Status Code</th>
                        <th style="width:90px" class="text-center">ผลลัพธ์</th>
                        <th style="width:90px" class="text-center">Duration</th>
                        <th style="width:130px">Client IP / User</th>
                        <th style="width:60px" class="text-center">รายละเอียด</th>
                    </tr>
                </thead>
                <tbody>
                @if (dtLogs.Rows.Count == 0) {
                    <tr><td colspan="9" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-3 d-block mb-2"></i>ไม่พบข้อมูล</td></tr>
                }
                @foreach (DataRow row in dtLogs.Rows) {
                    var isSuccess   = row["is_success"] != DBNull.Value && Convert.ToBoolean(row["is_success"]);
                    var createdAt   = row["created_at"] != DBNull.Value ? Convert.ToDateTime(row["created_at"]) : DateTime.MinValue;
                    var durationMs  = row["duration_ms"] != DBNull.Value ? Convert.ToInt32(row["duration_ms"]) : -1;
                    var statusCode  = row["response_status_code"] != DBNull.Value ? Convert.ToInt32(row["response_status_code"]) : (int?)null;
                    var httpMethod  = row["http_method"]?.ToString() ?? "";
                    var endpointUrl = row["endpoint_url"]?.ToString() ?? "";
                    var serviceName = row["service_name"]?.ToString() ?? "";
                    var moduleName  = row["module_name"]?.ToString() ?? "";
                    var clientIp    = row["client_ip"]?.ToString() ?? "";
                    var createdBy   = row["created_by"]?.ToString() ?? "";
                    var envName     = row["environment_name"]?.ToString() ?? "";

                    <tr data-id="@row["id"]">
                        <td class="text-center text-muted small">@rowNum</td>
                        <td class="small">
                            @if (createdAt != DateTime.MinValue) {
                                <span class="d-block">@createdAt.ToString("dd/MM/yyyy")</span>
                                <span class="text-muted">@createdAt.ToString("HH:mm:ss")</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold small">@serviceName</div>
                            @if (!string.IsNullOrEmpty(moduleName)) {
                                <div class="text-muted" style="font-size:.75rem"><i class="bi bi-braces me-1"></i>@moduleName</div>
                            }
                            @if (!string.IsNullOrEmpty(envName)) {
                                <span class="badge bg-secondary bg-opacity-25 text-dark border mt-1" style="font-size:.65rem">@envName</span>
                            }
                        </td>
                        <td>
                            <span class="badge @MethodClass(httpMethod) me-1" style="font-size:.7rem">@httpMethod</span>
                            <span class="small text-break" style="font-size:.78rem;word-break:break-all">@endpointUrl</span>
                        </td>
                        <td class="text-center">
                            @if (statusCode.HasValue) {
                                <span class="badge @StatusClass(statusCode)">@statusCode</span>
                            } else {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (isSuccess) {
                                <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Success</span>
                            } else {
                                <span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>Failed</span>
                                @if (!string.IsNullOrEmpty(row["error_message"]?.ToString())) {
                                    <i class="bi bi-exclamation-circle text-danger ms-1" data-toggle="tooltip" title="@row["error_message"]"></i>
                                }
                            }
                        </td>
                        <td class="text-center small">
                            @if (durationMs >= 0) {
                                <span class="@(durationMs > 3000 ? "text-danger fw-semibold" : durationMs > 1000 ? "text-warning" : "text-success")">
                                    @(durationMs >= 1000 ? (durationMs / 1000.0).ToString("F1") + "s" : durationMs + "ms")
                                </span>
                            } else {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(clientIp)) {
                                <div><i class="bi bi-hdd-network me-1 text-muted"></i><code class="small">@clientIp</code></div>
                            }
                            @if (!string.IsNullOrEmpty(createdBy)) {
                                <div class="text-muted" style="font-size:.72rem"><i class="bi bi-person me-1"></i>@createdBy</div>
                            }
                            @if (row["member_id"] != DBNull.Value) {
                                <div class="text-muted" style="font-size:.72rem">MID: @row["member_id"]</div>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn--outline--primary btn-log-detail"
                                    data-log-id="@row["id"]">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                    rowNum++;
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1) {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                แสดง @(offset + 1)–@(Math.Min(offset + perPage, (int)totalRows)) จาก @totalRows.ToString("N0") รายการ
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @{ int pgStart = Math.Max(1, curPage - 2); int pgEnd = Math.Min(totalPages, curPage + 2); }
                    @if (curPage > 1) {
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=1"><i class="bi bi-chevron-double-left"></i></a></li>
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@(curPage-1)"><i class="bi bi-chevron-left"></i></a></li>
                    }
                    @for (int p = pgStart; p <= pgEnd; p++) {
                        <li class="page-item @(p == curPage ? "active" : "")">
                            <a class="page-link" href="?@baseQs&page=@p">@p</a>
                        </li>
                    }
                    @if (curPage < totalPages) {
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@(curPage+1)"><i class="bi bi-chevron-right"></i></a></li>
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@totalPages"><i class="bi bi-chevron-double-right"></i></a></li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@* ===================== DETAIL MODAL ===================== *@
<div class="modal fade" id="modalLogDetail" tabindex="-1" aria-labelledby="modalLogDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLogDetailLabel">
                    <i class="bi bi-diagram-3 me-2"></i>รายละเอียด CRM API Log
                    <span id="mdlBadgeMethod" class="badge ms-2"></span>
                    <span id="mdlBadgeStatus" class="badge ms-1"></span>
                    <span id="mdlBadgeSuccess" class="badge ms-1"></span>
                </h5>
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-diagram-3 me-1"></i>ข้อมูล Service</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Service</td><td id="mdlService" class="fw-semibold"></td></tr>
                                <tr><td class="text-muted">Module</td><td id="mdlModule"></td></tr>
                                <tr><td class="text-muted">Environment</td><td id="mdlEnv"></td></tr>
                                <tr><td class="text-muted">วันที่/เวลา</td><td id="mdlCreatedAt"></td></tr>
                                <tr><td class="text-muted">Duration</td><td id="mdlDuration"></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-link-45deg me-1"></i>ข้อมูล Request</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Method</td><td><code id="mdlMethod"></code></td></tr>
                                <tr><td class="text-muted">Endpoint</td><td><span id="mdlEndpoint" class="text-break" style="font-size:.78rem"></span></td></tr>
                                <tr><td class="text-muted">Status Code</td><td><span id="mdlStatusCode"></span></td></tr>
                                <tr><td class="text-muted">Member ID</td><td id="mdlMemberId"></td></tr>
                                <tr><td class="text-muted">Created By</td><td id="mdlCreatedBy"></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-hdd-network me-1"></i>ข้อมูลเครือข่าย</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Client IP</td>
                                    <td><code id="mdlClientIp"></code> <button class="btn btn-sm p-0 ms-1 text-muted" id="btnCopyIp" title="Copy"><i class="bi bi-clipboard"></i></button></td></tr>
                                <tr><td class="text-muted">User Agent</td><td><span id="mdlUserAgent" class="text-break" style="font-size:.72rem;word-break:break-all"></span></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-key me-1"></i>Trace / Correlation</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Trace ID</td><td><span id="mdlTraceId" style="font-size:.72rem;word-break:break-all"></span></td></tr>
                                <tr><td class="text-muted">Correlation ID</td><td><span id="mdlCorrelationId" style="font-size:.72rem;word-break:break-all"></span></td></tr>
                                <tr><td class="text-muted">Log ID</td><td><code id="mdlLogId"></code></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div id="mdlErrorWrap" class="mb-3 d-none">
                    <div class="small fw-semibold text-danger mb-1"><i class="bi bi-exclamation-triangle me-1"></i>ข้อผิดพลาด</div>
                    <div id="mdlError" class="border border-danger rounded p-2 bg-danger bg-opacity-10 small text-danger mb-2"></div>
                    <div id="mdlExceptionWrap" class="d-none">
                        <div class="small fw-semibold text-muted mb-1">Exception Detail</div>
                        <pre id="mdlException" class="border rounded p-2 bg-light small" style="max-height:120px;overflow:auto;font-size:.72rem"></pre>
                    </div>
                </div>

                <div id="mdlRemarkWrap" class="mb-3 d-none">
                    <div class="small fw-semibold text-muted mb-1"><i class="bi bi-chat-left-text me-1"></i>Remark</div>
                    <div id="mdlRemark" class="border rounded p-2 bg-light small"></div>
                </div>

                <ul class="nav nav-tabs" id="jsonTabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-toggle="tab" data-target="#tabReqData">Request Body</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabRetData">Response Body</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabReqQuery">Query String</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabReqHeaders">Req Headers</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabResHeaders">Res Headers</button></li>
                </ul>
                <div class="tab-content border border-top-0 rounded-bottom p-0">
                    <div class="tab-pane fade show active" id="tabReqData">
                        <pre id="mdlRequestData"    class="m-0 p-3 bg-light rounded-bottom small" style="max-height:240px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabRetData">
                        <pre id="mdlReturnData"     class="m-0 p-3 bg-light rounded-bottom small" style="max-height:240px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabReqQuery">
                        <pre id="mdlRequestQuery"   class="m-0 p-3 bg-light rounded-bottom small" style="max-height:240px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabReqHeaders">
                        <pre id="mdlRequestHeaders" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:240px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabResHeaders">
                        <pre id="mdlResponseHeaders" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:240px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn--gray" data-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <style>
    body.modal-open { overflow: hidden !important; padding-right: 0 !important; }
    #modalLogDetail .modal-body { overflow-y: auto; scrollbar-width: none; }
    #modalLogDetail .modal-body::-webkit-scrollbar { display: none; }
    </style>
    <script>
    var __logData = @Html.Raw(logDataJson);
    $(document).ready(function () {

        // ---- Date Pickers ----
        if ($.fn.datetimepicker) {
            $('#date_timepicker_start').datetimepicker({ timepicker: false, format: 'd/m/Y',
                onSelectDate: function (dp, $i) {
                    var d = $i.val();
                    $('#date_timepicker_end').datetimepicker('setOptions', { minDate: d });
                }
            });
            $('#date_timepicker_end').datetimepicker({ timepicker: false, format: 'd/m/Y',
                onSelectDate: function (dp, $i) {
                    var d = $i.val();
                    $('#date_timepicker_start').datetimepicker('setOptions', { maxDate: d });
                }
            });
        }

        $('[data-toggle="tooltip"]').tooltip({ trigger: 'hover', placement: 'top' });

        var methodClass = { GET: 'bg-primary', POST: 'bg-success', PUT: 'bg-warning text-dark', PATCH: 'bg-info text-dark', DELETE: 'bg-danger' };
        function statusClass(code) {
            code = parseInt(code);
            if (isNaN(code)) return 'bg-secondary';
            if (code >= 200 && code < 300) return 'bg-success';
            if (code >= 300 && code < 400) return 'bg-info text-dark';
            if (code >= 400 && code < 500) return 'bg-warning text-dark';
            return 'bg-danger';
        }

        function prettyJson(str) {
            if (!str || str.trim() === '' || str.trim() === 'null') return '(ไม่มีข้อมูล)';
            try   { return JSON.stringify(JSON.parse(str), null, 2); }
            catch { return str; }
        }

        // ---- Detail Modal ----
        $(document).on('click', '.btn-log-detail', function () {
            var d = __logData[$(this).data('log-id')];
            if (!d) return;

            $('#mdlLogId').text(d.id);
            $('#mdlService').text(d.service_name   || '-');
            $('#mdlModule').text(d.module_name      || '-');
            $('#mdlEnv').text(d.environment_name    || '-');
            $('#mdlCreatedAt').text(d.created_at    || '-');
            $('#mdlDuration').text(d.duration >= 0
                ? (d.duration >= 1000 ? (d.duration / 1000).toFixed(1) + ' วินาที' : d.duration + ' ms')
                : '-');
            $('#mdlMethod').text(d.http_method      || '-');
            $('#mdlEndpoint').text(d.endpoint_url   || '-');
            $('#mdlMemberId').text(d.member_id      || '-');
            $('#mdlCreatedBy').text(d.created_by    || '-');
            $('#mdlClientIp').text(d.client_ip      || '-');
            $('#mdlUserAgent').text(d.user_agent    || '-');
            $('#mdlTraceId').text(d.trace_id        || '-');
            $('#mdlCorrelationId').text(d.correlation_id || '-');

            // Status Code badge
            var $bs = $('#mdlBadgeStatus').removeClass().addClass('badge');
            if (d.response_status_code) {
                $bs.addClass(statusClass(d.response_status_code)).text(d.response_status_code);
            } else {
                $bs.text('');
            }

            // Method badge
            var $bm = $('#mdlBadgeMethod').removeClass().addClass('badge');
            $bm.addClass(methodClass[d.http_method] || 'bg-secondary').text(d.http_method || '');

            // Success badge
            var $bsuc = $('#mdlBadgeSuccess').removeClass().addClass('badge');
            if (d.is_success) {
                $bsuc.addClass('bg-success').html('<i class="bi bi-check-lg me-1"></i>Success');
            } else {
                $bsuc.addClass('bg-danger').html('<i class="bi bi-x-lg me-1"></i>Failed');
            }

            // Status code inline
            var $sc = $('#mdlStatusCode').empty();
            if (d.response_status_code) {
                $sc.html('<span class="badge ' + statusClass(d.response_status_code) + '">' + d.response_status_code + '</span>');
            } else {
                $sc.text('-');
            }

            // Error
            var $errWrap = $('#mdlErrorWrap');
            var err = (d.error_message || '').trim();
            $errWrap.toggleClass('d-none', err === '' && (d.exception_detail || '').trim() === '');
            $('#mdlError').text(err || '-');
            var $excWrap = $('#mdlExceptionWrap');
            var exc = (d.exception_detail || '').trim();
            $excWrap.toggleClass('d-none', exc === '');
            $('#mdlException').text(exc);

            // Remark
            var remark = (d.remark || '').trim();
            $('#mdlRemarkWrap').toggleClass('d-none', remark === '');
            $('#mdlRemark').text(remark);

            // JSON tabs
            $('#mdlRequestData').text(prettyJson(d.request_data));
            $('#mdlReturnData').text(prettyJson(d.return_data));
            $('#mdlRequestQuery').text(prettyJson(d.request_query));
            $('#mdlRequestHeaders').text(prettyJson(d.request_headers));
            $('#mdlResponseHeaders').text(prettyJson(d.response_headers));

            // Reset to first tab
            $('#jsonTabs .nav-link').removeClass('active');
            $('#jsonTabs .nav-link:first').addClass('active');
            $('.tab-pane').removeClass('show active');
            $('#tabReqData').addClass('show active');

            $('#modalLogDetail').modal('show');
        });

        $(document).on('click', '[data-dismiss="modal"]', function () {
            $(this).closest('.modal').modal('hide');
        });

        $('#btnCopyIp').on('click', function () {
            var ip = $('#mdlClientIp').text().trim();
            if (ip && ip !== '-' && navigator.clipboard) {
                navigator.clipboard.writeText(ip).then(function () {
                    $('#btnCopyIp i').removeClass('bi-clipboard').addClass('bi-clipboard-check');
                    setTimeout(function () {
                        $('#btnCopyIp i').removeClass('bi-clipboard-check').addClass('bi-clipboard');
                    }, 1500);
                });
            }
        });

        // ---- Tab switching ----
        $(document).on('click', '#jsonTabs .nav-link', function () {
            var target = $(this).data('target');
            $('#jsonTabs .nav-link').removeClass('active');
            $(this).addClass('active');
            $('.tab-pane').removeClass('show active');
            $(target).addClass('show active');
        });

    });
    </script>
}
