@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">    
        @Html.AntiForgeryToken()
         
        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "title",  (row["title"].ToString() ?? "").Trim()))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_title",  (row["en_title"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row"> 
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span class='fi fi-th'></span> <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "t1", (row["t1"].ToString() ?? "").Trim()))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ <span class='fi fi-us'></span> <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "en_t1", (row["en_t1"].ToString() ?? "").Trim()))
            </div>
        </div>

        @{
            var provinceDT = ViewBag.provinces as System.Data.DataTable;
            var provinceFields = new[] { "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "t10", "t11" };
        }
        @foreach (var field in provinceFields)
        {
            string currentVal = (row[field]?.ToString() ?? "").Trim();
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    <div class="field">
                        <label for="id_@field" class="form-label">จังหวัด</label>
                        <select class="form-select" id="id_@field" name="@field">
                            <option value="">-- เลือกจังหวัด --</option>
                            @if (provinceDT != null)
                            {
                                foreach (System.Data.DataRow p in provinceDT.Rows)
                                {
                                    string sel = (currentVal == p["id"].ToString()) ? "selected" : "";
                                    <option value="@p["id"]" @Html.Raw(sel)>@p["name"]</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        }



        @{
            string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
            string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
        }
        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@issue_date" />
        <input type="hidden" name="expiry_date" value="@expiry_date" />

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")
@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }
    
    $(document).ready(function() {

        checkLockedRow(modConfig, jsonRow);

    });
</script>
}