@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
}

@section NavbarBack {
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        <input type="hidden" name="title" value="@row["title"]" />
        <input type="hidden" name="en_title" value="@row["en_title"]" />

 
        <div class="row">
            <div class="field">
                <label class="form-label">เลือก API Service</label>

                <div class="d-flex gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="t1" id="t1_1" value="1">
                        <label class="form-check-label" for="t1_1">
                            OpenGPT
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="t1" id="t1_2" value="2">
                        <label class="form-check-label" for="t1_2">
                            Gemini
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="t1" id="t1_3" value="3">
                        <label class="form-check-label" for="t1_3">
                            Claude
                        </label>
                    </div>
                </div>

            </div>
        </div>

        <br />

        <div class="row">
            @Html.Raw(_admin.InputPassword("ApiKey ", "t2", (row["t2"].ToString() ?? "").Trim()))
        </div>

        <br />

        <div class="row">
            <div class="field">
                <label class="form-label">เปิด-ปิด AI Search</label>

                <div class="d-flex gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="t3" id="t3_1" value="1">
                        <label class="form-check-label" for="t3_1">
                            เปิด
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="t3" id="t3_0" value="0">
                        <label class="form-check-label" for="t3_0">
                            ปิด
                        </label>
                    </div>
                </div>

            </div>
        </div>


            @{
                if(row["t1"].ToString() == "1")
                {
                    <text>
                    <script>
                    document.getElementById('t1_1').checked = true;
                    </script>
                    </text>
                }
                else if(row["t1"].ToString() == "2")
                {
                    <text>
                    <script>
                    document.getElementById('t1_2').checked = true;
                    </script>
                    </text>
                }
                else if(row["t1"].ToString() == "3")
                {
                    <text>
                    <script>
                    document.getElementById('t1_3').checked = true;
                    </script>
                    </text>
                }

                if(row["t3"].ToString() == "0")
                {
                    <text>
                    <script>
                    document.getElementById('t3_0').checked = true;
                    </script>
                    </text>
                }
                else
                {
                    <text>
                    <script>
                    document.getElementById('t3_1').checked = true;
                    </script>
                    </text>
                }
            }
         

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")
@await Component.InvokeAsync("AddForm")

@section Scripts {
    <link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
    <script>
        var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
        var jsonRow = @Html.Raw(jsonRow)
        function sConfirmCustom(form) {

            // Validate required fields
            var titleField = $('[name="title"]');
            if (titleField.length > 0 && titleField.val().trim() === '') {
                Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
                titleField.focus();
                return false;
            }
            var enTitleField = $('[name="en_title"]');
            if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
                Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
                enTitleField.focus();
                return false;
            }
            Swal.fire({
                title: 'ยืนยัน ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#00295A',
                cancelButtonColor: '#BC1320',
                confirmButtonText: 'ใช่',
                cancelButtonText: 'ปิด',
                showClass: {
                    popup: 'animate__animated animate__bounceIn'
                },
                hideClass: {
                    popup: 'animate__animated animate__bounceOut'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                } else {
                    return false;
                }
            });
            return false;
        }

        $(document).ready(function() {

            checkLockedRow(modConfig, jsonRow);

        });
    </script>
}