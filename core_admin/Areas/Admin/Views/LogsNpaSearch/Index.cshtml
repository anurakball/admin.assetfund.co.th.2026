@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

@{
    var _q = HttpContextAccessor.HttpContext!.Request.Query;
    string Q(string key) => _q.ContainsKey(key) ? (_q[key].ToString() ?? "").Trim() : "";

    var qKw        = Q("q_kw");
    var qHasKw     = Q("q_haskw");
    var qMode      = Q("q_mode");
    var qLang      = Q("q_lang");
    var qResult    = Q("q_result");
    var qFKey      = Q("q_fkey");
    var qIp        = Q("q_ip");
    var qDateStart = Q("q_date_start");
    var qDateEnd   = Q("q_date_end");

    int curPage = int.TryParse(Q("page"),    out var _cp) && _cp > 0 ? _cp : 1;
    int perPage = int.TryParse(Q("perpage"), out var _pp) && _pp >= 5 ? _pp : 20;
    int offset  = (curPage - 1) * perPage;

    //----- เงื่อนไขค้นหา สร้างจากตัวช่วยกลาง (ใช้ชุดเดียวกับ ExportExcel เพื่อให้ผลลัพธ์ตรงกันเสมอ)
    var prms = new Dictionary<string, object>();
    var w = NpaSearchLogHelper.BuildWhere(Q, prms);

    var dtCount = _db.ExecuteQuery($"SELECT COUNT(*) AS cnt FROM api_npa_search_log l {w}", prms);
    long totalRows  = dtCount.Rows.Count > 0 ? Convert.ToInt64(dtCount.Rows[0]["cnt"]) : 0;
    int  totalPages = (int)Math.Ceiling((double)totalRows / perPage);

    var dtLogs = _db.ExecuteQuery($@"
        SELECT l.id, l.created_at, l.keyword, l.search_mode, l.lang,
               l.filters, l.sort, l.page, l.result_count,
               l.query_string, l.client_ip, l.user_agent, l.referer
        FROM api_npa_search_log l
        {w}
        ORDER BY l.created_at DESC
        LIMIT {perPage} OFFSET {offset}", prms);

    //----- สรุปตัวเลขของ "ชุดผลลัพธ์ที่กำลังกรองอยู่"
    var dtStats = _db.ExecuteQuery($@"
        SELECT
            COUNT(DISTINCT btrim(l.keyword)) FILTER (WHERE l.keyword IS NOT NULL AND btrim(l.keyword) <> '') AS cnt_distinct_kw,
            COUNT(*) FILTER (WHERE COALESCE(l.result_count, 0) = 0)                                          AS cnt_zero,
            COUNT(*) FILTER (WHERE l.keyword IS NULL OR btrim(l.keyword) = '')                                AS cnt_nokw,
            COUNT(*) FILTER (WHERE l.created_at >= NOW() - INTERVAL '24 hours')                               AS cnt_today
        FROM api_npa_search_log l {w}", prms);

    long cntDistinctKw = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_distinct_kw"]) : 0;
    long cntZero       = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_zero"])        : 0;
    long cntNoKw       = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_nokw"])        : 0;
    long cntToday      = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_today"])       : 0;

    //----- คำค้นหายอดนิยม / คำค้นหาที่ไม่พบผลลัพธ์ (ตามเงื่อนไขค้นหาปัจจุบัน)
    var dtTopKw = _db.ExecuteQuery($@"
        SELECT btrim(l.keyword) AS kw, COUNT(*) AS cnt,
               COALESCE(AVG(l.result_count), 0)::BIGINT AS avg_result,
               MAX(l.created_at) AS last_at
        FROM api_npa_search_log l
        {w} AND l.keyword IS NOT NULL AND btrim(l.keyword) <> ''
        GROUP BY btrim(l.keyword)
        ORDER BY cnt DESC, last_at DESC
        LIMIT 10", prms);

    var dtZeroKw = _db.ExecuteQuery($@"
        SELECT btrim(l.keyword) AS kw, COUNT(*) AS cnt, MAX(l.created_at) AS last_at
        FROM api_npa_search_log l
        {w} AND l.keyword IS NOT NULL AND btrim(l.keyword) <> ''
          AND COALESCE(l.result_count, 0) = 0
        GROUP BY btrim(l.keyword)
        ORDER BY cnt DESC, last_at DESC
        LIMIT 10", prms);

    //----- ตัวเลือกใน dropdown อ่านจากข้อมูลจริง (ไม่ผูกกับเงื่อนไขค้นหา จะได้ไม่หายไปหลังกรอง)
    var dtModes = _db.ExecuteQuery("SELECT DISTINCT search_mode FROM api_npa_search_log WHERE search_mode IS NOT NULL AND search_mode <> '' ORDER BY search_mode");
    var dtLangs = _db.ExecuteQuery("SELECT DISTINCT lang FROM api_npa_search_log WHERE lang IS NOT NULL AND lang <> '' ORDER BY lang");

    //----- query string สำหรับลิงก์แบ่งหน้า / ปุ่ม Export
    var qsParts = new List<string>();
    foreach (var k in NpaSearchLogHelper.QueryKeys)
    {
        var v = Q(k);
        if (!string.IsNullOrEmpty(v)) qsParts.Add(k + "=" + Uri.EscapeDataString(v));
    }
    var exportQs = string.Join("&", qsParts);
    qsParts.Add("perpage=" + perPage);
    var baseQs = string.Join("&", qsParts);

    //----- ลิงก์ "เจาะดูคำค้นหานี้" ในตารางอันดับ — คงเงื่อนไขอื่นที่กรองอยู่ไว้ เปลี่ยนเฉพาะคำค้นหา
    Func<string, string, string> kwLink = (kw, extra) =>
    {
        var parts = new List<string>();
        foreach (var k in NpaSearchLogHelper.QueryKeys)
        {
            if (k == "q_kw" || (extra == "q_result=notfound" && k == "q_result")) continue;
            var v = Q(k);
            if (!string.IsNullOrEmpty(v)) parts.Add(k + "=" + Uri.EscapeDataString(v));
        }
        parts.Insert(0, "q_kw=" + Uri.EscapeDataString(kw));
        if (!string.IsNullOrEmpty(extra)) parts.Add(extra);
        parts.Add("perpage=" + perPage);
        return "?" + string.Join("&", parts);
    };

    //----- คำค้นหาที่มีอักขระแท็ก HTML ส่งกลับเป็น query string ไม่ได้ (ตัวกรอง [XssValidate] จะตอบ "Request denied")
    //      จึงแสดงเป็นข้อความเฉย ๆ ไม่ทำเป็นลิงก์ กันผู้ใช้กดแล้วเจอหน้าปฏิเสธ
    Func<string, bool> kwLinkable = (kw) => !kw.Contains('<') && !kw.Contains('>');

    int rowNum = offset + 1;

    //----- ไฮไลต์คำที่ค้นหาในคอลัมน์คำค้นหา (encode ก่อนเสมอ แล้วค่อยแทรก <mark>)
    Func<string, string> highlight = (text) =>
    {
        var enc = System.Net.WebUtility.HtmlEncode(text ?? "");
        if (string.IsNullOrEmpty(qKw)) return enc;
        var encTerm = System.Net.WebUtility.HtmlEncode(qKw);
        return System.Text.RegularExpressions.Regex.Replace(
            enc,
            System.Text.RegularExpressions.Regex.Escape(encTerm),
            m => "<mark class=\"p-0\">" + m.Value + "</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    };

    //----- ข้อมูลของ modal รายละเอียด
    var logDataMap = new Dictionary<string, object>();
    foreach (DataRow lr in dtLogs.Rows)
    {
        var _at  = lr["created_at"]   != DBNull.Value ? Convert.ToDateTime(lr["created_at"]) : DateTime.MinValue;
        var _cnt = lr["result_count"] != DBNull.Value ? Convert.ToInt64(lr["result_count"]) : -1;
        var _pg  = lr["page"]         != DBNull.Value ? Convert.ToInt32(lr["page"]) : 0;
        logDataMap[lr["id"].ToString()] = new
        {
            id           = lr["id"]?.ToString(),
            created_at   = _at != DateTime.MinValue ? _at.ToString("dd/MM/yyyy HH:mm:ss") : "",
            keyword      = lr["keyword"]?.ToString() ?? "",
            search_mode  = lr["search_mode"]?.ToString() ?? "",
            lang         = lr["lang"]?.ToString() ?? "",
            filters      = lr["filters"]?.ToString() ?? "",
            filters_text = NpaSearchLogHelper.Summary(lr["filters"]?.ToString()),
            sort         = lr["sort"]?.ToString() ?? "",
            page         = _pg,
            result_count = _cnt,
            query_string = lr["query_string"]?.ToString() ?? "",
            client_ip    = lr["client_ip"]?.ToString() ?? "",
            user_agent   = lr["user_agent"]?.ToString() ?? "",
            referer      = lr["referer"]?.ToString() ?? ""
        };
    }
    //----- EscapeHtml: คำค้นหาเป็นข้อความที่ผู้ใช้พิมพ์เข้ามาเอง อาจมี "</script>" หรือแท็ก HTML ปนมา
    //      ถ้า serialize ตรง ๆ จะไปปิด <script> ของหน้านี้กลางคัน (สคริปต์พังทั้งหน้า + เป็นช่องโหว่ XSS)
    var logDataJson = Newtonsoft.Json.JsonConvert.SerializeObject(logDataMap,
        new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml });
}

@* ===================== SEARCH FORM ===================== *@
<div class="form-wrapper mb-4">
    <form method="get" id="formSearch" class="form" autocomplete="off">
        <div class="row">
            <div class="col-lg-6 col-md-12 mb-3">
                <div class="field">
                    <label class="form-label fw-semibold"><i class="bi bi-search me-1"></i>ข้อความค้นหา (คำที่ผู้ใช้พิมพ์)</label>
                    <input type="text" name="q_kw" id="q_kw" value="@qKw" class="form-control form-control-lg"
                           placeholder="พิมพ์คำ/บางส่วนของคำที่ต้องการค้นหา เช่น ทาวเวอร์" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">มีข้อความค้นหาหรือไม่</label>
                    <select name="q_haskw" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        <option value="1" @(qHasKw == "1" ? "selected" : "")>เฉพาะที่มีข้อความค้นหา</option>
                        <option value="0" @(qHasKw == "0" ? "selected" : "")>เฉพาะที่ไม่ระบุข้อความ (กรองอย่างเดียว)</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">ผลลัพธ์ที่ได้</label>
                    <select name="q_result" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        <option value="found"    @(qResult == "found"    ? "selected" : "")>พบผลลัพธ์</option>
                        <option value="notfound" @(qResult == "notfound" ? "selected" : "")>ไม่พบผลลัพธ์ (0 รายการ)</option>
                    </select>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">ประเภทการค้นหา</label>
                    <select name="q_mode" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtModes.Rows) {
                            var m = r["search_mode"].ToString();
                            <option value="@m" @(qMode == m ? "selected" : "")>@m</option>
                        }
                        <option value="__none__" @(qMode == "__none__" ? "selected" : "")>(ไม่ระบุ)</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">ภาษา</label>
                    <select name="q_lang" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtLangs.Rows) {
                            var lg = r["lang"].ToString();
                            <option value="@lg" @(qLang == lg ? "selected" : "")>@(lg == "th" ? "ไทย (th)" : lg == "en" ? "อังกฤษ (en)" : lg)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">ตัวกรองที่ใช้</label>
                    <select name="q_fkey" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        <option value="__any__"  @(qFKey == "__any__"  ? "selected" : "")>มีการใช้ตัวกรอง</option>
                        <option value="__none__" @(qFKey == "__none__" ? "selected" : "")>ไม่ใช้ตัวกรองเลย</option>
                        @foreach (var f in NpaSearchLogHelper.FilterKeys) {
                            <option value="@f.Key" @(qFKey == f.Key ? "selected" : "")>ใช้ตัวกรอง: @f.Value</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Client IP</label>
                    <input type="text" name="q_ip" value="@qIp" class="form-control" placeholder="192.168.x.x" />
                </div>
            </div>
            <div class="col-lg-2 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">แสดงหน้าละ</label>
                    <select name="perpage" class="form-select">
                        @foreach (var n in new[] { 10, 20, 50, 100 }) {
                            <option value="@n" @(perPage == n ? "selected" : "")>@n รายการ</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-12 mb-3">
                <div class="field">
                    <label class="form-label">ช่วงวันที่</label>
                    <div class="input-group input-daterange">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                        <input type="text" id="date_timepicker_start" name="q_date_start" value="@qDateStart" class="form-control" placeholder="วันเริ่มต้น" readonly />
                        <span class="input-group-text">ถึง</span>
                        <input type="text" id="date_timepicker_end" name="q_date_end" value="@qDateEnd" class="form-control" placeholder="วันสิ้นสุด" readonly />
                    </div>
                </div>
            </div>
        </div>
        <div class="btn-group mt-1">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon"><i class="bi bi-search"></i></span>
                <span class="btn-text">ค้นหา</span>
            </button>

            @* ปุ่มล้างค่าโผล่เมื่อมีเงื่อนไขค้นหาใด ๆ อยู่ (รวมกรณีมากันจากลิงก์ในตารางอันดับคำค้นหา) *@
            @if (NpaSearchLogHelper.QueryKeys.Any(k => !string.IsNullOrEmpty(Q(k))) || !string.IsNullOrEmpty(Q("perpage")))
            {
                <a href="?page=1" class="btn btn--gray">
                    <span class="btn-icon"><i class="bi bi-x-circle"></i></span>
                    <span class="btn-text">ล้างค่า</span>
                </a>
            }
        </div>
    </form>
</div>

@* ===================== SUMMARY CARDS ===================== *@
