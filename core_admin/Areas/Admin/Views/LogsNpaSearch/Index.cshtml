    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-success">@cntDistinctKw.ToString("N0")</div>
                <div class="small text-muted">คำค้นหาไม่ซ้ำ</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-danger">@cntZero.ToString("N0")</div>
                <div class="small text-muted">ค้นแล้วไม่พบผลลัพธ์</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
