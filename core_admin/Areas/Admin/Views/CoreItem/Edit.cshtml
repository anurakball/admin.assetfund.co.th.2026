            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("รูปภาพ PC <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 1920 x 1080)</span>", "en_img1", (row["en_img1"].ToString() ?? "").Trim()))
