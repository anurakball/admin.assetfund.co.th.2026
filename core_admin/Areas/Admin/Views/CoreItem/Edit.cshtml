            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ชื่อ Link URL (ถ้ามี)  <span class='fi fi-th'></span>", "title_url", (row["title_url"].ToString() ?? "").Trim()))
                </div>
