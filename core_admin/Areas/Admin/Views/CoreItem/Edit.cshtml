            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputTextArea("รายละเอียดย่อ <span class='fi fi-us'></span>", "en_des", (row["en_des"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row">
