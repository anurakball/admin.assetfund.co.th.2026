@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";

    Func<string, string> V = col => (row.Table.Columns.Contains(col) ? (row[col]?.ToString() ?? "") : "").Trim();
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#0047B6; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
    .cms-note { background:#fff8e1; border:1px solid #ffe0a3; border-radius:8px; padding:10px 14px; margin-bottom:18px; font-size:.92rem; }
</style>

<div class="form-wrapper">

    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        <fieldset class="cms-section">
            <legend>รูปและป้ายสถานะ</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("รูปทรัพย์ <span style='font-weight: normal;color: orange;'>(.webp, .png, .jpg, .jpeg)</span>", "img1", V("img1")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ข้อความแทนรูป (alt) <span class='fi fi-th'></span>", "title_url", V("title_url")))
                    @Html.Raw(_admin.InputText("ข้อความแทนรูป (alt) <span class='fi fi-us'></span>", "en_title_url", V("en_title_url")))
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    <div class="field">
                        <label for="id_des_color" class="form-label">ป้ายสถานะ</label>
                        <select class="form-select" id="id_des_color" name="des_color">
                            @{
                                var badges = new List<KeyValuePair<string,string>>()
                                {
                                    new("direct", "ซื้อตรง (สีเขียว)"),
                                    new("waiting", "รอประกาศราคา (สีเหลือง)"),
                                    new("", "ไม่แสดงป้าย")
                                };
                                foreach (var b in badges)
                                {
                                    <option value="@b.Key" selected="@(V("des_color") == b.Key)">@b.Value</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @* หมายเหตุ: ใช้คอลัมน์ en_img1 / en_img1_icon เก็บข้อความป้าย เพราะ title_color เป็น varchar(10) สั้นเกินไป *@
                    @Html.Raw(_admin.InputText("ข้อความบนป้าย <span class='fi fi-th'></span>", "en_img1", V("en_img1")))
                    @Html.Raw(_admin.InputText("ข้อความบนป้าย <span class='fi fi-us'></span>", "en_img1_icon", V("en_img1_icon")))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>รายละเอียดทรัพย์</legend>
            <div class="row">
                <div class="col-lg-8 col-md-10 mb-3">
                    @Html.Raw(_admin.InputBootstrapIcon("ไอคอนประเภททรัพย์ <span style='font-weight:normal;color:orange;'>(เลือกจาก Bootstrap Icons)</span>", "img1_icon", V("img1_icon")))
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ประเภททรัพย์ <span class='fi fi-th'></span>", "title", V("title")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ประเภททรัพย์ <span class='fi fi-us'></span>", "en_title", V("en_title")))
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ทำเล / ที่ตั้ง <span class='fi fi-th'></span>", "des", V("des")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ทำเล / ที่ตั้ง <span class='fi fi-us'></span>", "en_des", V("en_des")))
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ราคา <span class='fi fi-th'></span> <span style='font-weight:normal;color:orange;'>(เช่น 12,500,000 บาท หรือ ติดต่อเจ้าหน้าที่)</span>", "date_news", V("date_news")))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ลิงก์</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextLinkCMSPage("URL รายละเอียดทรัพย์ <span class='fi fi-th'></span>", "url", V("url")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextLinkCMSPage("URL รายละเอียดทรัพย์ <span class='fi fi-us'></span>", "en_url", V("en_url")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputUrlTarget("URL Target", "url_target", V("url_target")))
                </div>
            </div>
        </fieldset>

        @{
            string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
            string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
        }
        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@issue_date" />
        <input type="hidden" name="expiry_date" value="@expiry_date" />

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")
@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form)
    {
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอกประเภททรัพย์ (ไทย) ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?', icon: 'warning', showCancelButton: true,
            confirmButtonColor: '#0047B6', cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่', cancelButtonText: 'ปิด',
            showClass: { popup: 'animate__animated animate__bounceIn' },
            hideClass: { popup: 'animate__animated animate__bounceOut' }
        }).then((result) => { if (result.isConfirmed) { form.submit(); } else { return false; } });
        return false;
    }
    $(document).ready(function() { checkLockedRow(modConfig, jsonRow); });
</script>
}
