@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#0047B6; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        <fieldset class="cms-section">
            <legend>การ์ดบทบาท</legend>

            <div class="row">
                <div class="col-lg-8 col-md-10 mb-3">
                    @Html.Raw(_admin.InputBootstrapIcon("ไอคอน <span style='font-weight:normal;color:orange;'>(เลือกจาก Bootstrap Icons)</span>", "img1_icon", ""))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("หัวข้อ <span class='fi fi-th'></span> <span style='font-weight: normal;color: orange;'>(ขึ้นบรรทัดใหม่ได้)</span>", "title", ""))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("หัวข้อ <span class='fi fi-us'></span> <span style='font-weight: normal;color: orange;'>(ขึ้นบรรทัดใหม่ได้)</span>", "en_title", ""))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความ <span class='fi fi-th'></span>", "des", ""))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความ <span class='fi fi-us'></span>", "en_des", ""))
                </div>
            </div>
        </fieldset>

        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@System.DateTime.Now.ToString("dd/MM/yyyy HH:mm")" />
        <input type="hidden" name="expiry_date" value="@System.DateTime.Now.AddYears(10).ToString("dd/MM/yyyy HH:mm")" />

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    function sConfirmCustom(form)
    {
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0047B6',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: { popup: 'animate__animated animate__bounceIn' },
            hideClass: { popup: 'animate__animated animate__bounceOut' }
        }).then((result) => {
            if (result.isConfirmed) { form.submit(); } else { return false; }
        });
        return false;
    }
</script>
}
