@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<style>
    .cms-section { border: 1px solid #d9d9d9; padding: 14px 22px 22px; border-radius: 12px; margin-bottom: 28px; background: #fff; }
    .cms-section > legend { width: auto; padding: 0 8px; margin-left: -12px; margin-bottom: 18px; font-size: 1.15rem; font-weight: 700; color: #0047B6; }
    .cms-hint { font-weight: normal; color: orange; font-size: .8rem; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        @* ----- ชื่อรายการ (สำหรับแสดงในระบบจัดการ) ----- *@
        <fieldset class="cms-section">
            <legend>ชื่อรายการ</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ชื่อรายการ <span class='fi fi-th'></span>", "title", (row["title"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ชื่อรายการ <span class='fi fi-us'></span>", "en_title", (row["en_title"].ToString() ?? "").Trim()))
                </div>
            </div>
        </fieldset>

        @* ===== ส่วนที่ 1 — แบนเนอร์ด้านบน (พื้นหลังเขียว) ===== *@
        <fieldset class="cms-section">
            <legend>ส่วนที่ 1 : แบนเนอร์ด้านบน</legend>

            <div class="row">
                <div class="col-lg-12 mb-3">
                    @Html.Raw(_admin.InputFileManeger("รูปพื้นหลังแบนเนอร์ <span class='cms-hint'>(.webp, .svg, .png, .jpg, .jpeg, .gif &nbsp;ขนาดแนะนำ 1920 x 1080)</span>", "t1", (row["t1"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อแบนเนอร์ <span class='fi fi-th'></span>", "t2", (row["t2"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อแบนเนอร์ <span class='fi fi-us'></span>", "en_t2", (row["en_t2"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความอธิบายใต้หัวข้อ <span class='fi fi-th'></span>", "t3", (row["t3"].ToString() ?? "").Trim(), 4))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความอธิบายใต้หัวข้อ <span class='fi fi-us'></span>", "en_t3", (row["en_t3"].ToString() ?? "").Trim(), 4))
                </div>
            </div>
        </fieldset>

        @* ===== ส่วนที่ 2 — เนื้อหา "วิธีการ" ===== *@
        <fieldset class="cms-section">
            <legend>ส่วนที่ 2 : เนื้อหาวิธีการ</legend>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "t4", (row["t4"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_t4", (row["en_t4"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความขั้นตอนที่ 1 <span class='fi fi-th'></span>", "t5", (row["t5"].ToString() ?? "").Trim(), 3))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความขั้นตอนที่ 1 <span class='fi fi-us'></span>", "en_t5", (row["en_t5"].ToString() ?? "").Trim(), 3))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12 mb-3">
                    @Html.Raw(_admin.InputFileManeger("รูปภาพโลโก้ (สำหรับให้ผู้แลกลิงค์คัดลอก) <span class='cms-hint'>(.webp, .svg, .png, .jpg, .jpeg, .gif)</span>", "t6", (row["t6"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความขั้นตอนที่ 2 <span class='fi fi-th'></span>", "t7", (row["t7"].ToString() ?? "").Trim(), 3))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความขั้นตอนที่ 2 <span class='fi fi-us'></span>", "en_t7", (row["en_t7"].ToString() ?? "").Trim(), 3))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ข้อความบนปุ่ม <span class='fi fi-th'></span>", "t8", (row["t8"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ข้อความบนปุ่ม <span class='fi fi-us'></span>", "en_t8", (row["en_t8"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความเงื่อนไขการรับแลกลิงค์ <span class='fi fi-th'></span>", "t9", (row["t9"].ToString() ?? "").Trim(), 4))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("ข้อความเงื่อนไขการรับแลกลิงค์ <span class='fi fi-us'></span>", "en_t9", (row["en_t9"].ToString() ?? "").Trim(), 4))
                </div>
            </div>
        </fieldset>

        @{
            string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
            string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
        }
        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@issue_date" />
        <input type="hidden" name="expiry_date" value="@expiry_date" />

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")
@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก ชื่อรายการ (ไทย) ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก ชื่อรายการ (อังกฤษ) ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0047B6',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }

    $(document).ready(function() {
        checkLockedRow(modConfig, jsonRow);
    });
</script>
}
