    <script>
    $(document).ready(function () 
    {
        @{
            if(@ViewBag.CoreSystem != "")
            {
                <text>
                document.getElementById('setting_core_id').value = '@ViewBag.CoreSystem';
                show_this_type('@ViewBag.CoreSystem');
                document.getElementById('id_setting_core_cat_id_@ViewBag.CoreSystem').value = '@ViewBag.CatID'; 
                </text>
            }

            if (@ViewBag.Setting != "")
            {
                <text>
                var setting_data = "@ViewBag.Setting";
                if (setting_data.indexOf(',') > -1) 
                {
                    var arr_setting_data = setting_data.split(",");

                    for (var i = 0; i < arr_setting_data.length; i++) 
                    {
                        if (arr_setting_data[i] != "") 
                        {
                            if (arr_setting_data[i].indexOf(':') > -1) 
                            {
                                var arr_get_no_widget = arr_setting_data[i].split(":");

                                if (arr_get_no_widget[0] == "@ViewBag.id") 
                                {
                                    var this_setting = arr_get_no_widget[1].split("|"); 
                                    document.getElementById('setting_core_id').value = this_setting[0];
                                    show_this_type(this_setting[0]);
                                         
                                    document.getElementById('id_setting_core_cat_id_'+this_setting[0]).value = this_setting[1]; 
                                    document.getElementById('setting_sort_1').value = this_setting[2];
                                    document.getElementById('setting_sort_2').value = this_setting[3];
                                }
                            }
                        }
                    }
                }
                </text>
            }

            if (@ViewBag.Setting_sub != "")
            {
                <text>
                var setting_data = "@ViewBag.Setting_sub";
                if (setting_data.indexOf(',') > -1) 
                {
                    var arr_setting_data = setting_data.split(",");

                    for (var i = 0; i < arr_setting_data.length; i++) 
                    {
                        if (arr_setting_data[i] != "") 
                        {
                            if (arr_setting_data[i].indexOf(':') > -1) 
                            {
                                var arr_get_no_widget = arr_setting_data[i].split(":");

                                if (arr_get_no_widget[0] == "@ViewBag.id") 
                                {
                                    var this_setting = arr_get_no_widget[1].split("|"); 
                                    //document.getElementById('setting_core_id').value = this_setting[0];
                                    //show_this_type(this_setting[0]);

                                    document.getElementById('id_setting_core_cat_id_8_sub').value = this_setting[1];
                                    document.getElementById('setting_sort_1_sub').value = this_setting[2];
                                    document.getElementById('setting_sort_2_sub').value = this_setting[3];
                                }
                            }
                        }
                    }
                }
                </text>
            }
        }
             
        document.getElementById('setting_core_id').disabled = true;
             
        @{
            if (ViewBag.id.ToString() == "120")
            {
                    <text>
                    document.getElementById('id_setting_core_cat_id_9').value = "";
                    document.getElementById('id_setting_core_cat_id_9').disabled = true;
                </text>
            }
            else if (ViewBag.id.ToString() == "130")
            {
                <text>
                    document.getElementById('id_setting_core_cat_id_1').value = "";
                    document.getElementById('id_setting_core_cat_id_1').disabled = true;
                </text>
            }
        }
    });
    function hide_all_type() {
        for (let i = 1; i <= 1; i++) {
            document.getElementById('group_' + i).style.display = 'none';
        }
    }
    function show_this_type(var1) {
        hide_all_type();
        document.getElementById("group_" + var1).style.display = '';
        document.getElementById("sort_type").style.display = '';
    } 
    function goto_edit(var1,var2)
    {
        window.open('/Admin/' + var1 + '/Edit/' + var2);
    }
    </script> 
