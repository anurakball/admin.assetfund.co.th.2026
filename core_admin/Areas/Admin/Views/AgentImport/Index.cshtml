@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
    var searchInputVal = (Dictionary<string, string>)ViewBag.searchInputVal;

    var importSuccess = ViewBag.ImportSuccess as List<Dictionary<string, string>>;
    var importFailed  = ViewBag.ImportFailed  as List<Dictionary<string, string>>;
}
@section NavbarBack{
    @if (mod_config.IsCMSPage == true && mod_config.FieldCMSPage != "" && _session.GetInt32("admin_" + mod.Name + "_parent_lv").HasValue && _session.GetInt32("admin_" + mod.Name + "_parent_lv") > 1)
    {
        int parent_id = _admin.getParentID(mod, Convert.ToInt32(_session.GetString("admin_" + mod.Name + "_search_" + mod_config.FieldCMSPage)));
        @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}?{1}={2}", mod.Name, mod_config.FieldCMSPage, parent_id) })
    }
}
@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<div class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0"><i class="fa-solid fa-file-import me-2"></i>นำเข้าข้อมูลผู้สมัครตัวแทน</h5>
        <a href="/Admin/AgentImport/DownloadTemplate" class="btn btn-sm btn-outline-success">
            <i class="fa-solid fa-file-arrow-down me-1"></i>ดาวน์โหลด Template Excel
        </a>
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-3">
            <i class="fa-solid fa-circle-info me-2"></i>
            <strong>คำแนะนำ:</strong> ดาวน์โหลดไฟล์ Template Excel ก่อน แล้วกรอกข้อมูลลง<strong>ชีตแรก "Import Agent"</strong>
            ตามหัวคอลัมน์ (สีน้ำเงิน = ข้อมูลสมาชิก, สีเขียว = ข้อมูลตัวแทน) คอลัมน์ที่มี <strong>*</strong> จำเป็นต้องกรอก
            — ชีตที่สอง <strong>"ตัวอย่างข้อมูล"</strong> มีตัวอย่างกรอกครบ 5 รายการไว้ดูหรือคัดลอกไปวาง
            (ระบบอ่านเฉพาะชีตแรกเท่านั้น ข้อมูลในชีตตัวอย่างจะไม่ถูกนำเข้า)
            <hr class="my-2" />
            <span class="small">
                <strong>รูปแบบข้อมูลต้องตรงกับฟอร์มสมัครหน้าเว็บ:</strong>
                อีเมลต้องเป็นรูปแบบอีเมลที่ถูกต้อง ·
                มือถือเป็นตัวเลข 10 หลักขึ้นต้นด้วย 0 ·
                เลขบัตรประชาชน/เลขผู้เสียภาษีเป็นตัวเลข 13 หลัก ·
                โทรศัพท์บ้าน/ติดต่อเป็นตัวเลข 9-10 หลัก ·
                ที่อยู่ต้องกรอกเป็น<strong>รหัส Master Data</strong> (จังหวัด 2 หลัก / อำเภอ 4 หลัก / ตำบล 6 หลัก) ให้ครบทั้ง 3 ช่องและต้องเป็นรหัสที่สอดคล้องกัน
                <br />เครื่องหมายขีด/เว้นวรรคในเบอร์โทรและเลขบัตรระบบตัดให้อัตโนมัติ (<code>081-234-5678</code> = <code>0812345678</code>)
            </span>
        </div>
        <div class="alert alert-warning mb-3">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            <strong>เลขบัตรประชาชน/เลขผู้เสียภาษี</strong> ใช้เป็นตัวระบุรายการ —
            ถ้า<strong>มีอยู่แล้ว</strong>ในฐานข้อมูล ระบบจะ <strong>อัปเดตทับข้อมูลทั้งหมด</strong>ของตัวแทนรายนั้น
            (ช่องที่เว้นว่างในไฟล์จะถูกล้างค่าเดิมด้วย ยกเว้น <u>รหัสผ่าน</u> / <u>รหัสตัวแทน</u> / <u>สถานะการอนุมัติ</u> / <u>ไฟล์แนบ</u> ที่คงเดิมไว้)
            ถ้า<strong>ยังไม่มี</strong> จะเพิ่มเป็นรายการใหม่พร้อมสร้างรหัสผ่านเริ่มต้นให้
        </div>

        <form method="post" action="/Admin/AgentImport/Import" enctype="multipart/form-data" id="fm_import">
            @Html.AntiForgeryToken()
            <div class="row align-items-end g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">เลือกไฟล์ Excel (.xlsx, .xls)</label>
                    <input type="file" name="importFile" id="importFile" class="form-control" accept=".xlsx,.xls" required />
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary" id="btn_import">
                        <i class="fa-solid fa-upload me-1"></i>นำเข้าข้อมูล
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (importSuccess != null || importFailed != null)
{
    <div class="row g-4">
        @if (importSuccess != null && importSuccess.Count > 0)
        {
            <div class="col-12">
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <i class="fa-solid fa-circle-check me-2"></i>
                        นำเข้าสำเร็จ <span class="badge bg-white text-success ms-2">@importSuccess.Count รายการ</span>
                        <span class="badge bg-light text-dark ms-1">เพิ่มใหม่ @importSuccess.Count(x => x.GetValueOrDefault("action") != "update")</span>
                        <span class="badge bg-warning text-dark ms-1">อัปเดต @importSuccess.Count(x => x.GetValueOrDefault("action") == "update")</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover mb-0">
                                <thead class="table-success">
                                    <tr>
                                        <th class="text-center">แถว</th>
                                        <th class="text-center">การทำงาน</th>
                                        <th>รหัสตัวแทน</th>
                                        <th>ชื่อ-สกุล</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>เลขบัตร/ผู้เสียภาษี</th>
                                        <th>รหัสผ่านเริ่มต้น</th>
                                        <th class="text-center">Member ID</th>
                                        <th class="text-center">Agent ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in importSuccess)
                                    {
                                        var isUpd = item.GetValueOrDefault("action") == "update";
                                        var pwd = item.GetValueOrDefault("password");
                                        <tr>
                                            <td class="text-center">@item.GetValueOrDefault("row")</td>
                                            <td class="text-center">
                                                @if (isUpd)
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-pen-to-square me-1"></i>อัปเดต</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success"><i class="fa-solid fa-plus me-1"></i>เพิ่มใหม่</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-primary">@item.GetValueOrDefault("codeid")</span></td>
                                            <td>@item.GetValueOrDefault("name")</td>
                                            <td>@item.GetValueOrDefault("username")</td>
                                            <td>@item.GetValueOrDefault("email")</td>
                                            <td>@item.GetValueOrDefault("idcard")</td>
                                            <td>
                                                @if (string.IsNullOrEmpty(pwd))
                                                {
                                                    <span class="text-muted small">(ใช้รหัสผ่านเดิม)</span>
                                                }
                                                else
                                                {
                                                    <code>@pwd</code>
                                                }
                                            </td>
                                            <td class="text-center">@item.GetValueOrDefault("member_id")</td>
                                            <td class="text-center">@item.GetValueOrDefault("agent_id")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (importFailed != null && importFailed.Count > 0)
        {
            <div class="col-12">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                        ข้ามรายการ (ไม่สำเร็จ) <span class="badge bg-white text-danger ms-2">@importFailed.Count รายการ</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover mb-0">
                                <thead class="table-danger">
                                    <tr>
                                        <th class="text-center">แถว</th>
                                        <th>ชื่อ-สกุล</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>เลขบัตร/ผู้เสียภาษี</th>
                                        <th>เหตุผลที่ข้าม</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in importFailed)
                                    {
                                        <tr>
                                            <td class="text-center">@item.GetValueOrDefault("row")</td>
                                            <td>@item.GetValueOrDefault("name")</td>
                                            <td>@item.GetValueOrDefault("username")</td>
                                            <td>@item.GetValueOrDefault("email")</td>
                                            <td>@item.GetValueOrDefault("idcard")</td>
                                            <td><span class="badge bg-danger">@item.GetValueOrDefault("reason")</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
document.getElementById('fm_import').addEventListener('submit', function () {
    var btn = document.getElementById('btn_import');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>กำลังนำเข้า...';
});
</script>
