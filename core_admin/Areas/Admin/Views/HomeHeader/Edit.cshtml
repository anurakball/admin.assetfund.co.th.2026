@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";

    // รูปตัวอย่างเทมเพลต: microsite (web_id != 0) ใช้ชุด m-t1..m-t3, เว็บไซต์หลัก (web_id = 0) ใช้ t1..t3
    var tplPrefix = _admin.UseWidget2() ? "m-t" : "t";
    var thisType = (row["this_type"].ToString() ?? "").Trim();
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        
        @Html.AntiForgeryToken()

        <input type="hidden" name="title" value="โลโก้เว็บไซต์" />

        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputFileManeger("โลโก้เว็บไซต์ <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 132 x 60)</span>", "img1", (row["img1"].ToString() ?? "").Trim()))
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label class="form-label">เลือกเทมเพลต</label>

                <div class="row g-3 template-picker">
                    @for (var t = 1; t <= 3; t++)
                    {
                        var tplName = "Template " + t;
                        var tplThumb = string.Format("/images/template/{0}{1}-thumb.jpg", tplPrefix, t);
                        var tplFull = string.Format("/images/template/{0}{1}.jpg", tplPrefix, t);
                        var isChecked = thisType == t.ToString();

                        <div class="col-lg-4 col-md-6">
                            <div class="template-card @(isChecked ? "is-selected" : "")">
                                <div class="template-thumb" data-full="@tplFull" data-title="@tplName" title="คลิกเพื่อดูตัวอย่างเต็มจอ">
                                    <div class="template-thumb-scroll">
                                        <img src="@tplThumb" alt="@tplName" loading="lazy" />
                                    </div>
                                    <span class="template-zoom"><i class="fa-solid fa-magnifying-glass-plus"></i> คลิกเพื่อดูตัวอย่างเต็มจอ</span>
                                </div>
                                <div class="form-check template-check">
                                    <input class="form-check-input" type="radio" name="this_type" id="this_type_@t" value="@t"
                                           @(isChecked ? "checked" : "")>
                                    <label class="form-check-label" for="this_type_@t">
                                        @tplName
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

<br /><br />


        <div class="row">
            <div class="field">
                <label class="form-label">เลือกแถบสีหลักเว็บไซต์</label>

                <div class="d-flex gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="des" id="des_1" value="1"
                               @((row["des"].ToString() ?? "").Trim() == "1" ? "checked" : "")>
                        <label class="form-check-label" for="des_1">
                            สีสว่าง
                        </label>
                    </div> 
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="des" id="des_2" value="2"
                               @((row["des"].ToString() ?? "").Trim() == "2" ? "checked" : "")>
                        <label class="form-check-label" for="des_2">
                            สีมืด
                        </label>
                    </div> 
                </div>

            </div>
        </div>

<br /> 
        

        @{
            /*if ((row["this_type"].ToString() ?? "").Trim() == "1")
            {
                <script>
                    document.getElementById('this_type_1').checked = true;
                </script>
            }
            else
            {
                <script>
                    document.getElementById('this_type_2').checked = true;
                </script>
            }*/
        }

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })

    </form>
</div>

@* modal ดูตัวอย่างเทมเพลตเต็มจอ (วางนอก form เพื่อไม่ให้ปุ่มใน modal ไป submit form) *@
<div class="modal fade" id="templatePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="templatePreviewTitle">ตัวอย่างเทมเพลต</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body template-preview-body">
                <img id="templatePreviewImg" src="" alt="" />
            </div>
        </div>
    </div>
</div>

@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<style>
    .template-card {
        border: 2px solid #e3e6ec;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        height: 100%;
        transition: border-color .15s, box-shadow .15s;
    }
    .template-card.is-selected {
        border-color: #00295A;
        box-shadow: 0 0 0 3px rgba(0,71,182,.12);
    }
    .template-thumb {
        position: relative;
        height: 320px;
        cursor: zoom-in;
        background: #f2f4f7;
    }
    /* ภาพเป็นสกรีนช็อตหน้าเว็บทั้งหน้า (สูงมาก) จึงให้เลื่อนดูในการ์ดได้ */
    .template-thumb-scroll {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .template-thumb-scroll img {
        width: 100%;
        height: auto;
        display: block;
    }
    .template-zoom {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        padding: 6px 10px;
        font-size: 13px;
        color: #fff;
        background: rgba(0,0,0,.55);
        text-align: center;
        pointer-events: none;
        opacity: .85;
        transition: opacity .15s;
    }
    .template-thumb:hover .template-zoom { opacity: 1; }
    .template-check {
        padding: 10px 12px 10px 34px;
        border-top: 1px solid #eef0f4;
    }
    .template-check .form-check-label { cursor: pointer; font-weight: 500; }
    .template-preview-body {
        overflow: auto;
        background: #f2f4f7;
        text-align: center;
        padding: 0;
    }
    .template-preview-body img { max-width: 100%; height: auto; display: block; margin: 0 auto; }
</style>
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        if (
                    $('#img1').val() == ''
                ) {
                    sAlert("โลโก้ไม่ถูกต้อง", "กรุณาระบุ โลโก้เว็บไซต์", "warning");
            return false;
        }


        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }
    
    $(document).ready(function() {

        checkLockedRow(modConfig, jsonRow);

        // ไฮไลต์การ์ดเทมเพลตที่เลือกอยู่
        $(document).on('change', '.template-picker input[name="this_type"]', function () {
            $('.template-card').removeClass('is-selected');
            $(this).closest('.template-card').addClass('is-selected');
        });

        // คลิกรูป -> เปิด modal ดูตัวอย่างเต็มจอ
        $(document).on('click', '.template-thumb', function () {
            var $t = $(this);
            $('#templatePreviewTitle').text($t.data('title') || 'ตัวอย่างเทมเพลต');
            $('#templatePreviewImg').attr('src', $t.data('full')).attr('alt', $t.data('title') || '');
            $('#templatePreviewModal').modal('show');
        });

        // ปิด modal -> ล้าง src กันรูปใหญ่ค้างในหน่วยความจำ
        $('#templatePreviewModal').on('hidden.bs.modal', function () {
            $('#templatePreviewImg').attr('src', '');
        });

    });
</script>
}