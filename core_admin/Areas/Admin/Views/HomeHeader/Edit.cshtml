@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";

    // เมนู "ปรับแต่ง Header" ของ Asset Plus — เหลือแค่โลโก้ 2 ภาษา + Alt Text 2 ภาษา
    // (ฟอร์ม SAM เดิมมีเลือก Template / โทนสีด้วย ซึ่งเว็บใหม่ไม่ใช้ — this_type / des ไม่อยู่ใน FieldUpdate แล้ว)
    // ลิงก์ของโลโก้บน front-end fix เป็นหน้าแรกเสมอ จึงไม่มีช่อง URL ให้แก้
    string V(string col) => row.Table.Columns.Contains(col) ? (row[col].ToString() ?? "").Trim() : "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#00295A; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
    .cms-note { font-size:.9rem; color:#555; margin:-6px 0 16px; }
    .cms-note code { color:#BC1320; }
    /* โลโก้ตัวอย่างเป็นตัวอักษรสีเข้ม — ให้พื้นหลังอ่อนจะได้เห็นชัดใน thumbnail */
    .show-img .img-thumbnail { background:#f4f6fa; padding:12px; max-height:140px; width:auto; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">

        @Html.AntiForgeryToken()

        <fieldset class="cms-section">
            <legend>โลโก้บน Header</legend>
            <p class="cms-note">
                โลโก้แสดงที่มุมซ้ายบนของทุกหน้า (สูง 44px บนจอใหญ่ / 34px บนมือถือ — ความกว้างปรับตามอัตราส่วนรูป)
                และ<strong>ลิงก์ไปหน้าแรกเสมอ</strong> · ถ้าเว้นว่างไว้ หน้าเว็บจะใช้โลโก้มาตรฐานของเว็บแทน
                · ถ้าไม่ระบุรูปภาษาอังกฤษ จะใช้รูปภาษาไทย
            </p>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("โลโก้ <span class='fi fi-th'></span> <span style='font-weight: normal;color: orange;'>(.svg, .webp, .png — พื้นโปร่ง แนะนำสูงอย่างน้อย 88px)</span>", "img1", V("img1")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("โลโก้ <span class='fi fi-us'></span> <span style='font-weight: normal;color: orange;'>(ไม่ระบุ = ใช้รูปภาษาไทย)</span>", "en_img1", V("en_img1")))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>Alt Text ของโลโก้</legend>
            <p class="cms-note">
                ข้อความอธิบายรูปสำหรับโปรแกรมอ่านหน้าจอและ Search Engine (แอตทริบิวต์ <code>alt</code> / <code>aria-label</code>)
                · ภาษาไทยจำเป็นต้องระบุ ส่วนภาษาอังกฤษถ้าเว้นว่างจะใช้ภาษาไทยแทน
            </p>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Alt Text <span class='fi fi-th'></span>", "title", V("title")))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("Alt Text <span class='fi fi-us'></span>", "en_title", V("en_title")))
                </div>
            </div>
        </fieldset>

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })

    </form>
</div>

@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        // Alt Text ภาษาไทยจำเป็น — ใช้เป็นชื่อรายการในหน้า list และ Admin Log ด้วย
        if ($('[name="title"]').val().trim() === '') {
            sAlert("ข้อมูลไม่ครบ", "กรุณาระบุ Alt Text ภาษาไทย", "warning");
            $('[name="title"]').focus();
            return false;
        }

        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }

    $(document).ready(function() {
        checkLockedRow(modConfig, jsonRow);
    });
</script>
}
