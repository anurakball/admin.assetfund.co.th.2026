@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@*
    ข้อมูลหน้าแรก > มูลค่าหน่วยฯ (3 Links) (โมดูล HomeSamText — แถวเดียว web_core_single module_id 1)
    Asset Plus 18 ก.ย. 2569: เดิม SAM ใช้แถวนี้เป็น "SAM ใส่ใจ" → เปลี่ยนเป็นไทล์ 3 อันข้างตาราง "มูลค่าหน่วยลงทุน" บนหน้าแรก
    ช่องของไทล์ที่ n (1..3), b = (n-1)*6 : t{b+1}/en_ หัวข้อ · t{b+2}/en_ คำอธิบาย · t{b+3}/en_ URL · t{b+4} Target · t{b+5} รูป · t{b+6} ไอคอน
    ต้องตรงกับ Field_HomeQuickTiles (AdminMenu.cs) และ front-end Services/SqlHomeQuickTileService.cs
    ห้ามใส่ <p class="cms-note"> (ผู้ใช้สั่ง 17 ก.ย. 2569) — ใช้คำใบ้สั้นสีส้มในป้ายชื่อช่องแทน
*@
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _admin = (AdminHelpers)ViewBag._admin;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
    string V(string col) => row.Table.Columns.Contains(col) ? (row[col] + "").Trim() : "";
    const string Hint = "font-weight: normal;color: orange;";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#00295A; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
    .cms-section .img-thumbnail { max-height:120px; width:auto; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        <fieldset class="cms-section">
            <legend>ข้อมูลหลัก</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("ชื่อรายการ <span style='" + Hint + "'>(ใช้ในหลังบ้าน ไม่แสดงบนหน้าเว็บ)</span>", "title", V("title")))
                </div>
            </div>
        </fieldset>

        @for (int n = 1; n <= 3; n++)
        {
            int b = (n - 1) * 6;
            <fieldset class="cms-section" data-tile="@n">
                <legend>ไทล์ที่ @n</legend>
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span> <span style='" + Hint + "'>(ว่าง = ไม่แสดงไทล์นี้)</span>", "t" + (b + 1), V("t" + (b + 1))))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_t" + (b + 1), V("en_t" + (b + 1))))
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("คำอธิบาย <span class='fi fi-th'></span>", "t" + (b + 2), V("t" + (b + 2))))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("คำอธิบาย <span class='fi fi-us'></span>", "en_t" + (b + 2), V("en_t" + (b + 2))))
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputTextLinkCMSPage("URL <span class='fi fi-th'></span> <span style='" + Hint + "'>(เช่น /funds/nav หรือ https://…)</span>", "t" + (b + 3), V("t" + (b + 3))))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputTextLinkCMSPage("URL <span class='fi fi-us'></span>", "en_t" + (b + 3), V("en_t" + (b + 3))))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputUrlTarget("URL Target", "t" + (b + 4), V("t" + (b + 4))))
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputFileManeger("รูปภาพ <span style='" + Hint + "'>(.webp, .jpg, .png — " + (n == 1 ? "แนะนำ 630 x 172" : "แนะนำ 300 x 172") + " · ใช้กับเวอร์ชัน 1–2)</span>", "t" + (b + 5), V("t" + (b + 5))))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("ไอคอน <span style='" + Hint + "'>(Bootstrap Icons เช่น bi-graph-up-arrow · ใช้กับเวอร์ชัน 3)</span>", "t" + (b + 6), V("t" + (b + 6)), "bi-graph-up-arrow", 60))
                    </div>
                </div>
            </fieldset>
        }

        @{
            string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
            string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
        }
        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@issue_date" />
        <input type="hidden" name="expiry_date" value="@expiry_date" />

        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")
@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)

    function warn(text, field) {
        Swal.fire({ icon: 'warning', title: 'กรุณาตรวจสอบข้อมูล', text: text, confirmButtonText: 'ตกลง', confirmButtonColor: '#00295A' });
        if (field) { field.focus(); }
        return false;
    }

    function sConfirmCustom(form)
    {
        var title = $('[name="title"]');
        if (title.val().trim() === '') { return warn('กรุณากรอกชื่อรายการ', title); }

        var urlOk = /^(\/|https?:\/\/)\S*$/i;
        var iconOk = /^bi-[a-z0-9-]+$/;
        for (var n = 1; n <= 3; n++) {
            var b = (n - 1) * 6;
            var fields = [$('[name="t' + (b + 3) + '"]'), $('[name="en_t' + (b + 3) + '"]')];
            for (var i = 0; i < fields.length; i++) {
                var v = fields[i].val().trim();
                if (v !== '' && !urlOk.test(v)) { return warn('ไทล์ที่ ' + n + ': URL ต้องขึ้นต้นด้วย / หรือ http:// / https://', fields[i]); }
            }
            var icon = $('[name="t' + (b + 6) + '"]');
            if (icon.val().trim() !== '' && !iconOk.test(icon.val().trim())) {
                return warn('ไทล์ที่ ' + n + ': ไอคอนต้องเป็นชื่อ Bootstrap Icons เช่น bi-graph-up-arrow', icon);
            }
        }

        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: { popup: 'animate__animated animate__bounceIn' },
            hideClass: { popup: 'animate__animated animate__bounceOut' }
        }).then((result) => {
            if (result.isConfirmed) { form.submit(); }
        });
        return false;
    }

    $(document).ready(function() {
        checkLockedRow(modConfig, jsonRow);
    });
</script>
}
