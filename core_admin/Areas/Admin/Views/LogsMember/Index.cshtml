@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
    var searchInputVal = (Dictionary<string, string>)ViewBag.searchInputVal;
}

@section NavbarBack{
    @if (mod_config.IsCMSPage == true && mod_config.FieldCMSPage != "" && _session.GetInt32("admin_" + mod.Name + "_parent_lv").HasValue && _session.GetInt32("admin_" + mod.Name + "_parent_lv") > 1)
    {
        int parent_id = _admin.getParentID(mod, Convert.ToInt32(_session.GetString("admin_" + mod.Name + "_search_" + mod_config.FieldCMSPage)));
        @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}?{1}={2}", mod.Name, mod_config.FieldCMSPage, parent_id) })
    }
}

@await Component.InvokeAsync("AdminBreadcrumb",  new { Module = mod })

@functions {
    string SevClass(string s) => s switch { "WARNING" => "warning", "ERROR" => "danger", "CRITICAL" => "dark", _ => "info" };
    string SevText(string s) => (s == "INFO" || s == "WARNING") ? "text-dark" : "";
    string StClass(string s) => s switch { "SUCCESS" => "success", "FAILED" => "danger", "PENDING" => "warning", "CANCELLED" => "secondary", _ => "info" };
    string StText(string s) => s == "PENDING" ? "text-dark" : "";
    string DevIcon(string d) => d switch { "Mobile" => "bi-phone", "Tablet" => "bi-tablet", _ => "bi-display" };
}

@{
    // อ่าน query string โดยตรง — searchInputVal ใช้ได้เฉพาะ FieldSearch ที่ register ใน Module.Config
    var _q = HttpContextAccessor.HttpContext!.Request.Query;
    string Q(string key) => _q.ContainsKey(key) ? (_q[key].ToString() ?? "").Trim() : "";

    var qMember    = Q("q_member");
    var qCode      = Q("q_code");
    var qCategory  = Q("q_category");
    var qSeverity  = Q("q_severity");
    var qStatus    = Q("q_status");
    var qIp        = Q("q_ip");
    var qDateStart = Q("q_date_start");
    var qDateEnd   = Q("q_date_end");

    int curPage = int.TryParse(Q("page"),    out var _cp) && _cp > 0 ? _cp : 1;
    int perPage = int.TryParse(Q("perpage"), out var _pp) && _pp >= 5 ? _pp : 20;
    int offset  = (curPage - 1) * perPage;

    var where  = new System.Text.StringBuilder("WHERE 1=1");
    var prms   = new Dictionary<string, object>();

    if (!string.IsNullOrEmpty(qMember)) {
        where.Append(" AND (CAST(l.member_id AS VARCHAR) = @p_mid OR m.username ILIKE @p_mlike OR m.email ILIKE @p_mlike)");
        prms["p_mid"] = qMember; prms["p_mlike"] = "%" + qMember + "%";
    }
    if (!string.IsNullOrEmpty(qCode))     { where.Append(" AND l.activity_code = @p_code");     prms["p_code"]     = qCode; }
    if (!string.IsNullOrEmpty(qCategory)) { where.Append(" AND t.category = @p_cat");           prms["p_cat"]      = qCategory; }
    if (!string.IsNullOrEmpty(qSeverity)) { where.Append(" AND t.severity = @p_sev");           prms["p_sev"]      = qSeverity; }
    if (!string.IsNullOrEmpty(qStatus))   { where.Append(" AND l.status = @p_status");          prms["p_status"]   = qStatus; }
    if (!string.IsNullOrEmpty(qIp))       { where.Append(" AND l.ip_address ILIKE @p_ip");      prms["p_ip"]       = "%" + qIp + "%"; }

    if (!string.IsNullOrEmpty(qDateStart)) {
        try { var p = qDateStart.Split('/'); var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0])); where.Append(" AND l.activity_at >= @p_ds"); prms["p_ds"] = d; } catch {}
    }
    if (!string.IsNullOrEmpty(qDateEnd)) {
        try { var p = qDateEnd.Split('/'); var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0])).AddDays(1); where.Append(" AND l.activity_at < @p_de"); prms["p_de"] = d; } catch {}
    }

    var w = where.ToString();

    var dtCount = _db.ExecuteQuery($@"
        SELECT COUNT(*) as cnt
        FROM web_member_activity_log l
        LEFT JOIN web_member_activity_type t ON l.activity_type_id = t.id
        LEFT JOIN web_member m ON l.member_id = m.id {w}", prms);
    long totalRows  = dtCount.Rows.Count > 0 ? Convert.ToInt64(dtCount.Rows[0]["cnt"]) : 0;
    int  totalPages = (int)Math.Ceiling((double)totalRows / perPage);

    var dtLogs = _db.ExecuteQuery($@"
        SELECT l.id, l.member_id, l.activity_code, l.activity_name,
               l.description, l.target_type, l.target_id,
               l.ip_address, l.device_type, l.browser, l.os,
               l.country, l.city, l.status, l.error_message, l.duration_ms,
               l.request_url, l.request_method, l.session_id,
               l.old_value, l.new_value, l.metadata,
               l.activity_at,
               t.name  AS type_name, t.severity, t.category,
               m.username, m.email
        FROM web_member_activity_log l
        LEFT JOIN web_member_activity_type t ON l.activity_type_id = t.id
        LEFT JOIN web_member m ON l.member_id = m.id
        {w}
        ORDER BY l.activity_at DESC
        LIMIT {perPage} OFFSET {offset}", prms);

    var dtTypes = _db.ExecuteQuery(
        "SELECT code, name, category FROM web_member_activity_type WHERE status=1 ORDER BY sort, name");
    var dtCats  = _db.ExecuteQuery(
        "SELECT DISTINCT category FROM web_member_activity_type WHERE status=1 AND category IS NOT NULL ORDER BY category");

    // Stats (no extra filter — fixed counts for display)
    var dtStats = _db.ExecuteQuery($@"
        SELECT
            COUNT(*) FILTER (WHERE l.status = 'SUCCESS')   AS cnt_success,
            COUNT(*) FILTER (WHERE l.status = 'FAILED')    AS cnt_failed,
            COUNT(*) FILTER (WHERE l.status = 'PENDING')   AS cnt_pending,
            COUNT(*) FILTER (WHERE l.activity_code = 'LOGIN'  AND l.activity_at >= NOW() - INTERVAL '24 hours') AS cnt_login_today
        FROM web_member_activity_log l
        LEFT JOIN web_member_activity_type t ON l.activity_type_id = t.id
        LEFT JOIN web_member m ON l.member_id = m.id {w}", prms);

    long cntSuccess    = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_success"])    : 0;
    long cntFailed     = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_failed"])     : 0;
    long cntPending    = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_pending"])    : 0;
    long cntLoginToday = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_login_today"]): 0;

    // Build query string (for pagination links and export)
    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(qMember))    qsParts.Add("q_member="    + Uri.EscapeDataString(qMember));
    if (!string.IsNullOrEmpty(qCode))      qsParts.Add("q_code="      + Uri.EscapeDataString(qCode));
    if (!string.IsNullOrEmpty(qCategory))  qsParts.Add("q_category="  + Uri.EscapeDataString(qCategory));
    if (!string.IsNullOrEmpty(qSeverity))  qsParts.Add("q_severity="  + Uri.EscapeDataString(qSeverity));
    if (!string.IsNullOrEmpty(qStatus))    qsParts.Add("q_status="    + Uri.EscapeDataString(qStatus));
    if (!string.IsNullOrEmpty(qIp))        qsParts.Add("q_ip="        + Uri.EscapeDataString(qIp));
    if (!string.IsNullOrEmpty(qDateStart)) qsParts.Add("q_date_start="+ Uri.EscapeDataString(qDateStart));
    if (!string.IsNullOrEmpty(qDateEnd))   qsParts.Add("q_date_end="  + Uri.EscapeDataString(qDateEnd));
    qsParts.Add("perpage=" + perPage);
    var baseQs  = string.Join("&", qsParts);
    var exportQs = string.Join("&", qsParts.Where(p => !p.StartsWith("perpage=")));

    int rowNum = offset + 1;

    // สร้าง data map สำหรับ modal — หลีกเลี่ยงการ embed JSON ใน HTML attribute
    var logDataMap = new Dictionary<string, object>();
    foreach (DataRow lr in dtLogs.Rows) {
        var _at  = lr["activity_at"] != DBNull.Value ? Convert.ToDateTime(lr["activity_at"]) : DateTime.MinValue;
        var _dur = lr["duration_ms"] != DBNull.Value ? Convert.ToInt32(lr["duration_ms"]) : -1;
        var _city = lr["city"]?.ToString() ?? "";
        var _country = lr["country"]?.ToString() ?? "";
        logDataMap[lr["id"].ToString()] = new {
            id          = lr["id"]?.ToString(),
            member_id   = lr["member_id"]?.ToString(),
            username    = lr["username"]?.ToString() ?? "",
            email       = lr["email"]?.ToString() ?? "",
            code        = lr["activity_code"]?.ToString(),
            name        = lr["type_name"]?.ToString() ?? lr["activity_name"]?.ToString() ?? lr["activity_code"]?.ToString(),
            category    = lr["category"]?.ToString(),
            severity    = lr["severity"]?.ToString() ?? "INFO",
            status      = lr["status"]?.ToString() ?? "SUCCESS",
            description = lr["description"]?.ToString(),
            target_type = lr["target_type"]?.ToString(),
            target_id   = lr["target_id"]?.ToString(),
            ip          = lr["ip_address"]?.ToString(),
            device      = lr["device_type"]?.ToString(),
            browser     = lr["browser"]?.ToString(),
            os          = lr["os"]?.ToString(),
            session_id  = lr["session_id"]?.ToString(),
            request_url = lr["request_url"]?.ToString(),
            method      = lr["request_method"]?.ToString(),
            location    = !string.IsNullOrEmpty(_city) ? _city + (!string.IsNullOrEmpty(_country) ? ", " + _country : "") : _country,
            duration    = _dur,
            error       = lr["error_message"]?.ToString(),
            old_value   = lr["old_value"]?.ToString(),
            new_value   = lr["new_value"]?.ToString(),
            metadata    = lr["metadata"]?.ToString(),
            activity_at = _at != DateTime.MinValue ? _at.ToString("dd/MM/yyyy HH:mm:ss") : ""
        };
    }
    var logDataJson = Newtonsoft.Json.JsonConvert.SerializeObject(logDataMap);
}

@* ===================== SEARCH FORM ===================== *@
<div class="form-wrapper mb-4">
    <form method="get" id="formSearch" class="form" autocomplete="off">
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">สมาชิก (ID / Username / Email)</label>
                    <input type="text" name="q_member" value="@qMember" class="form-control" placeholder="ค้นหา..." />
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">ประเภท Activity</label>
                    <select name="q_code" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtTypes.Rows) {
                            var code = r["code"].ToString();
                            <option value="@code" @(qCode == code ? "selected" : "")>@r["name"] (@code)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">กลุ่ม</label>
                    <select name="q_category" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtCats.Rows) {
                            var cat = r["category"].ToString();
                            <option value="@cat" @(qCategory == cat ? "selected" : "")>@cat</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">ระดับความสำคัญ</label>
                    <select name="q_severity" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var sev in new[] { "INFO","WARNING","ERROR","CRITICAL" }) {
                            <option value="@sev" @(qSeverity == sev ? "selected" : "")>@sev</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">สถานะ</label>
                    <select name="q_status" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var st in new[] { "SUCCESS","FAILED","PENDING","CANCELLED" }) {
                            <option value="@st" @(qStatus == st ? "selected" : "")>@st</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">IP Address</label>
                    <input type="text" name="q_ip" value="@qIp" class="form-control" placeholder="192.168.x.x" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">แสดงหน้าละ</label>
                    <select name="perpage" class="form-select">
                        @foreach (var n in new[] { 10, 20, 50, 100 }) {
                            <option value="@n" @(perPage == n ? "selected" : "")>@n รายการ</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="field">
                    <label class="form-label">ช่วงวันที่</label>
                    <div class="input-group input-daterange">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                        <input type="text" id="date_timepicker_start" name="q_date_start" value="@qDateStart" class="form-control" placeholder="วันเริ่มต้น" readonly />
                        <span class="input-group-text">ถึง</span>
                        <input type="text" id="date_timepicker_end" name="q_date_end" value="@qDateEnd" class="form-control" placeholder="วันสิ้นสุด" readonly />
                    </div>
                </div>
            </div>
        </div>
        <div class="btn-group mt-1">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon"><i class="bi bi-search"></i></span>
                <span class="btn-text">ค้นหา</span>
            </button>
            
            @{
                if(Context.Request.Query["perpage"]+"" != "")
                {
                    <a href="?page=1" class="btn btn--gray">
                        <span class="btn-icon"><i class="bi bi-x-circle"></i></span>
                        <span class="btn-text">ล้างค่า</span>
                    </a>
                }
            }
            
        </div>
    </form>
</div>

@* ===================== SUMMARY CARDS ===================== *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-primary">@totalRows.ToString("N0")</div>
                <div class="small text-muted">รายการทั้งหมด</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-success">@cntSuccess.ToString("N0")</div>
                <div class="small text-muted">SUCCESS</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-danger">@cntFailed.ToString("N0")</div>
                <div class="small text-muted">FAILED</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-info">@cntLoginToday.ToString("N0")</div>
                <div class="small text-muted">Login วันนี้</div>
            </div>
        </div>
    </div>
</div>

@* ===================== TABLE ===================== *@
<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center py-2">
        <span class="fw-semibold"><i class="bi bi-list-ul me-1"></i> รายการ Activity Log</span>
        <span class="text-muted small ms-auto me-4">ทั้งหมด @totalRows.ToString("N0") รายการ &bull; หน้า @curPage / @(totalPages == 0 ? 1 : totalPages)</span>
        <a href="/Admin/LogsMember/ExportExcel@(string.IsNullOrEmpty(exportQs) ? "" : "?" + exportQs)"
           class="btn btn-sm" style="background-color:#217346;color:#fff;border-color:#217346"
           title="Export ผลลัพธ์การค้นหาเป็น Excel">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped-custom mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:50px">#</th>
                        <th style="width:155px">วันที่ / เวลา</th>
                        <th>สมาชิก</th>
                        <th>Activity</th>
                        <th style="width:100px">Category</th>
                        <th style="width:90px">Severity</th>
                        <th style="width:100px">สถานะ</th>
                        <th style="width:130px">IP / อุปกรณ์</th>
                        <th style="width:80px" class="text-center">ระยะเวลา</th>
                        <th style="width:60px" class="text-center">รายละเอียด</th>
                    </tr>
                </thead>
                <tbody>
                @if (dtLogs.Rows.Count == 0) {
                    <tr><td colspan="10" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-3 d-block mb-2"></i>ไม่พบข้อมูล</td></tr>
                }
                @foreach (DataRow row in dtLogs.Rows) {
                    var statusVal   = row["status"]?.ToString() ?? "SUCCESS";
                    var severityVal = row["severity"]?.ToString() ?? "INFO";
                    var activityAt  = row["activity_at"] != DBNull.Value ? Convert.ToDateTime(row["activity_at"]) : DateTime.MinValue;
                    var durationMs  = row["duration_ms"] != DBNull.Value ? Convert.ToInt32(row["duration_ms"]) : -1;
                    var uname       = row["username"]?.ToString() ?? "";
                    var email       = row["email"]?.ToString() ?? "";
                    var memberLabel = !string.IsNullOrEmpty(uname) ? uname : (!string.IsNullOrEmpty(email) ? email : "member_id:" + row["member_id"]);
                    var typeName    = row["type_name"]?.ToString() ?? row["activity_name"]?.ToString() ?? row["activity_code"]?.ToString();
                    var ipAddr      = row["ip_address"]?.ToString() ?? "";
                    var devType     = row["device_type"]?.ToString() ?? "";
                    var browser     = row["browser"]?.ToString() ?? "";
                    var country     = row["country"]?.ToString() ?? "";
                    var city        = row["city"]?.ToString() ?? "";
                    var locLabel    = !string.IsNullOrEmpty(city) ? city + (string.IsNullOrEmpty(country) ? "" : ", " + country) : country;

                    <tr data-id="@row["id"]">
                        <td class="text-center text-muted small">@rowNum</td>
                        <td class="small">
                            @if (activityAt != DateTime.MinValue) {
                                <span class="d-block">@activityAt.ToString("dd/MM/yyyy")</span>
                                <span class="text-muted">@activityAt.ToString("HH:mm:ss")</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold small">@memberLabel</div>
                            @if (!string.IsNullOrEmpty(email) && uname != email) {
                                <div class="text-muted" style="font-size:.75rem">@email</div>
                            }
                            <div class="text-muted" style="font-size:.75rem">ID: @row["member_id"]</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-25 text-dark border mb-1" style="font-size:.7rem">@row["activity_code"]</span>
                            <div class="small">@typeName</div>
                            @if (!string.IsNullOrEmpty(row["description"]?.ToString())) {
                                <div class="text-muted" style="font-size:.72rem;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                     title="@row["description"]">@row["description"]</div>
                            }
                        </td>
                        <td><span class="small text-muted">@row["category"]</span></td>
                        <td>
                            <span class="badge bg-@SevClass(severityVal) @SevText(severityVal)">@severityVal</span>
                        </td>
                        <td>
                            <span class="badge bg-@StClass(statusVal) @StText(statusVal)">@statusVal</span>
                            @if (!string.IsNullOrEmpty(row["error_message"]?.ToString())) {
                                <i class="bi bi-exclamation-circle text-danger ms-1" data-toggle="tooltip" title="@row["error_message"]"></i>
                            }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(ipAddr)) {
                                <div><i class="bi bi-@DevIcon(devType) me-1 text-muted"></i><code class="small">@ipAddr</code></div>
                            }
                            @if (!string.IsNullOrEmpty(browser)) {
                                <div class="text-muted" style="font-size:.72rem">@browser</div>
                            }
                            @if (!string.IsNullOrEmpty(locLabel)) {
                                <div class="text-muted" style="font-size:.72rem"><i class="bi bi-geo-alt"></i> @locLabel</div>
                            }
                        </td>
                        <td class="text-center small">
                            @if (durationMs >= 0) {
                                <span class="@(durationMs > 3000 ? "text-danger" : durationMs > 1000 ? "text-warning" : "text-success")">
                                    @(durationMs >= 1000 ? (durationMs / 1000.0).ToString("F1") + "s" : durationMs + "ms")
                                </span>
                            } else {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn--outline--primary btn-log-detail"
                                    data-log-id="@row["id"]">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                    rowNum++;
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1) {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                แสดง @(offset + 1)–@(Math.Min(offset + perPage, (int)totalRows)) จาก @totalRows.ToString("N0") รายการ
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @{ int pgStart = Math.Max(1, curPage - 2); int pgEnd = Math.Min(totalPages, curPage + 2); }
                    @if (curPage > 1) {
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=1"><i class="bi bi-chevron-double-left"></i></a></li>
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@(curPage-1)"><i class="bi bi-chevron-left"></i></a></li>
                    }
                    @for (int p = pgStart; p <= pgEnd; p++) {
                        <li class="page-item @(p == curPage ? "active" : "")">
                            <a class="page-link" href="?@baseQs&page=@p">@p</a>
                        </li>
                    }
                    @if (curPage < totalPages) {
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@(curPage+1)"><i class="bi bi-chevron-right"></i></a></li>
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@totalPages"><i class="bi bi-chevron-double-right"></i></a></li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@* ===================== DETAIL MODAL ===================== *@
<div class="modal fade" id="modalLogDetail" tabindex="-1" aria-labelledby="modalLogDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLogDetailLabel">
                    <i class="bi bi-journal-text me-2"></i>รายละเอียด Activity Log
                    <span id="mdlBadgeSeverity" class="badge ms-2"></span>
                    <span id="mdlBadgeStatus"   class="badge ms-1"></span>
                </h5>
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-person me-1"></i>ข้อมูลสมาชิก</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:90px">Member ID</td><td id="mdlMemberId" class="fw-semibold"></td></tr>
                                <tr><td class="text-muted">Username</td><td id="mdlUsername"></td></tr>
                                <tr><td class="text-muted">Email</td><td id="mdlEmail"></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-activity me-1"></i>ข้อมูล Activity</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:90px">Code</td><td><code id="mdlCode"></code></td></tr>
                                <tr><td class="text-muted">ชื่อ</td><td id="mdlName"></td></tr>
                                <tr><td class="text-muted">Category</td><td id="mdlCategory"></td></tr>
                                <tr><td class="text-muted">เวลา</td><td id="mdlActivityAt"></td></tr>
                                <tr><td class="text-muted">ระยะเวลา</td><td id="mdlDuration"></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-hdd-network me-1"></i>ข้อมูลเครือข่าย</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:90px">IP Address</td>
                                    <td><code id="mdlIp"></code> <button class="btn btn-sm p-0 ms-1 text-muted" id="btnCopyIp" title="Copy"><i class="bi bi-clipboard"></i></button></td></tr>
                                <tr><td class="text-muted">Device</td><td id="mdlDevice"></td></tr>
                                <tr><td class="text-muted">Browser</td><td id="mdlBrowser"></td></tr>
                                <tr><td class="text-muted">OS</td><td id="mdlOs"></td></tr>
                                <tr><td class="text-muted">Location</td><td id="mdlLocation"></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-link-45deg me-1"></i>ข้อมูล Request</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:90px">Method</td><td><code id="mdlMethod"></code></td></tr>
                                <tr><td class="text-muted">URL</td><td><span id="mdlUrl" class="text-break" style="font-size:.78rem"></span></td></tr>
                                <tr><td class="text-muted">Session</td><td><span id="mdlSession" style="font-size:.72rem;word-break:break-all"></span></td></tr>
                                <tr><td class="text-muted">Target</td><td><span id="mdlTarget"></span></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div id="mdlDescWrap" class="mb-3 d-none">
                    <div class="small fw-semibold text-muted mb-1"><i class="bi bi-chat-left-text me-1"></i>คำอธิบาย</div>
                    <div id="mdlDesc" class="border rounded p-2 bg-light small"></div>
                </div>

                <div id="mdlErrorWrap" class="mb-3 d-none">
                    <div class="small fw-semibold text-danger mb-1"><i class="bi bi-exclamation-triangle me-1"></i>ข้อผิดพลาด</div>
                    <div id="mdlError" class="border border-danger rounded p-2 bg-danger bg-opacity-10 small text-danger"></div>
                </div>

                <ul class="nav nav-tabs" id="jsonTabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-toggle="tab" data-target="#tabOldVal">Old Value</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabNewVal">New Value</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabMeta">Metadata</button></li>
                </ul>
                <div class="tab-content border border-top-0 rounded-bottom p-0">
                    <div class="tab-pane fade show active" id="tabOldVal">
                        <pre id="mdlOldValue" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:220px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabNewVal">
                        <pre id="mdlNewValue" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:220px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabMeta">
                        <pre id="mdlMetadata" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:220px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <span class="text-muted small me-auto">Log ID: <code id="mdlLogId"></code></span>
                <button type="button" class="btn btn--gray" data-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <style>
    body.modal-open { overflow: hidden !important; padding-right: 0 !important; }
    #modalLogDetail .modal-body { overflow-y: auto; scrollbar-width: none; }
    #modalLogDetail .modal-body::-webkit-scrollbar { display: none; }
    </style>
    <script>
    var __logData = @Html.Raw(logDataJson);
    $(document).ready(function () {

        // ---- Date Pickers ----
        if ($.fn.datetimepicker) {
            $('#date_timepicker_start').datetimepicker({ timepicker: false, format: 'd/m/Y',
                onSelectDate: function (dp, $i) {
                    var d = $i.val();
                    $('#date_timepicker_end').datetimepicker('setOptions', { minDate: d });
                }
            });
            $('#date_timepicker_end').datetimepicker({ timepicker: false, format: 'd/m/Y',
                onSelectDate: function (dp, $i) {
                    var d = $i.val();
                    $('#date_timepicker_start').datetimepicker('setOptions', { maxDate: d });
                }
            });
        }

        // ---- Tooltips (Bootstrap 4 jQuery API) ----
        $('[data-toggle="tooltip"]').tooltip({ trigger: 'hover', placement: 'top', offset: 0 });

        // ---- Severity / Status badge color helpers ----
        var sevClass = { INFO: 'bg-info text-dark', WARNING: 'bg-warning text-dark', ERROR: 'bg-danger', CRITICAL: 'bg-dark' };
        var stClass  = { SUCCESS: 'bg-success', FAILED: 'bg-danger', PENDING: 'bg-warning text-dark', CANCELLED: 'bg-secondary' };

        function prettyJson(str) {
            if (!str || str.trim() === '' || str.trim() === 'null') return '(ไม่มีข้อมูล)';
            try   { return JSON.stringify(JSON.parse(str), null, 2); }
            catch { return str; }
        }

        // ---- Detail Modal ----
        $(document).on('click', '.btn-log-detail', function () {
            var d = __logData[$(this).data('log-id')];

            $('#mdlLogId').text(d.id);
            $('#mdlMemberId').text(d.member_id);
            $('#mdlUsername').text(d.username  || '-');
            $('#mdlEmail').text(d.email        || '-');
            $('#mdlCode').text(d.code          || '-');
            $('#mdlName').text(d.name          || '-');
            $('#mdlCategory').text(d.category  || '-');
            $('#mdlActivityAt').text(d.activity_at || '-');
            $('#mdlDuration').text(d.duration >= 0
                ? (d.duration >= 1000 ? (d.duration / 1000).toFixed(1) + ' วินาที' : d.duration + ' ms')
                : '-');

            $('#mdlIp').text(d.ip       || '-');
            $('#mdlDevice').text(d.device   || '-');
            $('#mdlBrowser').text(d.browser || '-');
            $('#mdlOs').text(d.os         || '-');
            $('#mdlLocation').text(d.location || '-');
            $('#mdlMethod').text(d.method || '-');
            $('#mdlUrl').text(d.request_url || '-');
            $('#mdlSession').text(d.session_id || '-');
            $('#mdlTarget').text(d.target_type && d.target_id ? d.target_type + ' #' + d.target_id : '-');

            var $descWrap = $('#mdlDescWrap'); var desc = (d.description || '').trim();
            $descWrap.toggleClass('d-none', desc === ''); $('#mdlDesc').text(desc);

            var $errWrap = $('#mdlErrorWrap'); var err = (d.error || '').trim();
            $errWrap.toggleClass('d-none', err === ''); $('#mdlError').text(err);

            $('#mdlOldValue').text(prettyJson(d.old_value));
            $('#mdlNewValue').text(prettyJson(d.new_value));
            $('#mdlMetadata').text(prettyJson(d.metadata));

            // Severity badge
            var $bs = $('#mdlBadgeSeverity').removeClass().addClass('badge');
            $bs.addClass(sevClass[d.severity] || 'bg-secondary').text(d.severity || '');

            // Status badge
            var $bst = $('#mdlBadgeStatus').removeClass().addClass('badge');
            $bst.addClass(stClass[d.status] || 'bg-secondary').text(d.status || '');

            // Reset to first tab
            $('#jsonTabs .nav-link').removeClass('active');
            $('#jsonTabs .nav-link:first').addClass('active');
            $('.tab-pane').removeClass('show active');
            $('#tabOldVal').addClass('show active');

            $('#modalLogDetail').modal('show');
        });

        // ---- Modal dismiss (explicit — Bootstrap 4/5 conflict workaround) ----
        $(document).on('click', '[data-dismiss="modal"]', function () {
            $(this).closest('.modal').modal('hide');
        });

        // ---- Copy IP ----
        $('#btnCopyIp').on('click', function () {
            var ip = $('#mdlIp').text().trim();
            if (ip && navigator.clipboard) {
                navigator.clipboard.writeText(ip).then(function () {
                    $('#btnCopyIp i').removeClass('bi-clipboard').addClass('bi-clipboard-check');
                    setTimeout(function () {
                        $('#btnCopyIp i').removeClass('bi-clipboard-check').addClass('bi-clipboard');
                    }, 1500);
                });
            }
        });

    });
    </script>
}