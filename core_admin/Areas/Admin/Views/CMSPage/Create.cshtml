@section Slide
{
    <link href="~/Vendor/slick/slick.css" rel="stylesheet" />
    <link href="~/Vendor/slick/slick-theme.css" rel="stylesheet" />
    <script src="~/Vendor/slick/slick.min.js"></script>
    <script>

    function sConfirmCustom(form) 
    {
        document.getElementById('box_layout').value = "";
        if (document.getElementById('id_issue_date_config_2').checked == true) 
        {
            if (
                $('#id_issue_date').val() != '' && $('#id_expiry_date').val() != '' &&
                $('#id_issue_date').datetimepicker('getValue') > $('#id_expiry_date').datetimepicker('getValue')
            ) 
            {
                sAlert("วันที่ไม่ถูกต้อง", "วันที่สิ้นสุด ต้องมากกว่า วันที่แสดงผล", "warning");
                return false;
            }
        }
 
        if ($('#id_title').val().trim() === '') {
            sAlert("กรุณากรอกข้อมูล", "กรุณากรอก หัวข้อ (TH)", "warning");
            $('#id_title').focus();
            return false;
        }
        if ($('#id_en_title').val().trim() === '') {
            sAlert("กรุณากรอกข้อมูล", "กรุณากรอก หัวข้อ (EN)", "warning");
            $('#id_en_title').focus();
            return false;
        }
        if ($('#id_seo_url').val().trim() === '') {
            sAlert("กรุณากรอกข้อมูล", "กรุณากรอก URL Friendly (TH)", "warning");
            $('#id_seo_url').focus();
            return false;
        }
        if ($('#id_en_seo_url').val().trim() === '') {
            sAlert("กรุณากรอกข้อมูล", "กรุณากรอก URL Friendly (EN)", "warning").then(() => { $('#id_en_seo_url').focus(); });
            return false;
        }

        if ($(':input[name="page_type"]:checked').val() === '2') {
            if ($('#id_url').val().trim() === '') {
                sAlert("กรุณากรอกข้อมูล", "กรุณากรอก URL (TH)", "warning").then(() => { $('#id_url').focus(); });
                return false;
            }
            if ($('#id_en_url').val().trim() === '') {
                sAlert("กรุณากรอกข้อมูล", "กรุณากรอก URL (EN)", "warning").then(() => { $('#id_en_url').focus(); });
                return false;
            }
        }

        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#00295A',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }
    function slickCarousel() 
    {
        $(".card--slide").each(function (index, element) 
        {
            $(this).not('.slick-initialized').slick(
            {
                dots: false,
                autoplay: false,
                infinite: true,
                arrows: true,
                touchMove: false,
                speed: 1000,
                //cssEase: 'linear',
                slidesToShow: 3,
                slidesToScroll: 1,
                responsive: [
                {
                    breakpoint: 992,
                    settings: {
                        slidesToShow: 2,
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1,
                    }
                }]
            });
        });
        $('.list-group__left .accordion-item .accordion-collapse .accordion-body .itemDrag .list-group-item .main-func .card--slide').slick('destroy');
    }
    $(document).ready(function () 
    { 
        $(":input[name='page_type']").click(function () 
        {
            if ($(this).val() == '1') {
                $('#type_div_1').stop(true, false).slideDown();
                $('#type_div_2').stop(true, false).slideUp();
                $('#type_div_3').stop(true, false).slideUp();
                $('#type_div_4').stop(true, false).slideUp();
                $('#type_div_5').stop(true, false).slideUp();
            }
            else if ($(this).val() == '2') {
                $('#type_div_1').stop(true, false).slideUp();
                $('#type_div_2').stop(true, false).slideDown();
                $('#type_div_3').stop(true, false).slideUp();
                $('#type_div_4').stop(true, false).slideUp();
                $('#type_div_5').stop(true, false).slideUp();
            }
            else if ($(this).val() == '3') {
                $('#type_div_1').stop(true, false).slideUp();
                $('#type_div_2').stop(true, false).slideUp();
                $('#type_div_3').stop(true, false).slideDown();
                $('#type_div_4').stop(true, false).slideUp();
                $('#type_div_5').stop(true, false).slideUp();
            }
            else if ($(this).val() == '4') {
                $('#type_div_1').stop(true, false).slideUp();
                $('#type_div_2').stop(true, false).slideUp();
                $('#type_div_3').stop(true, false).slideUp();
                $('#type_div_4').stop(true, false).slideDown();
                $('#type_div_5').stop(true, false).slideUp();
            }
            else if ($(this).val() == '5') {
                $('#type_div_1').stop(true, false).slideUp();
                $('#type_div_2').stop(true, false).slideUp();
                $('#type_div_3').stop(true, false).slideUp();
                $('#type_div_4').stop(true, false).slideUp();
                $('#type_div_5').stop(true, false).slideDown();
            }
        }); 
        
        setTimeout(function () 
        {
            $(':input[name="issue_date"]').datetimepicker("destroy");
            $(':input[name="issue_date"]').datetimepicker({
                format: 'd/m/Y H:i',
                minDate: 0,
                onClose: function (current_time, $input) 
                { 
                    /*
                    if ($input.val() != '' && $input.datetimepicker('getValue') < new Date().addHours(-1)) 
                    {
                        $input.val('');
                        sAlert("วันที่ไม่ถูกต้อง", "ไม่สามารถเลือกวันที่ น้อยวันที่ปัจจุบันได้", "warning"); 
                    }
                    */
                },
            });
        }, 500);

        $('#id_seo_url').on('keyup', function ()
        {
            var val = replace_for_url(document.getElementById('id_seo_url').value);
            document.getElementById('id_seo_url').value = val.replace(/\//g, '');
        });
        $('#id_en_seo_url').on('keyup', function () {
            var val = replace_for_url(document.getElementById('id_en_seo_url').value);
            document.getElementById('id_en_seo_url').value = val.replace(/\//g, '');
        });
        $('#id_seo_url').on('blur', function () {
            var val = replace_for_url($(this).val().trim());
            val = val.replace(/\//g, '');
            val = val.replace(/[^a-zA-Z0-9ก-๙\-_.]/g, '-');
            val = val.replace(/-{2,}/g, '-');
            val = val.replace(/^-+|-+$/g, '');
            val = val.toLowerCase();
            $(this).val(val);
        });
        $('#id_en_seo_url').on('blur', function () {
            var val = replace_for_url($(this).val().trim());
            val = val.replace(/\//g, '');
            val = val.replace(/[^a-zA-Z0-9ก-๙\-_.]/g, '-');
            val = val.replace(/-{2,}/g, '-');
            val = val.replace(/^-+|-+$/g, '');
            val = val.toLowerCase();
            $(this).val(val);
        });
        $('#id_title').on('blur', function () {
            if ($('#id_seo_url').val().trim() === '') {
                $('#id_seo_url').val($(this).val());
                $('#id_seo_url').trigger('blur');
            }
        });
        $('#id_en_title').on('blur', function () {
            if ($('#id_en_seo_url').val().trim() === '') {
                $('#id_en_seo_url').val($(this).val());
                $('#id_en_seo_url').trigger('blur');
            }
        });

        $('#fm_cms').find('input[type="text"], textarea').attr('maxlength', 255);

        $('.header--primary').css("display", "none");
    });
    </script>
}