        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })

        <input type="hidden" name="box_layout" id="box_layout" />
        <input type="hidden" name="box_data2" id="box_data" />
        <input type="hidden" name="box_data_sub" id="box_data_sub" />
         
    </form>
    
    <script> 
    @{
        int for_check_level_b = 3;
        if(mod.Name == "FooterLink")
        {
            for_check_level_b = 4;
        }
        if (parent_lv < for_check_level_b)
        {

        }
        else
        {
            <text>
            $("#id_page_type_3").trigger("click");
            $('#type_div_1').stop(true, false).slideUp();
            $('#type_div_2').stop(true, false).slideUp();
