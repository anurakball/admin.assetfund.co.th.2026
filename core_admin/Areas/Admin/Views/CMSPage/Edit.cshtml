    @section Dragdrop
    {
        @*CDN*@
        @*<script src="https://unpkg.com/sortablejs-make/Sortable.min.js"></script>*@
        @*<script src="https://cdn.jsdelivr.net/npm/jquery-sortablejs@latest/jquery-sortable.js"></script>*@

        @*Local*@
        @*<script src="~/js/sortable.min.js" asp-append-version="true"></script>*@
        @*<script src="~/js/jquery-sortable.js" asp-append-version="true"></script>*@

        <script>
        $(document).ready(function ()
        {
            function sortTemplate()
            {
                $('#tools_module').find('.area-drop').addClass('hide').remove();
                $('#tools_module').find('.thumbnail').addClass('hide');
                $('#tools_module').find('.main-func').addClass('show');
            };

            @{
                @*----- จำนวนกลุ่มต้องอิงจาก DB ไม่ใช่ค่าคงที่ 3 ไม่งั้นกลุ่มที่เกินมาจะลากไม่ได้ *@
                var wgGroupCount = ViewBag._db.ExecuteQuery(
                    string.Format("select count(*) as c from {0}", Db.T(_admin.WidgetGroupTable()))).Rows[0]["c"];
                for(int i=0;i<Convert.ToInt32(wgGroupCount);i++)
                {
                    <text>
                    new Sortable(tools_widget_@i,
                    {
                        group:
                        {
                            name: 'shared',
                            pull: 'clone',
                        },
                        animation: 150,
                        sort: false,
                        filter: ".static",
                        draggable: ".itemDrag",
                        onEnd: function (evt)
                        {
                            var itemEl = evt.item;
                            var num_id = 0;
                            $('#tools_module.area-drag .list-group-item').each(function () 
                            {
                                $(itemEl).attr('id', num_id);
                                num_id++;
                            });
                            var selected = 0;
                            var len = $('#tools_module.area-drag .itemDrag').length;
                            onClickMoveUPorDOWN();
                        },
                    });
                    </text>
                }
            } 

            sortableMain = new Sortable(tools_module, 
            {
                group: 'shared',
                animation: 150,
                filter: ".static",
                handle: ".my-handle",
                ghostClass: "sortable-ghost",
                chosenClass: "sortable-chosen",
                dragClass: "sortable-drag",
                onSort: sortTemplate,
                onAdd: function (evt) 
                {
                    slickCarousel();
                    $('.slick-arrow').attr('disabled',true);
                    Refresh_Widget();
                    var this_wg_id = evt.item.innerHTML.trim().substring(36, 39);

                    var lastTwo = this_wg_id.slice(-2);
                    if(lastTwo == '">')
                    {
                        this_wg_id = evt.item.innerHTML.trim().substring(36, 37);
                    }
                    else
                    {
                        var lastOne = this_wg_id.slice(-1);
                        if(lastOne == '"')
                        {
                            this_wg_id = evt.item.innerHTML.trim().substring(36, 38);
                        }
                    } 

                    document.getElementById('itemDrag_' + this_wg_id).style.display = 'none';
                    //$("#icon_setting_" + this_wg_id).trigger("click");
                },
            });
        });
        areaMove = document.getElementById('tools_module');
        function onClickMoveUPorDOWN() 
        {
            var btn_moveDOWN = [...document.getElementsByClassName('icon-sort__down')];
            var btn_moveUP = [...document.getElementsByClassName('icon-sort__up')];
            btn_moveUP.forEach(onebyone => 
            {
                onebyone.addEventListener('click', ChangeUP)
            }) 
            btn_moveDOWN.forEach(onebyone => 
            {
                onebyone.addEventListener('click', ChangeDOWN)
            })
        }
        function ChangeUP() 
        {
            CurrentElement_ToMove = this.parentElement.parentElement.parentElement.parentElement;
            previousElement_ToMove = CurrentElement_ToMove.previousElementSibling;
            if (previousElement_ToMove != null) 
            {
                areaMove.insertBefore(CurrentElement_ToMove, previousElement_ToMove);
            } 
            else 
            {
                return false;
            }
        }
        function ChangeDOWN() 
        {
            CurrentElement_ToMove = this.parentElement.parentElement.parentElement.parentElement;
            nextElement_ToMove = CurrentElement_ToMove.nextElementSibling;
            if (nextElement_ToMove != null) 
            {
                areaMove.insertBefore(nextElement_ToMove, CurrentElement_ToMove);
            } 
            else 
            {
                return false;
            }
        }
        function Refresh_Widget() 
        {
            var order_ref = sortableMain.toArray();
            for(i=0;i<order_ref.length;i++)
            {
                if (order_ref[i].indexOf("_") > -1) 
                {
                    arr_order = order_ref[i].split('_');
                    $('.wgs_' + arr_order[1]).load("/Admin/WidgetAjax?id=" + arr_order[1] + "&box_data=" + document.getElementById("box_data").value + "&box_data_sub=" + document.getElementById("box_data_sub").value);
                }
            }
        }
        var main_iframe_url = '';
        function urliFrame(url) 
        {
            document.getElementById('iframe_full').src = '';
            main_iframe_url = url;
        }
        function iFrameHeight(id) 
        {
            if(id == "32" || id == "33")
            {
                document.getElementById('iframe_full').style.height = '630px';
            }
            else 
            {
                document.getElementById('iframe_full').style.height = '350px';
            }
        }
        var main_iframe_url_manage = '';
        function urliFrame_manage(url) 
        {
            document.getElementById('iframe_full_manage').src = '';
            main_iframe_url_manage = url;
        }
        $(document).ready(function () 
        {
            $('#manage_section').on('shown.bs.modal', function () 
            {
                $(this).find('iframe').attr('src', main_iframe_url_manage);
            });
            $(".group--tools__delete").click(function () 
            {
                $(this).parents('.itemDrag').remove();
            }); 
            @{
                if(row["id"]+"" == "1" && mod.Name == "CMSPage")
                {
                    <text>
                    document.getElementById('nav-tab2-tab').style.display = '';
                    window.scrollTo(0,0);
                    $('#nav-tab2-tab').trigger('click');
                    </text>
                }
            }
        });
        </script>
    }

</div>

