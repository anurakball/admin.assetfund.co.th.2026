@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@using thaicredit_hr_admin.Areas.Admin.Models
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model List<AdminMenuModel>
@{
    AdminHelpers _admin = (AdminHelpers)ViewBag._admin;
}

<style type="text/css">
.slimScrollBar {
    background-color: #fff !important;
    opacity: 0.5 !important;
    border-radius: 10px !important;
    width: 8px !important;
}

.slimScrollRail {
    background-color: #fff !important;
    width: 8px !important;
}
</style>

<!-- [ navigation menu ] start -->
<nav class="pcoded-navbar">
    <div class="navbar-wrapper">
        <div class="navbar-brand header-logo">
            <a href="/" class="b-brand">
                <div class="b-bg" style="width:100px;">
                    @*<i class="feather icon-trending-up"></i>*@
                    <img src="/assets/images/icon/SAM_logo-white-pink.png"/>
                </div> 
                <span class="b-title" style="margin-top:22px;"> &nbsp;Admin</span>
            </a>
            <a class="mobile-menu" id="mobile-collapse" href="javascript:"><span></span></a>
        </div>
        <div class="navbar-content scroll-div">
            <ul class="nav pcoded-inner-navbar">
                @{
                    var site = _admin.WebInfo(_admin._currentWebID, false, false);
                    if (site != null && site.ContainsKey("title"))
                    {
                        <li class="nav-item pcoded-menu-caption" style="font-size: 20px;">
                            <label>@Html.Raw(site["title"])</label>
                        </li>
                        @* ── ลิงก์ไปหน้า front-end ของ microsite นี้ (แสดงเฉพาะ user ของ microsite ที่มี slug) ── *@
                        var msUrl = site.ContainsKey("url") ? site["url"] + "" : "";
                        if (_admin._currentWebID != 0 && !string.IsNullOrWhiteSpace(msUrl))
                        {
                            var frontUrl = (Configuration["FrontURL"] ?? "").TrimEnd('/');
                            <li class="nav-item">
                                <a href="@($"{frontUrl}/th/{msUrl}")" class="nav-link" target="_blank" rel="noopener">
                                    <span class="pcoded-micon"><i class="feather icon-external-link"></i></span>
                                    <span class="pcoded-mtext">ดูหน้าเว็บไซต์ (Microsite)</span>
                                </a>
                            </li>
                        }
                    }
                }

                <li class="nav-item">
                    <a href="/Admin/User/Dashboard" class="nav-link ">
                        <span class="pcoded-micon"><i class="fa-solid fa-desktop"></i></span>
                        <span class="pcoded-mtext">
                            Dashboard
                        </span>
                    </a>
                </li>

                @foreach (var item in Model)
                {
                    @* //----- Check submenu item access ----- *@
                    int subMenu = 0;
                    @if (item.SubMenu != null && item.SubMenu.Count > 0)
                    {
                        foreach (var item2 in item.SubMenu)
                        {
                            if (_admin.checkAccess(_admin.GetModule(item2.ModuleName),
                            HttpContextAccessor.HttpContext.Session.GetInt32("admin_access_id") ?? 0) == true)
                            {
                                subMenu++;
                            }
                        }
                    }
                    @*//---------------------------------------*@

                    @if ((item.Link == "" || _admin.checkAccess(_admin.GetModule(item.ModuleName),
                   HttpContextAccessor.HttpContext.Session.GetInt32("admin_access_id") ?? 0) == true) && subMenu > 0)
                    {
                        <li class="nav-item @(item.SubMenu != null && item.SubMenu.Count > 0 ? "pcoded-hasmenu":"")">
                            <a class="nav-link" href="@(item.Link != "" ? "/Admin/" + item.Link : "javascript:;")">

                                @if (item.Icon != "")
                                {
                                    <span class="pcoded-micon"> <i class="@item.Icon"></i></span>
                                }
                                <span class="pcoded-mtext">@Html.Raw(item.Title)</span>

                            </a>
                            @if (item.SubMenu != null && item.SubMenu.Count > 0)
                            {
                                <ul class="pcoded-submenu">
                                    @foreach (var item2 in item.SubMenu)
                                    {
                                        @if (_admin.checkAccess(_admin.GetModule(item2.ModuleName),
                                       HttpContextAccessor.HttpContext.Session.GetInt32("admin_access_id") ?? 0) == true)
                                        {
                                            @if (item2.Link == "FileManager")
                                            {
                                                <li>
                                                    <a href="javascript:;" data-only-mimes="image" onclick="openElFinderFM('a')">
                                                        @if (item2.Icon != "")
                                                        {
                                                            <span class="pcoded-micon"> <i class="@item2.Icon"></i></span>

                                                        }
                                                        <span class="pcoded-mtext">@Html.Raw(item2.Title)</span>

                                                    </a>
                                                </li>
                                            }
                                            else @if (item2.Link == "GoogleAnalytics")
                                            {
                                                <li>
                                                    <a href="https://analytics.google.com/analytics/web/" target="_blank"
                                                        data-only-mimes="image">
                                                        @if (item2.Icon != "")
                                                        {
                                                            <span class="pcoded-micon"> <i class="@item2.Icon"></i></span>

                                                        }
                                                        <span class="pcoded-mtext">@Html.Raw(item2.Title)</span>

                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a href="@(item2.Link != "" ? "/Admin/" + item2.Link : "javascript:;")">
                                                        @if (item2.Icon != "")
                                                        {
                                                            <span class="pcoded-micon"> <i class="@item2.Icon"></i></span>

                                                        }
                                                        <span class="pcoded-mtext">@Html.Raw(item2.Title)</span>

                                                    </a>
                                                </li>
                                            }
                                        }
                                    }
                                </ul>
                            }
                        </li>
                    }
                }

                <li class="nav-item pcoded-menu-caption">
                    <label>PERSONAL INFORMATION</label>
                </li>
                <li class="nav-item">
                    <a href="/Admin/User/Edit" class="nav-link ">
                        <span class="pcoded-micon"><i class="feather icon-user"></i></span>
                        <span class="pcoded-mtext">View profile
                            <!--Profile edit-->
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Admin/User/ChangePassword" class="nav-link ">
                        <span class="pcoded-micon"><i class="bi bi-key"></i></span>
                        <span class="pcoded-mtext">Change Password</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Admin/User/LastActivity" class="nav-link ">
                        <span class="pcoded-micon"><i class="feather icon-list"></i></span>
                        <span class="pcoded-mtext">Last Activity</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div class="modal fade modal--relogin" id="relogin_section" tabindex="-1"
     aria-labelledby="relogin_section_label"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="reloginForm" method="post" onsubmit="document.getElementById('re_login_submit').style.display = 'none';document.getElementById('re_login_submit_dis').style.display = '';">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="relogin_section_label">คุณหลุดออกจากระบบ กรุณา Login อีกครั้ง</h5>
                    <img src="/images/logo/logo-32.png" alt="icon logo" />
                </div> 
                <div class="modal-body">   
                     <div class="form-group">
                        <label for="username_re" class="form-label">Username</label>
                        <input type="text"
                                class="form-control"
                                id="username_re"
                                name="username_re"
                                required />
                    </div> 
                    <br />
                     <div class="form-group">
                        <label for="password_re" class="form-label">Password</label>
                        <input type="password"
                                class="form-control"
                                id="password_re"
                                name="password_re"
                                required />
                    </div> 
                    @if (ViewBag.webID + "" != "")
                    {
                        <input type="hidden" id="web_id_re" name="web_id" value="@(ViewBag.webID + "")" />
                    }
                    else
                    {
                        <input type="hidden" id="web_id_re" name="web_id" value="0" />
                    } 
                </div> 
                <div class="modal-footer"> 
                    <div class="btn-group btn-group__full">
                        <button type="submit" id="re_login_submit" class="btn btn-primary mx-0">Log In</button>
                        <button type="button" id="re_login_submit_dis" class="btn btn-primary mx-0" disabled style="display:none;">กรุณารอสักครุ่...</button>
                    </div>  
                </div>
            </form>
        </div>
    </div>
</div>

<script> 
function callApi() 
{
    $.get("/Admin/User/AjaxCheckSession").done(function (response) 
    {
        console.log("check session = [" + response + "]");
        if(response == "1")
        {
            try{
                $('#relogin_section').modal('show');

            }
            catch{}
        }
        else
        {
            try{
                $('#relogin_section').modal('hide');
            }
            catch{}
        }
    })
    .always(function () 
    {
        setTimeout(callApi, 5000);
    });
}
callApi();

$('#reloginForm').on('submit', function (e)
{
    e.preventDefault();
    const token = $('input[name="__RequestVerificationToken"]').val();  
    const data = 
    {
        username: $('#username_re').val(),
        password: $('#password_re').val(),
        web_id:   $('#web_id_re').val(),
        relogin:  '1'
    };
    $.ajax({
        url: '/Admin/User/Login',
        type: 'POST',
        headers: {
            'RequestVerificationToken': token
        },
        data: data,
        success: function (res) {

            document.getElementById('re_login_submit').style.display = '';
            document.getElementById('re_login_submit_dis').style.display = 'none';

            console.log("login = [" + res + "]");
            if(res == '1')
            {
                try{
                    $('#relogin_section').modal('hide');
                }
                catch{}
            }
            else
            {
                alert('Username / Password ไม่ถูกต้อง');
            }
        },
        error: function (err) {
            console.log("error = [" + err + "]");
        }
    });
});
</script>

<!-- [ navigation menu ] end -->
