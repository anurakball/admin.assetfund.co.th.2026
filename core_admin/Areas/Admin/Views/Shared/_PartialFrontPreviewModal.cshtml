@*
    Modal ขนาดใหญ่ (modal-xl จัดกลางจอ) สำหรับพรีวิวหน้าเว็บฝั่ง front-end ผ่าน iframe
    คลิกพื้นที่นอก modal หรือกด Esc เพื่อปิดได้ (พฤติกรรม default ของ Bootstrap — ไม่ได้ตั้ง backdrop=static)
    ใช้กับปุ่ม [Preview] ของทุกรายการในหน้า list (ไม่จำกัดสถานะอนุมัติ)
    เปิดด้วย openFrontPreview(baseUrl) ใน wwwroot/js/Admin/admin_site.js

    หมายเหตุ: แยกจาก #previewModal ของ _PartialAdminPreviews.cshtml เพราะตัวนั้น
    ผูกกับการ POST ฟอร์ม #fm_cms ของหน้า Create/Edit ใช้ในหน้า list ไม่ได้
*@
<div class="modal fade" id="frontPreviewModal" tabindex="-1" aria-labelledby="frontPreviewModalLabel" aria-hidden="true">
    @* modal-xl ตรึงความกว้างไว้ 1140px คงที่ ซึ่งเล็กไปสำหรับพรีวิวหน้าเว็บทั้งหน้าบนจอใหญ่
       จึงขยายด้วย max-width แบบ vw ให้ยืดตามจอ แต่ยังเหลือขอบ backdrop ไว้ให้คลิกปิดได้ *@
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width:95vw;">
        <div class="modal-content">
            <div class="modal-header py-2 align-items-center">
                <h5 class="modal-title" id="frontPreviewModalLabel">
                    @* ป้ายบอกว่าที่เห็นคือ "ฉบับร่าง" ไม่ใช่หน้าเว็บจริง — ใช้ได้กับทุกสถานะ
                       (รายการที่อนุมัติแล้ว ฉบับร่างจะเท่ากับหน้าเว็บจริง) *@
                    <i class="bi bi-eye"></i> ตัวอย่างหน้าเว็บ <span class="badge bg-warning text-dark">ข้อมูลฉบับร่าง</span>
                </h5>
                <div class="btn-group btn-group-sm ms-auto me-3" role="group" aria-label="เลือกภาษา">
                    <button type="button" class="btn btn-outline-secondary active" data-preview-lang="th">ไทย</button>
                    <button type="button" class="btn btn-outline-secondary" data-preview-lang="en">อังกฤษ</button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 position-relative">
                @* ห้ามใช้ utility class d-flex ที่นี่ — Bootstrap ประกาศเป็น display:flex !important
                   ทำให้ $.hide() (ที่ใส่ inline display:none) ซ่อนไม่ได้ จึงจัด layout ด้วย inline style แทน *@
                <div id="frontPreviewLoading"
                     style="display:flex;align-items:center;justify-content:center;position:absolute;top:0;left:0;width:100%;height:100%;background:#fff;z-index:2;">
                    <div class="text-center text-muted">
                        <div class="spinner-border" role="status"></div>
                        <div class="mt-2">กำลังโหลดตัวอย่าง...</div>
                    </div>
                </div>
                @* ความสูงต้องเป็นหน่วยจริง (vh) ไม่ใช่ 100% — modal-xl ไม่ได้กำหนดความสูงให้ .modal-content
                   เหมือน modal-fullscreen เปอร์เซ็นต์จึง resolve เป็น auto แล้ว iframe จะยุบเหลือ 0 *@
                <iframe id="frontPreviewFrame" name="frontPreviewFrame" src="about:blank" title="ตัวอย่างหน้าเว็บ"
                        style="width:100%;height:85vh;border:0;display:block;"></iframe>
            </div>
        </div>
    </div>
</div>
