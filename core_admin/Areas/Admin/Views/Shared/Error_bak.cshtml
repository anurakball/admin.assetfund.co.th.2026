@using thaicredit_hr_admin.Areas.Admin.Models
@model ErrorAdminModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = Model.ErrorTitle;
}

<div class="alert @Model.ErrorClass mt-4" role="alert">
    <h4 class="alert-heading">@Model.ErrorTitle</h4>
    <hr>
    <p>@Html.Raw(Model.ErrorDetail)</p>
</div>
