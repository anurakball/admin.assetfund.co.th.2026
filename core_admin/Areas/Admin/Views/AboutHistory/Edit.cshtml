@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var row = (System.Data.DataRow)ViewBag.itemEdit;
    string jsonRow = ((string)ViewBag.itemJSONEdit) ?? "";
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<style>
    .cms-section { border:1px solid #d9d9d9; border-radius:12px; padding:14px 22px 22px; margin-bottom:26px; background:#fff; }
    .cms-section > legend { font-size:1.15rem; font-weight:700; color:#0047B6; width:auto; padding:0 8px; margin-left:-12px; margin-bottom:18px; }
</style>

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()

        <fieldset class="cms-section">
            <legend>ข้อมูลหลัก</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "title",  (row["title"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_title",  (row["en_title"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("คำอธิบาย <span class='fi fi-th'></span>", "t1", (row["t1"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("คำอธิบาย <span class='fi fi-us'></span>", "en_t1", (row["en_t1"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "t2", (row["t2"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_t2", (row["en_t2"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("คำอธิบาย <span class='fi fi-th'></span>", "t3", (row["t3"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputTextArea("คำอธิบาย <span class='fi fi-us'></span>", "en_t3", (row["en_t3"].ToString() ?? "").Trim()))
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputFileManeger("รูปประกอบ <span style='font-weight: normal;color: orange;'>(.webp, .svg, .png, .jpg, .jpeg, .gif  ขนาด 864 x 352)</span>", "t4", (row["t4"].ToString() ?? "").Trim()))
                </div>
            </div>
        </fieldset>

        <fieldset class="cms-section">
            <legend>ไทม์ไลน์ (ปีย้อนหลัง)</legend>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "t5", (row["t5"].ToString() ?? "").Trim()))
                </div>
                <div class="col-lg-6 col-md-6 mb-3">
                    @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_t5", (row["en_t5"].ToString() ?? "").Trim()))
                </div>
            </div>

        @{
            int this_no = 5;

            for(int i=1;i<=8;i++)
            {
                <fieldset style="border:1px solid #999; padding : 20px; border-radius: 10px;">
                    <legend><h3>ปีย้อนหลัง : #@i</h3></legend>
                    @{
                        this_no = this_no + 1;
                    }
                    <div class="row">
                        <div class="col-lg-6 col-md-6 mb-3">
                            @Html.Raw(_admin.InputText("ปี <span class='fi fi-th'></span>", "t" + this_no, (row["t" + this_no].ToString() ?? "").Trim()))
                        </div>
                        <div class="col-lg-6 col-md-6 mb-3">
                            @Html.Raw(_admin.InputText("ปี <span class='fi fi-us'></span>", "en_t" + this_no, (row["en_t" + this_no].ToString() ?? "").Trim()))
                        </div>
                    </div>
                    @{
                        this_no = this_no + 1;
                    }
                    <div class="row">
                        <div class="col-lg-6 col-md-6 mb-3">
                            @Html.Raw(_admin.InputTextArea("คำอธิบาย <span class='fi fi-th'></span>", "t" + this_no, (row["t" + this_no].ToString() ?? "").Trim()))
                        </div>
                        <div class="col-lg-6 col-md-6 mb-3">
                            @Html.Raw(_admin.InputTextArea("คำอธิบาย <span class='fi fi-us'></span>", "en_t" + this_no, (row["en_t" + this_no].ToString() ?? "").Trim()))
                        </div>
                    </div>
                </fieldset>
                <br />
            }
        }
        </fieldset>
         
         


        @{
            string issue_date = ""; try { issue_date = ((DateTime)row["issue_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { issue_date = System.DateTime.Now.ToString("dd/MM/yyyy HH:mm"); }
            string expiry_date = ""; try { expiry_date = ((DateTime)row["expiry_date"]).ToLocalTime().ToString("dd/MM/yyyy HH:mm"); } catch { expiry_date = System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm"); }
        }
        <input type="hidden" name="issue_date_config" value="1" />
        <input type="hidden" name="issue_date" value="@issue_date" />
        <input type="hidden" name="expiry_date" value="@expiry_date" />





        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")
@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>
    var modConfig = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(mod_config))
    var jsonRow = @Html.Raw(jsonRow)
    function sConfirmCustom(form) {

        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0047B6',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }
    
    $(document).ready(function() {

        checkLockedRow(modConfig, jsonRow);

    });
</script>
}