<script>
    var SVG_HEALTHY = '<svg width="16" height="16" viewBox="0 0 24 24" fill="#22c55e" stroke="none"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    var SVG_WARNING = '<svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" stroke="none"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13" stroke="white" stroke-width="2" stroke-linecap="round"/><line x1="12" y1="17" x2="12.01" y2="17" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>';
    var SVG_CRITICAL = '<svg width="16" height="16" viewBox="0 0 24 24" fill="#ef4444" stroke="none"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15" stroke="white" stroke-width="2" stroke-linecap="round"/><line x1="9" y1="9" x2="15" y2="15" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>';

    function thaiNow() {
        var now = new Date();
        return now.toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: 'numeric' })
             + ' ' + now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    }

    function renderBadge(status) {
        if (status === 'healthy')  return '<span class="badge-healthy">'  + SVG_HEALTHY  + 'Healthy</span>';
        if (status === 'warning')  return '<span class="badge-warning">'  + SVG_WARNING  + 'Warning</span>';
        return '<span class="badge-critical">' + SVG_CRITICAL + 'Critical</span>';
    }

    function renderResp(ms, status) {
        var cls = status === 'healthy' ? 'resp-green' : (status === 'warning' ? 'resp-yellow' : 'resp-red');
        return '<span class="' + cls + '">' + ms.toLocaleString() + ' ms</span>';
    }

    function toggleWsInfo(btn) {
        var panel = document.getElementById('wsExpandInfo');
        var open  = panel.style.display !== 'none';
        panel.style.display = open ? 'none' : 'block';
        btn.innerHTML = open ? '&#8964;' : '&#8963;';
    }

    function checkWebServerStatus() {
        fetch('/Admin/ServerStatus/CheckWebServerStatus')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('wsStatus').innerHTML   = renderBadge(data.status);
                document.getElementById('wsDetail').textContent = data.detail;
                document.getElementById('wsDetail').style.color    = '';
                document.getElementById('wsDetail').style.fontSize = '';
                document.getElementById('wsRespMs').innerHTML   = renderResp(data.responseMs, data.status);
                document.getElementById('hcDate2').textContent  = thaiNow();
                document.getElementById('wsInfoUptime').textContent  = 'Uptime: ' + data.uptimeStr;
                document.getElementById('wsInfoMem').textContent     = 'Memory: ' + data.memMb + ' MB';
                document.getElementById('wsInfoThreads').textContent = 'Threads: ' + data.threadCount;
                document.getElementById('wsInfoEnv').textContent     = 'Environment: ' + data.environment;
                updateOverviewCounts();
            })
            .catch(function() {
                document.getElementById('wsStatus').innerHTML   = renderBadge('critical');
                document.getElementById('wsDetail').textContent = 'ไม่สามารถเรียก API ได้';
                document.getElementById('wsRespMs').innerHTML   = renderResp(0, 'critical');
                document.getElementById('hcDate2').textContent  = thaiNow();
                updateOverviewCounts();
            });
    }

    function checkDbStatus() {
        fetch('/Admin/ServerStatus/CheckDbStatus')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('dbStatus').innerHTML  = renderBadge(data.status);
                document.getElementById('dbDetail').textContent = data.detail;
                document.getElementById('dbDetail').style.color  = '';
                document.getElementById('dbDetail').style.fontSize = '';
                document.getElementById('dbRespMs').innerHTML  = renderResp(data.responseMs, data.status);
                document.getElementById('hcDate1').textContent = thaiNow();
                updateOverviewCounts();
            })
            .catch(function() {
                document.getElementById('dbStatus').innerHTML   = renderBadge('critical');
                document.getElementById('dbDetail').textContent = 'ไม่สามารถเรียก API ได้';
                document.getElementById('dbRespMs').innerHTML   = renderResp(0, 'critical');
                document.getElementById('hcDate1').textContent  = thaiNow();
                updateOverviewCounts();
            });
    }

    function updateOverviewCounts() {
        var rows = document.querySelectorAll('.hc-table tbody tr');
        var healthy = 0, warning = 0, critical = 0;
        rows.forEach(function(row) {
            var td = row.querySelector('td:nth-child(2)');
            if (!td) return;
            if (td.querySelector('.badge-healthy'))  healthy++;
            else if (td.querySelector('.badge-warning'))  warning++;
            else if (td.querySelector('.badge-critical')) critical++;
        });
        document.getElementById('cntHealthy').textContent  = healthy;
        document.getElementById('cntWarning').textContent  = warning;
        document.getElementById('cntCritical').textContent = critical;
        document.getElementById('cntTotal').textContent    = healthy + warning + critical;
    }

    (function () {
        var display = thaiNow();
        document.getElementById('hcLastChecked').textContent = display;
        ['hcDate2','hcDate3','hcDate4','hcDate5','hcDate6','hcDate7','hcDate8'].forEach(function(id){
            var el = document.getElementById(id);
            if (el) el.textContent = display;
        });
        checkDbStatus();
        checkWebServerStatus();
    })();
</script>
