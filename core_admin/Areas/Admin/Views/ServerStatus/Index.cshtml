@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
    var searchInputVal = (Dictionary<string, string>)ViewBag.searchInputVal;
}
@section NavbarBack{
    @if (mod_config.IsCMSPage == true && mod_config.FieldCMSPage != "" && _session.GetInt32("admin_" + mod.Name + "_parent_lv").HasValue && _session.GetInt32("admin_" + mod.Name + "_parent_lv") > 1)
    {
        int parent_id = _admin.getParentID(mod, Convert.ToInt32(_session.GetString("admin_" + mod.Name + "_search_" + mod_config.FieldCMSPage)));
        @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}?{1}={2}", mod.Name, mod_config.FieldCMSPage, parent_id) })
    }
}
@await Component.InvokeAsync("AdminBreadcrumb",  new { Module = mod })

<style>
    .hc-wrapper { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; min-height: 100vh; padding-bottom: 40px; }
    .hc-topbar { background: #1a1f2e; color: #fff; display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; }
    .hc-topbar-left { display: flex; align-items: center; gap: 10px; font-size: 1.25rem; font-weight: 600; }
    .hc-topbar-left svg { color: #4ade80; }
    .hc-topbar-right { display: flex; align-items: center; gap: 14px; font-size: 0.85rem; color: #aab; }
    .hc-btn-refresh { background: transparent; border: 1.5px solid #4a9eff; color: #4a9eff; border-radius: 6px; padding: 6px 18px; font-size: 0.85rem; cursor: pointer; transition: all .2s; }
    .hc-btn-refresh:hover { background: #4a9eff; color: #fff; }
    .hc-body { max-width: 1180px; margin: 0 auto; padding: 28px 20px 0; }
    /* Status Banner */
    .hc-banner { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; display: flex; align-items: center; padding: 28px 36px; margin-bottom: 28px; gap: 24px; position: relative; overflow: hidden; }
    .hc-banner-icon { background: #22c55e; border-radius: 50%; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .hc-banner-icon svg { color: #fff; width: 36px; height: 36px; }
    .hc-banner-text h2 { margin: 0; font-size: 1.6rem; font-weight: 700; color: #16a34a; }
    .hc-banner-text p { margin: 4px 0 0; color: #4b5563; font-size: 0.95rem; }
    .hc-banner-illus { margin-left: auto; opacity: 0.18; }
    /* Overview Cards */
    .hc-section-title { font-size: 1rem; font-weight: 700; color: #1a1f2e; margin-bottom: 14px; }
    .hc-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px; }
    .hc-card { background: #fff; border-radius: 10px; padding: 22px 20px; display: flex; align-items: center; gap: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.07); }
    .hc-card-icon { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .hc-card-icon.green { background: #22c55e; }
    .hc-card-icon.yellow { background: #f59e0b; }
    .hc-card-icon.red { background: #ef4444; }
    .hc-card-icon.blue { background: #3b82f6; }
    .hc-card-info .num { font-size: 1.8rem; font-weight: 700; color: #1a1f2e; line-height: 1; }
    .hc-card-info .label { font-size: 0.88rem; font-weight: 600; margin: 2px 0; }
    .hc-card-info .label.green { color: #16a34a; }
    .hc-card-info .label.yellow { color: #d97706; }
    .hc-card-info .label.red { color: #dc2626; }
    .hc-card-info .label.blue { color: #2563eb; }
    .hc-card-info .sub { font-size: 0.78rem; color: #6b7280; }
    /* Table */
    .hc-table-wrap { background: #fff; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.07); overflow: hidden; margin-bottom: 20px; }
    .hc-table { width: 100%; border-collapse: collapse; }
    .hc-table thead th { background: #f9fafb; padding: 12px 16px; font-size: 0.82rem; color: #6b7280; font-weight: 600; text-align: left; border-bottom: 1px solid #e5e7eb; }
    .hc-table tbody tr { border-bottom: 1px solid #f3f4f6; transition: background .15s; }
    .hc-table tbody tr:last-child { border-bottom: none; }
    .hc-table tbody tr:hover { background: #f9fafb; }
    .hc-table td { padding: 14px 16px; font-size: 0.88rem; color: #374151; vertical-align: middle; }
    .hc-comp-name { display: flex; align-items: center; gap: 10px; font-weight: 500; }
    .hc-comp-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
    .badge-healthy { color: #16a34a; font-weight: 600; display: flex; align-items: center; gap: 5px; }
    .badge-warning { color: #d97706; font-weight: 600; display: flex; align-items: center; gap: 5px; }
    .badge-critical { color: #dc2626; font-weight: 600; display: flex; align-items: center; gap: 5px; }
    .resp-green { color: #16a34a; font-weight: 600; }
    .resp-yellow { color: #d97706; font-weight: 600; }
    .resp-red { color: #dc2626; font-weight: 600; }
    .hc-expand-btn { background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px 8px; border-radius: 4px; }
    .hc-expand-btn:hover { color: #374151; background: #f3f4f6; }
    .hc-footer-note { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 12px 18px; font-size: 0.82rem; color: #1d4ed8; display: flex; align-items: center; gap: 8px; }
    @@media (max-width: 900px) { .hc-cards { grid-template-columns: repeat(2,1fr); } }
    @@media (max-width: 560px) { .hc-cards { grid-template-columns: 1fr 1fr; } }
</style>

