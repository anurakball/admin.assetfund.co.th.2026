@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
}

@section NavbarBack{
    @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}", mod.Name) })
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

<script src="/js/spectrum.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/Admin/spectrum.min.css">

<div class="form-wrapper">
    <form method="post" id="fm_cms" onsubmit="return sConfirmCustom(this);" class="">
        @Html.AntiForgeryToken()
         
        @{
            if (mod_config.TableCate != null && mod_config.TableCate != "")
            {
                <div class="row">
                    @{
                        string cat_id = _session.GetString("admin_" + mod.Name + "_search_" + mod_config.TableCateField) ?? "0";
                        <div class="col-12 mb-3">
                            @Html.Raw(
                            _admin.InputSelectDB(
                            mod_config.TableCateLabel,
                            mod_config.TableCateField,
                            cat_id,
                            showAllOption: true,
                            mod_config.TableCate,
                            value_field: "id",
                            text_field: mod_config.TableCateTitle,
                            order_by: mod_config.TableCateOrderby,
                            sort: mod_config.TableCateSort,
                            txtAllOption: "เลือก",
                            ModuleID: mod_config.TableCateModuleID
                            ))
                        </div>
                    }
                </div>
            }
        }

        <div class="row">
            @{ 
                <div class="col-12 mb-3">
                    @Html.Raw(
                    _admin.InputSelectDB(
                    "วิธีการจัดซื้อ",
                    "page_type",
                    "0",
                    showAllOption: true,
                    "web_core_group",
                    value_field: "id",
                    text_field: "title",
                    order_by: "sort",
                    sort: "asc",
                    txtAllOption: "เลือก",
                    ModuleID: "11"
                    ))
                </div>
            }
        </div>

        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputDate("วันที่ประกาศ", "date_news", System.DateTime.Now.ToString("dd/MM/yyyy")))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">

                <div class="field">
                    <label for="id_des" class="form-label">ปีงบประมาณ</label>
                    <select class="form-select" id="id_des" name="des">
                        @{
                            int this_y = Convert.ToInt32(DateTime.Now.Year.ToString());
                            if (this_y < 2500)
                            {
                                this_y = this_y + 543;
                            }
                            int this_y_1 = this_y - 10;
                            int this_y_2 = this_y;
                            int this_y_3 = this_y + 10;

                            for (int y = this_y_1; y <= this_y_3; y++)
                            {
                                string this_select = "";
                                if (y == this_y_2)
                                {
                                    this_select = " selected ";
                                }

                                <option value="@y" @this_select>@y</option>
                            }
                        }
                    </select>
                </div>
                 
            </div>
        </div>
      
        <div class="row"> 
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-th'></span>", "title", ""))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("หัวข้อ <span class='fi fi-us'></span>", "en_title", ""))
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("URL Friendly <span class='fi fi-th'></span>", "seo_url", "", "", 200))
            </div>
            <div class="col-lg-6 col-md-6 mb-3">
                @Html.Raw(_admin.InputText("URL Friendly <span class='fi fi-us'></span>", "en_seo_url", "", "", 200))
            </div>
        </div>


        @{
            for(int i=1;i<=6;i++)
            {
                <hr />
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("ชื่อไฟล์ #" + i + " &nbsp; <span class='fi fi-th'></span>", "file" + i + "_title", ""))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputText("ชื่อไฟล์ #" + i + " <span class='fi fi-us'></span>", "en_file" + i + "_title", ""))
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputFileManeger("ไฟล์ดาวน์โหลด #" + i + " &nbsp; <span class='fi fi-th'></span> &nbsp;  <span style='font-weight: normal;color: orange;'>(.pdf ไม่เกิน 50MB)</span>", "file"+i, "", "application/pdf"))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputFileManeger("ไฟล์ดาวน์โหลด #" + i + " &nbsp; <span class='fi fi-us'></span> &nbsp;  <span style='font-weight: normal;color: orange;'>(.pdf ไม่เกิน 50MB)</span>", "en_file"+i, "", "application/pdf"))
                    </div>
                </div>
                
            }
        }
          
        <br />

            <script>
                $(document).ready(function () {
                    $(":input[name='issue_date_config']").click(function () {
                        if ($(this).val() == '2') {
                            $('#div_id_issue_date').stop(true, false).slideDown();
                        }
                        else {
                            $('#div_id_issue_date').stop(true, false).slideUp();
                        }
                    });
                });
            </script>
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-3">
                    <div class="field">
                        <label class="form-label">วันที่แสดงผล</label>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="issue_date_config" id="id_issue_date_config_1" value="1" checked>
                                    <label class="form-check-label" for="id_issue_date_config_1">
                                        แสดงตลอดเวลา
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="issue_date_config" id="id_issue_date_config_2" value="2">
                                    <label class="form-check-label" for="id_issue_date_config_2">
                                        กำหนดเอง
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="" id="div_id_issue_date" style="display:none;">
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputDateTime("วันที่แสดงผล", "issue_date", System.DateTime.Now.ToString("dd/MM/yyyy HH:mm")))
                    </div>
                    <div class="col-lg-6 col-md-6 mb-3">
                        @Html.Raw(_admin.InputDateTime("วันที่สิ้นสุดแสดงผล", "expiry_date", System.DateTime.Now.AddYears(1).ToString("dd/MM/yyyy HH:mm")))
                    </div>
                </div>
            </div>


        @await Component.InvokeAsync("AdminBtnSave", new { linkClose = "/Admin/" + mod.Name })
    </form>
</div>

@await Component.InvokeAsync("LinkHelper")

@section Scripts{
<link rel="stylesheet" href="~/lib/flag-icons-main/css/flag-icons.min.css" />
<script>

    function sConfirmCustom(form) {

        if (document.getElementById('id_issue_date_config_2').checked == true) {
            if (
                $('#id_issue_date').val() != '' && $('#id_expiry_date').val() != '' &&
                $('#id_issue_date').datetimepicker('getValue') > $('#id_expiry_date').datetimepicker('getValue')
            ) {
                sAlert("วันที่ไม่ถูกต้อง", "วันที่สิ้นสุด ต้องมากกว่า วันที่แสดงผล", "warning");
                return false;
            }
        }

        // Validate required fields
        var titleField = $('[name="title"]');
        if (titleField.length > 0 && titleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            titleField.focus();
            return false;
        }
        var enTitleField = $('[name="en_title"]');
        if (enTitleField.length > 0 && enTitleField.val().trim() === '') {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกข้อมูล', text: 'กรุณากรอก EN Title ก่อนบันทึก', confirmButtonText: 'ตกลง' });
            enTitleField.focus();
            return false;
        }
        if ($('#id_seo_url').val().trim() === '') {
            sAlert("กรุณากรอกข้อมูล", "กรุณากรอก URL Friendly (TH)", "warning");
            $('#id_seo_url').focus();
            return false;
        }
        if ($('#id_en_seo_url').val().trim() === '') {
            sAlert("กรุณากรอกข้อมูล", "กรุณากรอก URL Friendly (EN)", "warning").then(() => { $('#id_en_seo_url').focus(); });
            return false;
        }
        Swal.fire({
            title: 'ยืนยัน ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0047B6',
            cancelButtonColor: '#BC1320',
            confirmButtonText: 'ใช่',
            cancelButtonText: 'ปิด',
            showClass: {
                popup: 'animate__animated animate__bounceIn'
            },
            hideClass: {
                popup: 'animate__animated animate__bounceOut'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            } else {
                return false;
            }
        });
        return false;
    }

    //----- Add fn addHouse
    Date.prototype.addHours = function(h) {
        this.setTime(this.getTime() + (h*60*60*1000));
        return this;
    }
    Date.prototype.addMinutes = function(m) {
        this.setTime(this.getTime() + (m*60*1000));
        return this;
    }

    $(document).ready(function() {

        $('#id_seo_url').on('keyup', function () {
            var val = replace_for_url(document.getElementById('id_seo_url').value);
            document.getElementById('id_seo_url').value = val.replace(/\//g, '');
        });
        $('#id_en_seo_url').on('keyup', function () {
            var val = replace_for_url(document.getElementById('id_en_seo_url').value);
            document.getElementById('id_en_seo_url').value = val.replace(/\//g, '');
        });
        $('#id_seo_url').on('blur', function () {
            var val = replace_for_url($(this).val().trim());
            val = val.replace(/\//g, '');
            val = val.replace(/[^a-zA-Z0-9ก-๙\-_.]/g, '-');
            val = val.replace(/-{2,}/g, '-');
            val = val.replace(/^-+|-+$/g, '');
            val = val.toLowerCase();
            $(this).val(val);
        });
        $('#id_en_seo_url').on('blur', function () {
            var val = replace_for_url($(this).val().trim());
            val = val.replace(/\//g, '');
            val = val.replace(/[^a-zA-Z0-9ก-๙\-_.]/g, '-');
            val = val.replace(/-{2,}/g, '-');
            val = val.replace(/^-+|-+$/g, '');
            val = val.toLowerCase();
            $(this).val(val);
        });
        $('#id_title').on('blur', function () {
            if ($('#id_seo_url').val().trim() === '') {
                $('#id_seo_url').val($(this).val());
                $('#id_seo_url').trigger('blur');
            }
        });
        $('#id_en_title').on('blur', function () {
            if ($('#id_en_seo_url').val().trim() === '') {
                $('#id_en_seo_url').val($(this).val());
                $('#id_en_seo_url').trigger('blur');
            }
        });

        //----- คัดลอกค่าจากช่องภาษาไทย -> ภาษาอังกฤษ อัตโนมัติ (ไม่แปล)
        //      เติมให้เฉพาะกรณีช่องภาษาอังกฤษยังว่าง เพื่อไม่ทับค่าที่ผู้ใช้พิมพ์เอง
        function copyThToEn(th_id, en_id) {
            var $th = $('#' + th_id), $en = $('#' + en_id);
            if ($th.length === 0 || $en.length === 0) return false;
            var val = ($th.val() || '').trim();
            if (val === '') return false;
            if (($en.val() || '').trim() !== '') return false;
            $en.val(val);
            return true;
        }

        // หัวข้อ TH -> EN (แล้วให้ EN ไปสร้าง URL Friendly EN ต่อ)
        $('#id_title').on('blur', function () {
            if (copyThToEn('id_title', 'id_en_title')) {
                $('#id_en_title').trigger('blur');
            }
        });

        // URL Friendly TH -> EN (ผ่าน blur ของ EN เพื่อจัดรูปแบบให้เหมือนกัน)
        $('#id_seo_url').on('blur', function () {
            if (copyThToEn('id_seo_url', 'id_en_seo_url')) {
                $('#id_en_seo_url').trigger('blur');
            }
        });

        // ช่องไฟล์ดาวน์โหลดถูกเซ็ตค่าจาก elFinder ด้วย .val() ซึ่งไม่ยิง event ใด ๆ
        // จึงดักที่ property setter ของ input ตัวนั้นโดยตรง
        function watchValueSet(input_id, callback) {
            var el = document.getElementById(input_id);
            if (!el || el._valueWatched) return;
            el._valueWatched = true;
            var desc = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
            Object.defineProperty(el, 'value', {
                configurable: true,
                enumerable: true,
                get: function () { return desc.get.call(this); },
                set: function (v) { desc.set.call(this, v); callback(); }
            });
        }

        // ชื่อไฟล์ #1-6 และ ไฟล์ดาวน์โหลด #1-6 : TH -> EN
        for (var i = 1; i <= 6; i++) {
            (function (n) {
                $('#id_file' + n + '_title').on('blur', function () {
                    copyThToEn('id_file' + n + '_title', 'id_en_file' + n + '_title');
                });

                var copyFile = function () {
                    if (copyThToEn('id_file' + n, 'id_en_file' + n)) {
                        checkFileFM('id_en_file' + n);
                        $('#id_en_file' + n + '_del').show();
                    }
                };
                $('#id_file' + n).on('blur change', copyFile);
                watchValueSet('id_file' + n, copyFile);
            })(i);
        }

        setTimeout(function(){
            $(':input[name="issue_date"]').datetimepicker("destroy");
            $(':input[name="issue_date"]').datetimepicker({
                format: 'd/m/Y H:i',
                minDate: 0,
                onClose: function(current_time, $input){
                    //console.log('input value', $input.datetimepicker('getValue'));
                    //console.log('new Date()', new Date().addHours(-1));
                    if ($input.val() != '' && $input.datetimepicker('getValue') < new Date().addHours(-1)) {
                        $input.val('');
                        sAlert("วันที่ไม่ถูกต้อง", "ไม่สามารถเลือกวันที่ น้อยวันที่ปัจจุบันได้", "warning");
                        //console.log('condition', ($input.val() != '' && $input.datetimepicker('getValue') < new Date().addHours(-1)));
                    }
                },
            });
        },500);
    });
</script>
}