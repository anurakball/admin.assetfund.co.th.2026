@using System.Data
@using Microsoft.AspNetCore.Http
@using thaicredit_hr_admin.Areas.Admin.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var mod = (Module)ViewBag.Module;
    var mod_config = mod.Config;
    var _utility = (Utility)ViewBag._utility;
    var _admin = (AdminHelpers)ViewBag._admin;
    var _session = (ISession)ViewBag._session;
    var _db = (DBHelper)ViewBag._db;
    var searchInputVal = (Dictionary<string, string>)ViewBag.searchInputVal;
}

@section NavbarBack{
    @if (mod_config.IsCMSPage == true && mod_config.FieldCMSPage != "" && _session.GetInt32("admin_" + mod.Name + "_parent_lv").HasValue && _session.GetInt32("admin_" + mod.Name + "_parent_lv") > 1)
    {
        int parent_id = _admin.getParentID(mod, Convert.ToInt32(_session.GetString("admin_" + mod.Name + "_search_" + mod_config.FieldCMSPage)));
        @await Component.InvokeAsync("AdminNavbarBack", new { linkBack = string.Format("/Admin/{0}?{1}={2}", mod.Name, mod_config.FieldCMSPage, parent_id) })
    }
}

@await Component.InvokeAsync("AdminBreadcrumb", new { Module = mod })

@{
    var _q = HttpContextAccessor.HttpContext!.Request.Query;
    string Q(string key) => _q.ContainsKey(key) ? (_q[key].ToString() ?? "").Trim() : "";

    var qMember    = Q("q_member");
    var qService   = Q("q_service");
    var qApi       = Q("q_api");
    var qModel     = Q("q_model");
    var qSuccess   = Q("q_success");
    var qIp        = Q("q_ip");
    var qDateStart = Q("q_date_start");
    var qDateEnd   = Q("q_date_end");

    int curPage = int.TryParse(Q("page"),    out var _cp) && _cp > 0 ? _cp : 1;
    int perPage = int.TryParse(Q("perpage"), out var _pp) && _pp >= 5 ? _pp : 20;
    int offset  = (curPage - 1) * perPage;

    var where = new System.Text.StringBuilder("WHERE 1=1");
    var prms  = new Dictionary<string, object>();

    if (!string.IsNullOrEmpty(qMember)) {
        where.Append(" AND (CAST(l.member_id AS VARCHAR) = @p_mid OR l.username ILIKE @p_mlike)");
        prms["p_mid"] = qMember; prms["p_mlike"] = "%" + qMember + "%";
    }
    if (!string.IsNullOrEmpty(qService))  { where.Append(" AND l.service_name = @p_svc");       prms["p_svc"]  = qService; }
    if (!string.IsNullOrEmpty(qApi))      { where.Append(" AND l.api_name ILIKE @p_api");        prms["p_api"]  = "%" + qApi + "%"; }
    if (!string.IsNullOrEmpty(qModel))    { where.Append(" AND l.model_name ILIKE @p_model");    prms["p_model"] = "%" + qModel + "%"; }
    if (!string.IsNullOrEmpty(qIp))       { where.Append(" AND l.request_ip ILIKE @p_ip");       prms["p_ip"]   = "%" + qIp + "%"; }
    if (qSuccess == "true")               { where.Append(" AND l.is_success = TRUE"); }
    else if (qSuccess == "false")         { where.Append(" AND l.is_success = FALSE"); }

    if (!string.IsNullOrEmpty(qDateStart)) {
        try { var p = qDateStart.Split('/'); var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0])); where.Append(" AND l.created_at >= @p_ds"); prms["p_ds"] = d; } catch {}
    }
    if (!string.IsNullOrEmpty(qDateEnd)) {
        try { var p = qDateEnd.Split('/'); var d = new DateTime(int.Parse(p[2]), int.Parse(p[1]), int.Parse(p[0])).AddDays(1); where.Append(" AND l.created_at < @p_de"); prms["p_de"] = d; } catch {}
    }

    var w = where.ToString();

    var dtCount = _db.ExecuteQuery($"SELECT COUNT(*) AS cnt FROM api_service_logs l {w}", prms);
    long totalRows  = dtCount.Rows.Count > 0 ? Convert.ToInt64(dtCount.Rows[0]["cnt"]) : 0;
    int  totalPages = (int)Math.Ceiling((double)totalRows / perPage);

    var dtLogs = _db.ExecuteQuery($@"
        SELECT l.id, l.created_at,
               l.service_name, l.api_name,
               l.member_id, l.username,
               l.request_method, l.request_ip, l.request_user_agent,
               l.request_headers, l.request_body,
               l.response_status, l.response_body,
               l.is_success, l.error_message,
               l.duration_ms,
               l.model_name, l.prompt_tokens, l.completion_tokens, l.total_tokens,
               l.reference_code, l.remark
        FROM api_service_logs l
        {w}
        ORDER BY l.created_at DESC
        LIMIT {perPage} OFFSET {offset}", prms);

    var dtServices = _db.ExecuteQuery(
        "SELECT DISTINCT service_name FROM api_service_logs WHERE service_name IS NOT NULL ORDER BY service_name");

    var dtStats = _db.ExecuteQuery($@"
        SELECT
            COUNT(*) FILTER (WHERE l.is_success = TRUE)  AS cnt_success,
            COUNT(*) FILTER (WHERE l.is_success = FALSE) AS cnt_error,
            COALESCE(SUM(l.total_tokens), 0)             AS sum_tokens,
            COALESCE(AVG(l.duration_ms), 0)::INTEGER     AS avg_duration
        FROM api_service_logs l {w}", prms);

    long cntSuccess   = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_success"])  : 0;
    long cntError     = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["cnt_error"])    : 0;
    long sumTokens    = dtStats.Rows.Count > 0 ? Convert.ToInt64(dtStats.Rows[0]["sum_tokens"])   : 0;
    int  avgDuration  = dtStats.Rows.Count > 0 ? Convert.ToInt32(dtStats.Rows[0]["avg_duration"]) : 0;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(qMember))    qsParts.Add("q_member="    + Uri.EscapeDataString(qMember));
    if (!string.IsNullOrEmpty(qService))   qsParts.Add("q_service="   + Uri.EscapeDataString(qService));
    if (!string.IsNullOrEmpty(qApi))       qsParts.Add("q_api="       + Uri.EscapeDataString(qApi));
    if (!string.IsNullOrEmpty(qModel))     qsParts.Add("q_model="     + Uri.EscapeDataString(qModel));
    if (!string.IsNullOrEmpty(qSuccess))   qsParts.Add("q_success="   + Uri.EscapeDataString(qSuccess));
    if (!string.IsNullOrEmpty(qIp))        qsParts.Add("q_ip="        + Uri.EscapeDataString(qIp));
    if (!string.IsNullOrEmpty(qDateStart)) qsParts.Add("q_date_start="+ Uri.EscapeDataString(qDateStart));
    if (!string.IsNullOrEmpty(qDateEnd))   qsParts.Add("q_date_end="  + Uri.EscapeDataString(qDateEnd));
    qsParts.Add("perpage=" + perPage);
    var baseQs   = string.Join("&", qsParts);
    var exportQs = string.Join("&", qsParts.Where(p => !p.StartsWith("perpage=")));

    int rowNum = offset + 1;

    var logDataMap = new Dictionary<string, object>();
    foreach (DataRow lr in dtLogs.Rows) {
        var _at  = lr["created_at"] != DBNull.Value ? Convert.ToDateTime(lr["created_at"]) : DateTime.MinValue;
        var _dur = lr["duration_ms"] != DBNull.Value ? Convert.ToInt32(lr["duration_ms"]) : -1;
        logDataMap[lr["id"].ToString()] = new {
            id               = lr["id"]?.ToString(),
            created_at       = _at != DateTime.MinValue ? _at.ToString("dd/MM/yyyy HH:mm:ss") : "",
            service_name     = lr["service_name"]?.ToString() ?? "",
            api_name         = lr["api_name"]?.ToString() ?? "",
            member_id        = lr["member_id"]?.ToString() ?? "",
            username         = lr["username"]?.ToString() ?? "",
            request_method   = lr["request_method"]?.ToString() ?? "",
            request_ip       = lr["request_ip"]?.ToString() ?? "",
            user_agent       = lr["request_user_agent"]?.ToString() ?? "",
            request_headers  = lr["request_headers"]?.ToString() ?? "",
            request_body     = lr["request_body"]?.ToString() ?? "",
            response_status  = lr["response_status"] != DBNull.Value ? Convert.ToInt32(lr["response_status"]) : 0,
            response_body    = lr["response_body"]?.ToString() ?? "",
            is_success       = lr["is_success"] != DBNull.Value && Convert.ToBoolean(lr["is_success"]),
            error_message    = lr["error_message"]?.ToString() ?? "",
            duration         = _dur,
            model_name       = lr["model_name"]?.ToString() ?? "",
            prompt_tokens    = lr["prompt_tokens"] != DBNull.Value ? Convert.ToInt32(lr["prompt_tokens"]) : 0,
            completion_tokens= lr["completion_tokens"] != DBNull.Value ? Convert.ToInt32(lr["completion_tokens"]) : 0,
            total_tokens     = lr["total_tokens"] != DBNull.Value ? Convert.ToInt32(lr["total_tokens"]) : 0,
            reference_code   = lr["reference_code"]?.ToString() ?? "",
            remark           = lr["remark"]?.ToString() ?? ""
        };
    }
    var logDataJson = Newtonsoft.Json.JsonConvert.SerializeObject(logDataMap);
}

@* ===================== SEARCH FORM ===================== *@
<div class="form-wrapper mb-4">
    <form method="get" id="formSearch" class="form" autocomplete="off">
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">สมาชิก (ID / Username)</label>
                    <input type="text" name="q_member" value="@qMember" class="form-control" placeholder="ค้นหา..." />
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Service</label>
                    <select name="q_service" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (DataRow r in dtServices.Rows) {
                            var svc = r["service_name"].ToString();
                            <option value="@svc" @(qService == svc ? "selected" : "")>@svc</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">API Name</label>
                    <input type="text" name="q_api" value="@qApi" class="form-control" placeholder="/v1/chat/completions" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">Model</label>
                    <input type="text" name="q_model" value="@qModel" class="form-control" placeholder="gpt-4o, claude-3..." />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">สถานะ</label>
                    <select name="q_success" class="form-select">
                        <option value="">-- ทั้งหมด --</option>
                        <option value="true"  @(qSuccess == "true"  ? "selected" : "")>สำเร็จ (Success)</option>
                        <option value="false" @(qSuccess == "false" ? "selected" : "")>ผิดพลาด (Error)</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">IP Address</label>
                    <input type="text" name="q_ip" value="@qIp" class="form-control" placeholder="192.168.x.x" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="field">
                    <label class="form-label">แสดงหน้าละ</label>
                    <select name="perpage" class="form-select">
                        @foreach (var n in new[] { 10, 20, 50, 100 }) {
                            <option value="@n" @(perPage == n ? "selected" : "")>@n รายการ</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 mb-3">
                <div class="field">
                    <label class="form-label">ช่วงวันที่</label>
                    <div class="input-group input-daterange">
                        <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                        <input type="text" id="date_timepicker_start" name="q_date_start" value="@qDateStart" class="form-control" placeholder="วันเริ่มต้น" readonly />
                        <span class="input-group-text">ถึง</span>
                        <input type="text" id="date_timepicker_end" name="q_date_end" value="@qDateEnd" class="form-control" placeholder="วันสิ้นสุด" readonly />
                    </div>
                </div>
            </div>
        </div>
        <div class="btn-group mt-1">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon"><i class="bi bi-search"></i></span>
                <span class="btn-text">ค้นหา</span>
            </button>

            @{
                if(Context.Request.Query["perpage"]+"" != "")
                {
                    <a href="?page=1" class="btn btn--gray">
                        <span class="btn-icon"><i class="bi bi-x-circle"></i></span>
                        <span class="btn-text">ล้างค่า</span>
                    </a>
                }
            }
             
        </div>
    </form>
</div>

@* ===================== SUMMARY CARDS ===================== *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-primary">@totalRows.ToString("N0")</div>
                <div class="small text-muted">รายการทั้งหมด</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-success">@cntSuccess.ToString("N0")</div>
                <div class="small text-muted">สำเร็จ</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-danger">@cntError.ToString("N0")</div>
                <div class="small text-muted">ผิดพลาด</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-warning">@sumTokens.ToString("N0")</div>
                <div class="small text-muted">Total Tokens</div>
            </div>
        </div>
    </div>
</div>

@* ===================== TABLE ===================== *@
<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center py-2">
        <span class="fw-semibold"><i class="bi bi-robot me-1"></i> รายการ AI Service API Log</span>
        <span class="text-muted small ms-auto me-4">ทั้งหมด @totalRows.ToString("N0") รายการ &bull; หน้า @curPage / @(totalPages == 0 ? 1 : totalPages)</span>
        <a href="/Admin/LogsAI/ExportExcel@(string.IsNullOrEmpty(exportQs) ? "" : "?" + exportQs)"
           class="btn btn-sm" style="background-color:#217346;color:#fff;border-color:#217346"
           title="Export ผลลัพธ์การค้นหาเป็น Excel">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped-custom mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:50px">#</th>
                        <th style="width:155px">วันที่ / เวลา</th>
                        <th style="width:160px">Service / API</th>
                        <th>สมาชิก</th>
                        <th style="width:130px">Model</th>
                        <th style="width:120px" class="text-center">Tokens</th>
                        <th style="width:90px" class="text-center">HTTP</th>
                        <th style="width:120px">IP Address</th>
                        <th style="width:80px" class="text-center">ระยะเวลา</th>
                        <th style="width:80px" class="text-center">สถานะ</th>
                        <th style="width:60px" class="text-center">รายละเอียด</th>
                    </tr>
                </thead>
                <tbody>
                @if (dtLogs.Rows.Count == 0) {
                    <tr><td colspan="11" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-3 d-block mb-2"></i>ไม่พบข้อมูล</td></tr>
                }
                @foreach (DataRow row in dtLogs.Rows) {
                    var isSuccess   = row["is_success"] != DBNull.Value && Convert.ToBoolean(row["is_success"]);
                    var createdAt   = row["created_at"] != DBNull.Value ? Convert.ToDateTime(row["created_at"]) : DateTime.MinValue;
                    var durationMs  = row["duration_ms"] != DBNull.Value ? Convert.ToInt32(row["duration_ms"]) : -1;
                    var httpStatus  = row["response_status"] != DBNull.Value ? Convert.ToInt32(row["response_status"]) : 0;
                    var totalTok    = row["total_tokens"] != DBNull.Value ? Convert.ToInt32(row["total_tokens"]) : 0;
                    var promptTok   = row["prompt_tokens"] != DBNull.Value ? Convert.ToInt32(row["prompt_tokens"]) : 0;
                    var completeTok = row["completion_tokens"] != DBNull.Value ? Convert.ToInt32(row["completion_tokens"]) : 0;
                    var uname       = row["username"]?.ToString() ?? "";
                    var svcName     = row["service_name"]?.ToString() ?? "";
                    var apiName     = row["api_name"]?.ToString() ?? "";
                    var modelName   = row["model_name"]?.ToString() ?? "";
                    var ipAddr      = row["request_ip"]?.ToString() ?? "";
                    var errMsg      = row["error_message"]?.ToString() ?? "";

                    <tr data-id="@row["id"]">
                        <td class="text-center text-muted small">@rowNum</td>
                        <td class="small">
                            @if (createdAt != DateTime.MinValue) {
                                <span class="d-block">@createdAt.ToString("dd/MM/yyyy")</span>
                                <span class="text-muted">@createdAt.ToString("HH:mm:ss")</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(svcName)) {
                                <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-25 mb-1" style="font-size:.7rem">@svcName</span>
                            }
                            <div class="small text-muted text-truncate" style="max-width:150px" title="@apiName">@apiName</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(uname)) {
                                <div class="fw-semibold small">@uname</div>
                            }
                            @if (row["member_id"] != DBNull.Value) {
                                <div class="text-muted" style="font-size:.75rem">ID: @row["member_id"]</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(modelName)) {
                                <code class="small">@modelName</code>
                            } else {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="text-center small">
                            @if (totalTok > 0) {
                                <span class="fw-semibold">@totalTok.ToString("N0")</span>
                                <div class="text-muted" style="font-size:.7rem">@promptTok / @completeTok</div>
                            } else {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @{
                                var methodBadge = row["request_method"]?.ToString() ?? "";
                                var statusColor = httpStatus >= 500 ? "danger" : httpStatus >= 400 ? "warning" : httpStatus >= 200 ? "success" : "secondary";
                                var methodColor = methodBadge switch {
                                    "GET"    => "success",
                                    "POST"   => "primary",
                                    "PUT"    => "warning",
                                    "PATCH"  => "info",
                                    "DELETE" => "danger",
                                    _        => "secondary"
                                };
                            }
                            @if (!string.IsNullOrEmpty(methodBadge)) {
                                <span class="badge bg-@methodColor" style="font-size:.68rem">@methodBadge</span>
                            }
                            @if (httpStatus > 0) {
                                <div><span class="badge bg-@statusColor" style="font-size:.68rem">@httpStatus</span></div>
                            }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(ipAddr)) {
                                <code class="small">@ipAddr</code>
                            } else {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center small">
                            @if (durationMs >= 0) {
                                <span class="@(durationMs > 10000 ? "text-danger" : durationMs > 3000 ? "text-warning" : "text-success")">
                                    @(durationMs >= 1000 ? (durationMs / 1000.0).ToString("F1") + "s" : durationMs + "ms")
                                </span>
                            } else {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (isSuccess) {
                                <span class="badge bg-success">OK</span>
                            } else {
                                <span class="badge bg-danger">Error</span>
                                @if (!string.IsNullOrEmpty(errMsg)) {
                                    <i class="bi bi-exclamation-circle text-danger ms-1" data-toggle="tooltip" title="@errMsg"></i>
                                }
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn--outline--primary btn-log-detail"
                                    data-log-id="@row["id"]">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                    rowNum++;
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1) {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                แสดง @(offset + 1)–@(Math.Min(offset + perPage, (int)totalRows)) จาก @totalRows.ToString("N0") รายการ
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @{ int pgStart = Math.Max(1, curPage - 2); int pgEnd = Math.Min(totalPages, curPage + 2); }
                    @if (curPage > 1) {
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=1"><i class="bi bi-chevron-double-left"></i></a></li>
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@(curPage-1)"><i class="bi bi-chevron-left"></i></a></li>
                    }
                    @for (int p = pgStart; p <= pgEnd; p++) {
                        <li class="page-item @(p == curPage ? "active" : "")">
                            <a class="page-link" href="?@baseQs&page=@p">@p</a>
                        </li>
                    }
                    @if (curPage < totalPages) {
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@(curPage+1)"><i class="bi bi-chevron-right"></i></a></li>
                        <li class="page-item"><a class="page-link" href="?@baseQs&page=@totalPages"><i class="bi bi-chevron-double-right"></i></a></li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@* ===================== DETAIL MODAL ===================== *@
<div class="modal fade" id="modalLogDetail" tabindex="-1" aria-labelledby="modalLogDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLogDetailLabel">
                    <i class="bi bi-robot me-2"></i>รายละเอียด AI Service API Log
                    <span id="mdlBadgeService" class="badge bg-primary ms-2"></span>
                    <span id="mdlBadgeStatus"  class="badge ms-1"></span>
                </h5>
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">

                @* Row 1: Service info + Member info *@
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-cloud me-1"></i>ข้อมูล Service</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Service</td><td id="mdlServiceName" class="fw-semibold"></td></tr>
                                <tr><td class="text-muted">API Name</td><td><code id="mdlApiName" style="font-size:.8rem;word-break:break-all"></code></td></tr>
                                <tr><td class="text-muted">Model</td><td><code id="mdlModelName"></code></td></tr>
                                <tr><td class="text-muted">วันที่</td><td id="mdlCreatedAt"></td></tr>
                                <tr><td class="text-muted">ระยะเวลา</td><td id="mdlDuration"></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-person me-1"></i>ข้อมูลผู้ใช้</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Member ID</td><td id="mdlMemberId" class="fw-semibold"></td></tr>
                                <tr><td class="text-muted">Username</td><td id="mdlUsername"></td></tr>
                                <tr><td class="text-muted">IP Address</td>
                                    <td><code id="mdlIp"></code>
                                        <button class="btn btn-sm p-0 ms-1 text-muted" id="btnCopyIp" title="Copy"><i class="bi bi-clipboard"></i></button>
                                    </td></tr>
                                <tr><td class="text-muted">Method</td><td><code id="mdlMethod"></code></td></tr>
                                <tr><td class="text-muted">HTTP Status</td><td id="mdlHttpStatus"></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                @* Row 2: AI Usage + Ref *@
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-bar-chart me-1"></i>AI Token Usage</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:130px">Prompt Tokens</td><td id="mdlPromptTokens"></td></tr>
                                <tr><td class="text-muted">Completion Tokens</td><td id="mdlCompletionTokens"></td></tr>
                                <tr><td class="text-muted">Total Tokens</td><td id="mdlTotalTokens" class="fw-semibold"></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="small fw-semibold text-muted mb-2"><i class="bi bi-info-circle me-1"></i>ข้อมูลเพิ่มเติม</div>
                            <table class="table table-sm table-borderless mb-0" style="font-size:.85rem">
                                <tr><td class="text-muted" style="width:110px">Reference Code</td><td id="mdlRefCode"></td></tr>
                                <tr><td class="text-muted">Remark</td><td id="mdlRemark"></td></tr>
                                <tr><td class="text-muted">User Agent</td><td id="mdlUserAgent" class="text-break" style="font-size:.75rem"></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                @* Error *@
                <div id="mdlErrorWrap" class="mb-3 d-none">
                    <div class="small fw-semibold text-danger mb-1"><i class="bi bi-exclamation-triangle me-1"></i>ข้อผิดพลาด</div>
                    <div id="mdlError" class="border border-danger rounded p-2 bg-danger bg-opacity-10 small text-danger"></div>
                </div>

                @* JSON Tabs *@
                <ul class="nav nav-tabs" id="jsonTabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-toggle="tab" data-target="#tabReqBody">Request Body</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabResBody">Response Body</button></li>
                    <li class="nav-item"><button class="nav-link"        data-toggle="tab" data-target="#tabReqHeaders">Request Headers</button></li>
                </ul>
                <div class="tab-content border border-top-0 rounded-bottom p-0">
                    <div class="tab-pane fade show active" id="tabReqBody">
                        <pre id="mdlRequestBody" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:250px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabResBody">
                        <pre id="mdlResponseBody" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:250px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                    <div class="tab-pane fade" id="tabReqHeaders">
                        <pre id="mdlRequestHeaders" class="m-0 p-3 bg-light rounded-bottom small" style="max-height:250px;overflow:auto;font-size:.78rem"></pre>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <span class="text-muted small me-auto">Log ID: <code id="mdlLogId"></code></span>
                <button type="button" class="btn btn--gray" data-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <style>
    body.modal-open { overflow: hidden !important; padding-right: 0 !important; }
    #modalLogDetail .modal-body { overflow-y: auto; scrollbar-width: none; }
    #modalLogDetail .modal-body::-webkit-scrollbar { display: none; }
    </style>
    <script>
    var __logData = @Html.Raw(logDataJson);
    $(document).ready(function () {

        // ---- Date Pickers ----
        if ($.fn.datetimepicker) {
            $('#date_timepicker_start').datetimepicker({ timepicker: false, format: 'd/m/Y',
                onSelectDate: function (dp, $i) {
                    var d = $i.val();
                    $('#date_timepicker_end').datetimepicker('setOptions', { minDate: d });
                }
            });
            $('#date_timepicker_end').datetimepicker({ timepicker: false, format: 'd/m/Y',
                onSelectDate: function (dp, $i) {
                    var d = $i.val();
                    $('#date_timepicker_start').datetimepicker('setOptions', { maxDate: d });
                }
            });
        }

        // ---- Tooltips ----
        $('[data-toggle="tooltip"]').tooltip({ trigger: 'hover', placement: 'top', offset: [0, 0] });

        function prettyJson(str) {
            if (!str || str.trim() === '' || str.trim() === 'null') return '(ไม่มีข้อมูล)';
            try   { return JSON.stringify(JSON.parse(str), null, 2); }
            catch { return str; }
        }

        // ---- Detail Modal ----
        $(document).on('click', '.btn-log-detail', function () {
            var d = __logData[$(this).data('log-id')];

            $('#mdlLogId').text(d.id);
            $('#mdlServiceName').text(d.service_name  || '-');
            $('#mdlApiName').text(d.api_name           || '-');
            $('#mdlModelName').text(d.model_name       || '-');
            $('#mdlCreatedAt').text(d.created_at       || '-');
            $('#mdlDuration').text(d.duration >= 0
                ? (d.duration >= 1000 ? (d.duration / 1000).toFixed(1) + ' วินาที' : d.duration + ' ms')
                : '-');

            $('#mdlMemberId').text(d.member_id  || '-');
            $('#mdlUsername').text(d.username   || '-');
            $('#mdlIp').text(d.request_ip        || '-');
            $('#mdlMethod').text(d.request_method || '-');

            var statusCode = d.response_status;
            var statusColor = statusCode >= 500 ? 'danger' : statusCode >= 400 ? 'warning' : statusCode >= 200 ? 'success' : 'secondary';
            $('#mdlHttpStatus').html(statusCode > 0
                ? '<span class="badge bg-' + statusColor + '">' + statusCode + '</span>'
                : '-');

            $('#mdlPromptTokens').text(d.prompt_tokens     > 0 ? d.prompt_tokens.toLocaleString()     : '-');
            $('#mdlCompletionTokens').text(d.completion_tokens > 0 ? d.completion_tokens.toLocaleString() : '-');
            $('#mdlTotalTokens').text(d.total_tokens       > 0 ? d.total_tokens.toLocaleString()       : '-');

            $('#mdlRefCode').text(d.reference_code || '-');
            $('#mdlRemark').text(d.remark          || '-');
            $('#mdlUserAgent').text(d.user_agent   || '-');

            var err = (d.error_message || '').trim();
            $('#mdlErrorWrap').toggleClass('d-none', err === '');
            $('#mdlError').text(err);

            $('#mdlRequestBody').text(prettyJson(d.request_body));
            $('#mdlResponseBody').text(prettyJson(d.response_body));
            $('#mdlRequestHeaders').text(prettyJson(d.request_headers));

            // Service badge
            $('#mdlBadgeService').text(d.service_name || '');

            // Status badge
            var $bst = $('#mdlBadgeStatus').removeClass().addClass('badge');
            if (d.is_success) { $bst.addClass('bg-success').text('Success'); }
            else              { $bst.addClass('bg-danger').text('Error'); }

            // Reset to first tab
            $('#jsonTabs .nav-link').removeClass('active');
            $('#jsonTabs .nav-link:first').addClass('active');
            $('.tab-pane').removeClass('show active');
            $('#tabReqBody').addClass('show active');

            $('#modalLogDetail').modal('show');
        });

        // ---- Modal dismiss ----
        $(document).on('click', '[data-dismiss="modal"]', function () {
            $(this).closest('.modal').modal('hide');
        });

        // ---- Copy IP ----
        $('#btnCopyIp').on('click', function () {
            var ip = $('#mdlIp').text().trim();
            if (ip && navigator.clipboard) {
                navigator.clipboard.writeText(ip).then(function () {
                    $('#btnCopyIp i').removeClass('bi-clipboard').addClass('bi-clipboard-check');
                    setTimeout(function () {
                        $('#btnCopyIp i').removeClass('bi-clipboard-check').addClass('bi-clipboard');
                    }, 1500);
                });
            }
        });

    });
    </script>
}
