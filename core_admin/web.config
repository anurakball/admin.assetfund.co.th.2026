<?xml version="1.0" encoding="utf-8"?>
<!--
  The <handlers> and <aspNetCore> elements are injected into this file automatically
  during `dotnet publish`. It exists here only to raise the IIS request-filtering
  limit, whose 30,000,000-byte default would reject uploads long before the
  50 MB elFinder cap (see FileSystemController.GetConnector) is reached.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- 80 MB, kept in sync with Kestrel's MaxRequestBodySize in Program.cs -->
          <requestLimits maxAllowedContentLength="83886080" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
