    <script>
        areaMove = document.getElementById('tools_module');

        function onClickMoveUPorDOWN() {
            var btn_moveDOWN = [...document.getElementsByClassName('icon-sort__down')]
            var btn_moveUP = [...document.getElementsByClassName('icon-sort__up')]
            btn_moveUP.forEach(onebyone => {
                onebyone.addEventListener('click', ChangeUP)

            })

            btn_moveDOWN.forEach(onebyone => {
                onebyone.addEventListener('click', ChangeDOWN)

            })
        }

        function ChangeUP() {
            CurrentElement_ToMove = this.parentElement.parentElement.parentElement.parentElement;
            // CurrentElement_ToMove = closest(this, 'stoptillhere')
            previousElement_ToMove = CurrentElement_ToMove.previousElementSibling;
            if (previousElement_ToMove != null) {
                areaMove.insertBefore(CurrentElement_ToMove, previousElement_ToMove);
            } else {
                //alert('cannot Move Further')
                return false;
            }
        }

        function ChangeDOWN() {
            CurrentElement_ToMove = this.parentElement.parentElement.parentElement.parentElement;
            nextElement_ToMove = CurrentElement_ToMove.nextElementSibling;
            //console.log(nextElement_TOMOVE)
            if (nextElement_ToMove != null) {
                areaMove.insertBefore(nextElement_ToMove, CurrentElement_ToMove);
            } else {
                //alert('cannot Move Below')
                return false;
            }
        }



        // iframe in modal
        var main_iframe_url = '';
        function urliFrame(url) {
            document.getElementById('iframe_full').src = '';
            main_iframe_url = url;
        }

        $(document).ready(function () {
            $('#setting_section').on('shown.bs.modal', function () {
                $(this).find('iframe').attr('src', main_iframe_url);
            });

            // delete section dragdrop
            $(".group--tools__delete").click(function () {
                $(this).parents('.itemDrag').remove();
            });

        });
        
    </script>
}


