    <script>
        //function destroyCarousel() {
        //  if ($('.card--slide').hasClass('slick-initialized')) {
        //    $('.card--slide').slick('destroy');
        //  }      
        //}

        function slickCarousel() {
            $(".slide-initialized").each(function (index, element) {
                $(this).not('.slick-initialized').slick({
                    dots: false,
                    autoplay: false,
                    infinite: true,
                    arrows: true,
                    touchMove: false,
                    speed: 1000,
                    //cssEase: 'linear',
                    slidesToShow: 3,
                    slidesToScroll: 1,
                    responsive: [
                        {
                            breakpoint: 992,
                            settings: {
                                slidesToShow: 2,
                            }
                        },
                        {
                            breakpoint: 480,
                            settings: {
                                slidesToShow: 1,
                            }
                        }
                    ]
                });
            });

            //$('.list-group__left .accordion-item .accordion-collapse .accordion-body .itemDrag .list-group-item .main-func .slide-initialized').slick('destroy');
            $('.list-group__right .area-drag .itemDrag .list-group-item .main-func .slide-initialized').slick('destroy');
        }
    </script>

}
