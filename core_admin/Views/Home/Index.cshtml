    <script>
        
        $(document).ready(function () {
            // tooltips 
            $(function () { 
                $('[data-bs-toggle="tooltip"]').tooltip({
                    title: '&#183; ตกแต่งเพจด้วย Tool Bar' + '<br />' + '&#183; ใส่ข้อมูลเพจและ SEO' + '<br />' + '&#183; บันทึกเพจและอนุมัติที่หน้าจัดการเว็บไซต์',
