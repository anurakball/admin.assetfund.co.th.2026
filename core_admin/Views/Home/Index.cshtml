                });
            })
            // function สำหรับลากมาวางแล้วให้ไอคอน(widget)หาย แล้วแสดงhtml แทน
            function sortTemplate() {
                $('#tools_module').find('.area-drop').addClass('hide').remove();

                $('#tools_module').find('.thumbnail').addClass('hide');
                $('#tools_module').find('.main-func').addClass('show');

            };

            // ** ถ้าจะสร้างGroupเพิ่ม ให้copyไปทั้งชุดแล้วเปลี่ยนidเอา (idห้ามซ้ำ) 
            // ** widget Group1
            new Sortable(tools_widget, {
                group: {
