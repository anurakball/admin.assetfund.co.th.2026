                animation: 150,
                sort: false,
                filter: ".static",
                draggable: ".itemDrag",
                onEnd: function (evt) {
                    var itemEl = evt.item; 

                    var num_id = 0
                    $('#tools_module.area-drag .list-group-item').each(function () {
                        $(itemEl).attr('id',num_id);
                        num_id++;
                    });


                    var selected = 0;
                    var len = $('#tools_module.area-drag .itemDrag').length;
                    //console.log(len);

                    onClickMoveUPorDOWN();

                },
            });
            // ** widget Group2
            new Sortable(tools_widget2, {
                group: {
                    name: 'shared',
                    pull: 'clone',
                },
                animation: 150,
                sort: false,
                filter: ".static",
                draggable: ".itemDrag",
                onEnd: function (evt) {
                    var itemEl = evt.item;

                    var num_id = 0
                    $('#tools_module.area-drag .list-group-item').each(function () {
                        $(itemEl).attr('id', num_id);
                        num_id++;
                    });


                    var selected = 0;
                    var len = $('#tools_module.area-drag .itemDrag').length;
                    //console.log(len);

                    onClickMoveUPorDOWN();
                },
            });
            // ** widget Group3
            new Sortable(tools_widget3, {
                group: {
                    name: 'shared',
                    pull: 'clone',
                },
                animation: 150,
                sort: false,
                filter: ".static",
                draggable: ".itemDrag",
                onEnd: function (evt) {
                    var itemEl = evt.item;

                    var num_id = 0
                    $('#tools_module.area-drag .list-group-item').each(function () {
                        $(itemEl).attr('id', num_id);
                        num_id++;
                    });

                    var selected = 0;
                    var len = $('#tools_module.area-drag .itemDrag').length;
                    //console.log(len);

                    onClickMoveUPorDOWN();
                },
            });
            // ** widget Group4
