@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon : ตราสัญลักษณ์ ASSET PLUS - Fund Management -->
    <link rel="icon" href="~/favicon.ico?v=ap2026" type="image/x-icon" />
    <link rel="shortcut icon" href="~/favicon.ico?v=ap2026" type="image/x-icon" />
    <title>Login - Welcome to Asset Plus Admin Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    @*css Back*@
    <link rel="stylesheet" href="~/css/main_cms.min.css" asp-append-version="true" />

    <link href="~/css/pages/login.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        /* กล่อง reCAPTCHA กว้างคงที่ 304px — จัดกลางฟอร์ม และย่อบนจอแคบไม่ให้ล้นแนวนอน */
        .login-recaptcha {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 16px 0 4px;
        }

        .login-recaptcha__error {
            margin-top: 6px;
            color: #BC1320;
            font-size: 14px;
        }

        @@media (max-width: 360px) {
            .login-recaptcha .g-recaptcha {
                transform: scale(0.88);
                transform-origin: center top;
            }
        }

        .input-group__icon .icon-input .bi {
            font-size: 18px;
            color: #606d7c;
            line-height: 1;
        }
    </style>
</head>
<body>

    <div class="page-login-wrapper">
        <div class="img-bg">
            @{
                //----- สุ่มพื้นหลังจาก wwwroot/images/bg/bg0.jpg – bg9.jpg (ถ้าเพิ่ม/ลดรูป ต้องแก้เลข 10 ให้ตรงจำนวนไฟล์)
                int n = Random.Shared.Next(0, 10);
                string bg = "bg"+n.ToString()+".jpg";
            }
            <img src="~/images/bg/@bg" />
        </div>
        <div class="section-text" style="background: rgba(255, 255, 255, .7); color:#111111; backdrop-filter: blur(10px); padding: 30px;">
            <div class="head-text" style="color:#111111;">Welcome to <br /> Asset Plus Admin Management</div>
            <div class="sub-text" style="color:#111111;">
                ระบบบริหารจัดการเนื้อหาเว็บไซต์ บริษัทหลักทรัพย์จัดการกองทุน แอสเซท พลัส จำกัด (ASSET PLUS - Fund Management)
            </div>
        </div>
        <div class="section-login">
            <div class="align-self-end bg-form">
                <div class="form-wrapper">
                    <form class="login-form" action="#" method="post" id="loginForm">
                        @Html.AntiForgeryToken()
                        <div class="head-form">
                            <img src="~/images/logo/logo-32.png" alt="icon logo" asp-append-version="true" />
                            <p>Login @((ViewBag.webTitle+"" != "") ? (": " +ViewBag.webTitle) : "")</p>
                        </div>
                        <div class="body-form">
                            <div class="input-group input-group__icon">
                                <span class="icon-input">
                                    <img src="~/images/icons-cms/icon-mail.svg" />
                                </span>
                                <input type="text" name="username" class="form-control" placeholder="Username" aria-label="Username" aria-describedby="username">
                            </div>
                            <div class="input-group input-group__icon">
                                <span class="icon-input">
                                    <img src="~/images/icons-cms/icon-key.svg" />
                                </span>
                                <input id="inp_password" name="password" type="password" class="form-control form-icon form-icon__key" placeholder="Password" aria-label="Password" aria-describedby="password">
                                <span class="icon-input-password" id="icon_password">
                                    <i class="bi bi-eye"></i>
                                </span>
                            </div>

                            @*
                                เลือกเว็บไซต์ (web_id) : ซ่อน dropdown ไว้ตามที่ผู้ใช้สั่ง 17 ก.ย. 2569 — Asset Plus ใช้เว็บไซต์หลักอย่างเดียว
                                ยังส่ง web_id = 0 ไปกับฟอร์มเหมือนเดิม (UserController.Login [HttpPost] อ่าน f["web_id"])
                                เปิดคืน: เอา <select id="id_web_id"> เดิมจาก git history (หรือ Views ของ SAM) มาวางแทน hidden นี้
                            *@
                            <input type="hidden" id="id_web_id" name="web_id" value="0" />

                            @{
                                string recaptchaSiteKey = ViewBag.RecaptchaSiteKey + "";
                            }
                            @if (ViewBag.RecaptchaSkipLocal == true)
                            {
                                @* เครื่อง dev: ข้าม reCAPTCHA (Development + loopback + GoogleReCaptcha:SkipOnLocalhost) — ดู ReCaptcha.SkipForLocal *@
                                <div class="text-muted small text-center mb-2" id="recaptcha_skip_local">reCAPTCHA ปิดไว้บน localhost (Development)</div>
                            }
                            else if (recaptchaSiteKey != "")
                            {
                                @* Google reCAPTCHA v2 (I'm not a robot) — site key มาจาก appsettings → GoogleReCaptcha:SiteKey
                                   ต้องติ๊กก่อนกด Log In (ตรวจซ้ำฝั่ง server ที่ Helpers/ReCaptcha.cs) *@
                                <div class="login-recaptcha">
                                    <div class="g-recaptcha" data-sitekey="@recaptchaSiteKey" data-callback="onRecaptchaDone" data-expired-callback="onRecaptchaExpired"></div>
                                    <div class="login-recaptcha__error" id="recaptcha_error" style="display:none;">กรุณาติ๊กยืนยันว่าคุณไม่ใช่โปรแกรมอัตโนมัติ</div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger">ระบบยังไม่ได้ตั้งค่า reCAPTCHA (GoogleReCaptcha:SiteKey) จึงยังเข้าสู่ระบบไม่ได้ กรุณาติดต่อผู้ดูแลระบบ</div>
                            }

                            @if (TempData["alert_message"] != null)
                            {
                                string alerClass = (TempData["alert_class"] != null) ? (TempData["alert_class"] + "") :
                                "alert-warning";
                                <br />
                                <div class="alert @alerClass">
                                    @TempData["alert_message"]
                                </div>
                            }

                            <!--
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="" id="remember">
                                <label class="form-check-label" for="remember">
                                    Remember me
                                </label>
                            </div>
                            -->
                             
                            <div class="btn-group btn-group__full">
                                <button type="submit" class="btn btn-primary mx-0">Log In</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js" defer></script>

    <script>
        function updateQueryStringParameter(uri, key, value) {
            uri = uri.split('#')[0];
            var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
            var separator = uri.indexOf('?') !== -1 ? "&" : "?";
            if (uri.match(re)) {
                return uri.replace(re, '$1' + key + "=" + value + '$2');
            }
            else {
                return uri + separator + key + "=" + value;
            }
        }
        $(document).ready(function () {
            $("#icon_password").click(function () {
                if ($("#inp_password").attr("type") === "password") {

                    $("#inp_password").attr("type", "text");
                    $(this).find('.bi').removeClass('bi-eye').addClass('bi-eye-slash');

                } else {
                    $("#inp_password").attr("type", "password");
                    $(this).find('.bi').removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            $("#inp_miscrosite").change(function(){
            
            });

            // ต้องติ๊ก reCAPTCHA ก่อนส่ง (server ตรวจซ้ำอีกชั้น — ข้อนี้แค่ไม่ให้ผู้ใช้เสียรอบ)
            $("#loginForm").on("submit", function (e) {
                if ($(".g-recaptcha").length === 0) return;
                if (typeof grecaptcha === "undefined" || grecaptcha.getResponse() === "") {
                    e.preventDefault();
                    $("#recaptcha_error").show();
                }
            });
        });

        function onRecaptchaDone() { $("#recaptcha_error").hide(); }
        function onRecaptchaExpired() { $("#recaptcha_error").text("การยืนยันหมดอายุ กรุณาติ๊กใหม่อีกครั้ง").show(); }
    </script>
    @if (ViewBag.RecaptchaSiteKey + "" != "")
    {
        <script src="https://www.google.com/recaptcha/api.js?hl=th" async defer></script>
    }
</body>
</html>
