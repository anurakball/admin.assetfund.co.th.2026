<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup> 
	<TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionSuffix>1.$([System.DateTime]::UtcNow.ToString(yyyy)).$([System.DateTime]::UtcNow.ToString(MM)).$([System.DateTime]::UtcNow.ToString(dd))</VersionSuffix>
    <AssemblyVersion Condition=" '$(VersionSuffix)' == '' ">0.0.0.1</AssemblyVersion>
    <AssemblyVersion Condition=" '$(VersionSuffix)' != '' ">$(VersionSuffix)</AssemblyVersion>
    <Version Condition=" '$(VersionSuffix)' == '' ">0.0.1.0</Version>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(VersionSuffix)</Version>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="elFinder.NetCore" Version="1.6.0" />
    <PackageReference Include="EPPlus" Version="6.0.7" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Build" Version="18.4.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageReference Include="NuGet.DependencyResolver.Core" Version="7.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="NuGet.LibraryModel" Version="7.6.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.6.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.6.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	  <Content Update="Logs\**\*">
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </Content>
	  <Content Update="wwwroot\**\*">
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </Content>
    <!-- The Web SDK globs every **/*.json and **/*.config into Content. None of the root
         .json files are read at runtime: appsettings.json is maintained by hand on the
         server, and the rest are scratch/tooling artefacts. Keeping them out of the
         publish output means a new debug .json at the root never leaks into a deploy. -->
    <Content Update="*.json">
    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <!-- web.config is deliberately NOT excluded: the publish pipeline rewrites it in place
         to inject the AspNetCore handler, and dropping it would lose the requestLimits. -->
    <Content Update="prepros-6.config">
    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="docx\**\*;.claude\**\*;.config\**\*;.playwright-mcp\**\*">
    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  
</Project>
