<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup> 
	<TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionSuffix>1.$([System.DateTime]::UtcNow.ToString(yyyy)).$([System.DateTime]::UtcNow.ToString(MM)).$([System.DateTime]::UtcNow.ToString(dd))</VersionSuffix>
    <AssemblyVersion Condition=" '$(VersionSuffix)' == '' ">0.0.0.1</AssemblyVersion>
    <AssemblyVersion Condition=" '$(VersionSuffix)' != '' ">$(VersionSuffix)</AssemblyVersion>
    <Version Condition=" '$(VersionSuffix)' == '' ">0.0.1.0</Version>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(VersionSuffix)</Version>
    <!-- The Web SDK globs **/*.json and **/*.config into Content, which otherwise sweeps a
         previous publish output (its deps.json / runtimeconfig.json / web.config) and
         node_modules back into the next one. bin/obj are excluded by the SDK already. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;node_modules\**;docs\**;.playwright-mcp\**</DefaultItemExcludes>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="elFinder.NetCore" Version="1.6.0" />
    <PackageReference Include="EPPlus" Version="6.0.7" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- Scaffolding only (dotnet-aspnet-codegenerator). PrivateAssets="all" keeps this package
         and everything it drags in - Roslyn Workspaces/Features, MSBuild, NuGet.*,
         EntityFrameworkCore - out of the publish output. No source file references any of it;
         it used to add ~60 MB of unused assemblies to every deploy. -->
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" PrivateAssets="all" />
    <!-- Used directly all over the code (JsonConvert / JObject). Must be referenced here: it used
         to arrive only through the scaffolding package above, and PrivateAssets="all" then left
         Newtonsoft.Json.dll out of publish -> FileNotFoundException on the server. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	  <Content Update="Logs\**\*">
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </Content>
	  <!-- wwwroot IS published: the site's own css/js/logos live there and a deploy has to
	       carry them. Excluded from it are only the folders the running site writes into -
	       uploaded content must never be overwritten by whatever happens to sit in a
	       developer's copy - plus the scss sources, which are compiled into wwwroot/css and
	       are never served directly. Keep this list in sync with the same folders in .gitignore.
	       wwwroot\images\bg itself IS published (the login page picks bg0-bg9.jpg at random);
	       only its bak\ folder of full-size originals (~335 MB) stays behind. -->
	  <Content Update="wwwroot\Files\**;wwwroot\uploads\**;wwwroot\images\bg\bak\**;wwwroot\scss\**">
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </Content>
	  <!-- Templates and fonts read at runtime through ContentRootPath (for instance
	       Storage/Template/Email/TwoFactor.html in UserController). None of those extensions
	       are in the Web SDK's default Content globs, so they have to be named here. -->
	  <Content Include="Storage\**\*">
		<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <!-- Runtime data: the XML that ws_schedule fetches. Created on the server, never deployed. -->
	  <Content Update="App_Data\**\*">
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </Content>
    <!-- The Web SDK globs every **/*.json and **/*.config into Content. None of the root
         .json files are read at runtime: appsettings.json is maintained by hand on the
         server, and the rest are scratch/tooling artefacts. Keeping them out of the
         publish output means a new debug .json at the root never leaks into a deploy. -->
    <Content Update="*.json">
    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <!-- web.config is deliberately NOT excluded: the publish pipeline rewrites it in place
         to inject the AspNetCore handler, and dropping it would lose the requestLimits. -->
    <Content Update="prepros-6.config">
    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="docx\**\*;.claude\**\*;.config\**\*;.playwright-mcp\**\*">
    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  
</Project>
