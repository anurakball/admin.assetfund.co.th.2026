<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

The one publish profile for this project. `publish\` is a pure build artefact
(gitignored, wiped on every publish) - do not park anything else in it.

What lands there is the deployable payload: the app assemblies, wwwroot, Storage,
and a web.config rewritten by the publish pipeline to add the AspNetCore handler.
What deliberately does NOT: appsettings.json (hand-maintained on the server, it
holds the real passwords), App_Data, and the upload folders under wwwroot - see
the comments in core_admin.csproj.
-->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>publish\</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net10.0</TargetFramework>
    <ProjectGuid>44ac9c84-cbc8-4bf9-abe1-7ae9e6d4a564</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
