# ---------------------------------------------------------------------------
# Build output
# (bin/ obj/ Logs/ are also listed in the repo-root .gitignore — kept here too
#  so this project folder is self-contained)
# ---------------------------------------------------------------------------
bin/
obj/
# ปลายทางของ publish profile เดียวที่มี (Properties/PublishProfiles/FolderProfile.pubxml)
# — โฟลเดอร์นี้ถูกล้างทุกครั้งที่ publish อย่าเก็บไฟล์อื่นไว้ในนี้
publish/
*.publishproj
*.binlog
TestResults/

# ---------------------------------------------------------------------------
# IDE / editor / tooling artifacts
# ---------------------------------------------------------------------------
.vs/
.idea/
*.suo
# ครอบคลุม core_admin.csproj.user และ Properties/PublishProfiles/*.pubxml.user
# (ไฟล์ .user เก็บ path ของเครื่องคนแก้ ไม่ควร track)
*.user
*.userosscache
*.sln.docstates
*.lscache
*~
*.swp

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
Logs/
*.log

# ---------------------------------------------------------------------------
# Local-only settings / ความลับ (ห้าม commit — ค่าจริงอยู่บนเครื่อง/เซิร์ฟเวอร์เท่านั้น)
# appsettings.json ที่ track ไว้มีแต่โครง ช่องรหัสผ่านเว้นว่างไว้หมด
# ตัวอย่างค่า dev อยู่ที่ appsettings.Development.json.example (ไฟล์นี้ track)
# ---------------------------------------------------------------------------
appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json
appsettings.Local.json
appsettings.*.local.json
.claude/settings.local.json
*.pfx
*.p12

# ---------------------------------------------------------------------------
# Node modules (Playwright etc. — regenerate with npm install)
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Playwright MCP test artifacts (screenshots, snapshots, console logs)
# ---------------------------------------------------------------------------
.playwright-mcp/

# ---------------------------------------------------------------------------
# Server-managed / runtime content — not versioned
# (ตรงกับรายการที่ core_admin.csproj ตั้ง CopyToPublishDirectory=Never ไว้
#  แก้ที่นี่แล้วต้องตามไปแก้ csproj ด้วย ไม่งั้น deploy จะไปทับไฟล์ที่ผู้ใช้อัปโหลด)
# ---------------------------------------------------------------------------
# uploaded content (elFinder / article attachments)
wwwroot/Files/
# runtime uploads
wwwroot/uploads/
# background images folder
wwwroot/images/bg/

# ---------------------------------------------------------------------------
# เอกสาร/สคริปต์ประกอบงาน + รูปที่ generate เอง — ไม่ track (ไม่ถูกอ้างจากโค้ด)
# ---------------------------------------------------------------------------
docs/*
# ยกเว้น : รายงานสถานะเมนูด้านซ้าย ต้อง track ไว้ให้ตรงกับ AdminMenu.cs เสมอ
!docs/backend-menu-status.html
# ยกเว้น : สเปกระบบ Preview (แยกออกจาก CLAUDE.md)
!docs/preview-spec.md

# ---------------------------------------------------------------------------
# One-off debug / audit scratch output (ไม่ถูกอ้างจากโค้ด — ลบทิ้งได้)
# ไฟล์ scratch ใหม่ให้ตั้งชื่อลงท้าย .scratch.json / .scratch.txt จะถูกกันให้เอง
# ---------------------------------------------------------------------------
*.scratch.json
*.scratch.txt
/btn-audit.json
/buttons.json
/edit78-current.json
/frontend-check.json
/geom.json
/list-row.json
/setdata-result.json
/source-content.json
/source-inner.json
/deployed-admin_site.js.txt
/shot.mjs

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# ws_schedule : XML ที่ดึงมาจาก web service ของ Asset Plus (ข้อมูลรันไทม์ ไม่ใช่ซอร์ส)
# เก็บไว้นอก wwwroot เพื่อไม่ให้โหลดจากเว็บได้ — ดูหัวข้อ ws_schedule ใน CLAUDE.md
# ---------------------------------------------------------------------------
App_Data/
